      "book_id": "Markus",
      "word_count": 21
    },
    {
      "id": 61,
      "diatessaron_verse": "35",
      "ref": "Matthew 21:28",
      "arabic_page": 127,
      "text": "\"Tetapi apakah pendapatmu tentang ini: Seorang mempunyai dua anak laki-laki. Ia pergi kepada anak yang sulung dan berkata:",
      "ref_id": "Matius 21:28",
