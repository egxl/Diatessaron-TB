      "ref": "Matthew 21:30",
      "arabic_page": 127,
      "text": "Lalu orang itu pergi kepada anak yang kedua dan",
      "ref_id": "Matius 21:30",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
