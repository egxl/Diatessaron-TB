      "book_id": "Markus",
      "word_count": 5
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Mark 11:20",
      "arabic_page": 125,
      "text": "Pagi-pagi ketika Yesus dan murid-murid-Nya lewat, mereka melihat pohon ara tadi",
      "ref_id": "Markus 11:20",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Mark 11:20",
      "arabic_page": 125,
      "text": "sudah kering sampai ke akar-akarnya.",
      "ref_id": "Markus 11:20",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 5
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "Matthew 21:20b",
      "arabic_page": 125,
      "text": "lalu berkata: \"Bagaimana mungkin pohon ara itu sekonyong-konyong menjadi",
