    {
      "id": 66,
      "diatessaron_verse": "38",
      "ref": "Matthew 21:30",
      "arabic_page": 127,
      "text": "berkata demikian juga. Dan anak itu menjawab: Aku tidak mau. Tetapi kemudian ia menyesal lalu pergi juga.",
