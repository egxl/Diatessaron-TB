      "diatessaron_verse": "55",
      "ref": "Matthew 15:27",
      "arabic_page": 81,
      "text": "yang jatuh dari meja tuannya.\"",
      "ref_id": "Matius 15:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 95,
      "diatessaron_verse": "55",
      "ref": "Matthew 15:28a",
      "arabic_page": 81,
      "text": "Maka Yesus menjawab dan berkata kepadanya:",
      "ref_id": "Matius 15:28a",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 96,
      "diatessaron_verse": "56",
      "ref": "Matthew 15:28a",
      "arabic_page": 81,
      "text": "\"Hai ibu, besar imanmu, maka jadilah kepadamu seperti yang kaukehendaki.\"",
      "ref_id": "Matius 15:28a",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 97,
      "diatessaron_verse": "56",
      "ref": "Mark 7:29b",
      "arabic_page": 81,
      "text": "\"Karena kata-katamu itu,",
      "ref_id": "Markus 7:29b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 3
    },
    {
      "id": 98,
      "diatessaron_verse": "57",
      "ref": "Mark 7:29b",
      "arabic_page": 81,
      "text": "pergilah sekarang sebab setan itu sudah keluar dari anakmu.\"",
      "ref_id": "Markus 7:29b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 9
    },
    {
      "id": 99,
      "diatessaron_verse": "57",
      "ref": "Matthew 15:28b",
      "arabic_page": 81,
      "text": "Dan seketika itu juga",
      "ref_id": "Matius 15:28b",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 100,
      "diatessaron_verse": "58",
      "ref": "Matthew 15:28b",
      "arabic_page": 81,
      "text": "anaknya sembuh.",
      "ref_id": "Matius 15:28b",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
