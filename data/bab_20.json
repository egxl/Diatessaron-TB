      "diatessaron_verse": "20",
      "ref": "Mark 7:3",
      "arabic_page": 78,
      "text": "karena mereka berpegang pada adat istiadat nenek moyang mereka;",
      "ref_id": "Markus 7:3",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 9
    },
    {
