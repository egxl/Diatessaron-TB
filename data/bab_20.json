      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 38,
      "diatessaron_verse": "23",
      "ref": "Matthew 15:4",
      "arabic_page": 79,
      "text": "Sebab Allah berfirman: Hormatilah ayahmu dan ibumu; dan lagi: Siapa yang mengutuki ayahnya atau",
      "ref_id": "Matius 15:4",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 14
    },
    {
      "id": 39,
      "diatessaron_verse": "24",
      "ref": "Matthew 15:4",
      "arabic_page": 79,
      "text": "ibunya pasti dihukum mati.",
      "ref_id": "Matius 15:4",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 40,
      "diatessaron_verse": "24",
      "ref": "Mark 7:11",
      "arabic_page": 79,
      "text": "Tetapi kamu berkata: Kalau seorang berkata kepada bapanya atau ibunya:",
      "ref_id": "Markus 7:11",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 10
    },
    {
      "id": 41,
      "diatessaron_verse": "25",
      "ref": "Mark 7:11",
      "arabic_page": 79,
      "text": "Apa yang ada padaku, yang dapat digunakan untuk pemeliharaanmu, sudah digunakan untuk korban--yaitu persembahan kepada Allah--,",
      "ref_id": "Markus 7:11",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 16
    },
    {
      "id": 42,
      "diatessaron_verse": "25",
      "ref": "Mark 7:12",
      "arabic_page": 79,
      "text": "maka kamu tidak membiarkannya lagi berbuat sesuatupun",
      "ref_id": "Markus 7:12",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 7
    },
    {
      "id": 43,
      "diatessaron_verse": "26",
      "ref": "Mark 7:12",
      "arabic_page": 79,
      "text": "untuk bapanya atau ibunya.",
      "ref_id": "Markus 7:12",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 4
    },
    {
      "id": 44,
      "diatessaron_verse": "26",
      "ref": "Mark 7:13",
      "arabic_page": 79,
      "text": "Dengan demikian firman Allah kamu nyatakan tidak berlaku demi adat istiadat yang kamu ikuti itu.",
      "ref_id": "Markus 7:13",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 15
    },
    {
      "id": 45,
      "diatessaron_verse": "27",
      "ref": "Mark 7:13",
      "arabic_page": 79,
      "text": "Dan banyak hal lain seperti itu yang kamu lakukan.\"",
      "ref_id": "Markus 7:13",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 9
    },
    {
      "id": 46,
      "diatessaron_verse": "27",
      "ref": "Mark 7:8",
      "arabic_page": 79,
      "text": "Perintah Allah kamu abaikan",
      "ref_id": "Markus 7:8",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 4
    },
    {
      "id": 47,
      "diatessaron_verse": "28",
      "ref": "Mark 7:8",
      "arabic_page": 79,
      "text": "untuk berpegang pada adat istiadat manusia.\"",
      "ref_id": "Markus 7:8",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 6
    },
    {
      "id": 48,
      "diatessaron_verse": "28",
      "ref": "Mark 7:9",
      "arabic_page": 79,
      "text": "Yesus berkata pula kepada mereka: \"Sungguh pandai kamu",
      "ref_id": "Markus 7:9",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 8
    },
    {
      "id": 49,
      "diatessaron_verse": "29",
      "ref": "Mark 7:9",
      "arabic_page": 79,
      "text": "mengesampingkan perintah Allah, supaya kamu dapat memelihara adat istiadatmu sendiri.",
      "ref_id": "Markus 7:9",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 10
    },
    {
