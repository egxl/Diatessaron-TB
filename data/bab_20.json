      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 24,
      "diatessaron_verse": "14",
      "ref": "Luke 11:38",
      "arabic_page": 78,
      "text": "dan ia heran, karena Yesus tidak mencuci tangan-Nya sebelum makan.",
      "ref_id": "Lukas 11:38",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 25,
      "diatessaron_verse": "14",
      "ref": "Luke 11:39",
      "arabic_page": 78,
      "text": "Tetapi Tuhan berkata kepadanya: \"Kamu orang-orang Farisi, kamu membersihkan bagian luar dari cawan dan pinggan, tetapi bagian dalammu penuh rampasan dan kejahatan.",
      "ref_id": "Lukas 11:39",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 22
    },
    {
      "id": 26,
      "diatessaron_verse": "15, 16",
      "ref": "Luke 11:40",
      "arabic_page": 78,
      "text": "Hai orang-orang bodoh, bukankah Dia yang menjadikan bagian luar, Dia juga yang menjadikan bagian dalam?",
      "ref_id": "Lukas 11:40",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 15
    },
    {
      "id": 27,
      "diatessaron_verse": "15, 16",
      "ref": "Luke 11:41",
      "arabic_page": 78,
      "text": "Akan tetapi, berikanlah isinya sebagai sedekah dan sesungguhnya semuanya akan menjadi bersih bagimu.",
      "ref_id": "Lukas 11:41",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 28,
      "diatessaron_verse": "17, 18",
      "ref": "Mark 7:1",
      "arabic_page": 78,
      "text": "Pada suatu kali serombongan orang Farisi dan beberapa ahli Taurat dari Yerusalem datang menemui Yesus.",
      "ref_id": "Markus 7:1",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 15
    },
    {
      "id": 29,
      "diatessaron_verse": "17, 18",
      "ref": "Mark 7:2",
      "arabic_page": 78,
      "text": "Mereka melihat, bahwa beberapa orang murid-Nya makan dengan tangan najis, yaitu dengan tangan yang",
      "ref_id": "Markus 7:2",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 14
    },
    {
