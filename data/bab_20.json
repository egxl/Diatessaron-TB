      "diatessaron_verse": "30",
      "ref": "Matthew 15:8",
      "arabic_page": 79,
      "text": "Bangsa ini memuliakan Aku dengan bibirnya, padahal hatinya jauh dari pada-Ku.",
      "ref_id": "Matius 15:8",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
