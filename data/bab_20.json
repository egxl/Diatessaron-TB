      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 76,
      "diatessaron_verse": "44",
      "ref": "Mark 7:23",
      "arabic_page": 80,
      "text": "Semua hal-hal jahat ini timbul dari dalam",
      "ref_id": "Markus 7:23",
      "book_code": "mrk",
      "book_en": "Mark",
