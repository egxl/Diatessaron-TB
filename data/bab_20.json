      "diatessaron_verse": "48, 49",
      "ref": "Mark 7:25a",
      "arabic_page": 80,
      "text": "segera mendengar tentang Dia,",
      "ref_id": "Markus 7:25a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 4
    },
    {
      "id": 83,
      "diatessaron_verse": "48, 49",
      "ref": "Mark 7:26a",
      "arabic_page": 80,
      "text": "Perempuan itu seorang Yunani bangsa Siro-Fenisia.",
      "ref_id": "Markus 7:26a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 6
    },
    {
      "id": 84,
      "diatessaron_verse": "48, 49",
      "ref": "Matthew 15:22",
      "arabic_page": 80,
      "text": "Maka datanglah seorang perempuan Kanaan dari daerah itu dan berseru: \"Kasihanilah aku, ya Tuhan,",
      "ref_id": "Matius 15:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 14
    },
    {
      "id": 85,
      "diatessaron_verse": "50",
      "ref": "Matthew 15:22",
      "arabic_page": 80,
      "text": "Anak Daud, karena anakku perempuan kerasukan setan dan sangat menderita.\"",
      "ref_id": "Matius 15:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 86,
      "diatessaron_verse": "50",
      "ref": "Matthew 15:23",
      "arabic_page": 81,
      "text": "Tetapi Yesus sama sekali tidak menjawabnya. Lalu murid-murid-Nya datang dan meminta kepada-Nya:",
      "ref_id": "Matius 15:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 87,
      "diatessaron_verse": "51",
      "ref": "Matthew 15:23",
      "arabic_page": 81,
      "text": "\"Suruhlah ia pergi, ia mengikuti kita dengan berteriak-teriak.\"",
      "ref_id": "Matius 15:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 88,
      "diatessaron_verse": "51",
      "ref": "Matthew 15:24",
      "arabic_page": 81,
      "text": "Jawab Yesus:",
      "ref_id": "Matius 15:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 89,
      "diatessaron_verse": "52",
      "ref": "Matthew 15:24",
      "arabic_page": 81,
      "text": "\"Aku diutus hanya kepada domba-domba yang hilang dari umat Israel.\"",
      "ref_id": "Matius 15:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 90,
      "diatessaron_verse": "52",
      "ref": "Matthew 15:25",
      "arabic_page": 81,
      "text": "Tetapi perempuan itu mendekat dan menyembah Dia sambil berkata: \"Tuhan, tolonglah aku.\"",
      "ref_id": "Matius 15:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 91,
      "diatessaron_verse": "53",
      "ref": "Matthew 15:26",
      "arabic_page": 81,
      "text": "Tetapi Yesus menjawab: \"Tidak patut mengambil roti yang disediakan bagi anak-anak dan",
      "ref_id": "Matius 15:26",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
