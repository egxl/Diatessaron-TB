      "text": "tidak dapat dirahasiakan.",
      "ref_id": "Markus 7:24",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 3
    },
    {
      "id": 81,
      "diatessaron_verse": "47",
      "ref": "Mark 7:25a",
      "arabic_page": 80,
      "text": "Malah seorang ibu, yang anaknya perempuan kerasukan roh jahat,",
