      "id": 92,
      "diatessaron_verse": "54",
      "ref": "Matthew 15:26",
      "arabic_page": 81,
      "text": "melemparkannya kepada anjing.\"",
      "ref_id": "Matius 15:26",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 93,
      "diatessaron_verse": "54",
      "ref": "Matthew 15:27",
      "arabic_page": 81,
      "text": "Kata perempuan itu: \"Benar Tuhan, namun anjing itu makan remah-remah",
