      "diatessaron_verse": "31",
      "ref": "Matthew 15:9",
      "arabic_page": 79,
      "text": "Percuma mereka beribadah kepada-Ku, sedangkan ajaran yang mereka ajarkan ialah perintah manusia.\"",
      "ref_id": "Matius 15:9",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 53,
      "diatessaron_verse": "32",
      "ref": "Mark 7:14",
      "arabic_page": 79,
      "text": "Lalu Yesus memanggil lagi orang banyak dan berkata kepada mereka: \"Kamu semua, dengarlah kepada-Ku dan",
      "ref_id": "Markus 7:14",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 15
    },
    {
      "id": 54,
      "diatessaron_verse": "33",
      "ref": "Mark 7:14",
      "arabic_page": 79,
      "text": "camkanlah.",
      "ref_id": "Markus 7:14",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 1
    },
    {
      "id": 55,
      "diatessaron_verse": "33",
      "ref": "Mark 7:15",
      "arabic_page": 79,
      "text": "Apapun dari luar, yang masuk ke dalam seseorang, tidak dapat menajiskannya,",
      "ref_id": "Markus 7:15",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 56,
      "diatessaron_verse": "34",
      "ref": "Mark 7:15",
      "arabic_page": 79,
      "text": "tetapi apa yang keluar dari seseorang, itulah yang menajiskannya.\"",
      "ref_id": "Markus 7:15",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 9
    },
    {
      "id": 57,
      "diatessaron_verse": "34",
      "ref": "Mark 7:16",
      "arabic_page": 79,
      "text": "(Barangsiapa bertelinga untuk mendengar",
      "ref_id": "Markus 7:16",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 4
    },
    {
      "id": 58,
      "diatessaron_verse": "35",
      "ref": "Mark 7:16",
      "arabic_page": 79,
      "text": "hendaklah ia mendengar!)",
      "ref_id": "Markus 7:16",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 3
    },
    {
      "id": 59,
      "diatessaron_verse": "35",
      "ref": "Matthew 15:12",
      "arabic_page": 79,
      "text": "Maka datanglah murid-murid-Nya dan bertanya kepada-Nya: \"Engkau tahu bahwa",
      "ref_id": "Matius 15:12",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 60,
      "diatessaron_verse": "36",
      "ref": "Matthew 15:12",
      "arabic_page": 79,
      "text": "perkataan-Mu itu telah menjadi batu sandungan bagi orang-orang Farisi?\"",
      "ref_id": "Matius 15:12",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 61,
      "diatessaron_verse": "36",
      "ref": "Matthew 15:13",
      "arabic_page": 79,
      "text": "Jawab Yesus: \"Setiap tanaman yang tidak ditanam oleh Bapa-Ku yang di sorga akan",
      "ref_id": "Matius 15:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 62,
      "diatessaron_verse": "37",
      "ref": "Matthew 15:13",
      "arabic_page": 80,
      "text": "dicabut dengan akar-akarnya.",
      "ref_id": "Matius 15:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 63,
      "diatessaron_verse": "37",
      "ref": "Matthew 15:14",
      "arabic_page": 80,
      "text": "Biarkanlah mereka itu. Mereka orang buta yang menuntun orang buta. Jika orang buta menuntun orang buta, pasti keduanya jatuh ke dalam lobang.\"",
      "ref_id": "Matius 15:14",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 22
    },
    {
      "id": 64,
      "diatessaron_verse": "38",
      "ref": "Mark 7:17",
      "arabic_page": 80,
      "text": "Sesudah Ia masuk ke sebuah rumah untuk menyingkir dari orang banyak,",
      "ref_id": "Markus 7:17",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 65,
      "diatessaron_verse": "38",
      "ref": "Matthew 15:15",
      "arabic_page": 80,
      "text": "Lalu Petrus berkata kepada-Nya:",
      "ref_id": "Matius 15:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 66,
      "diatessaron_verse": "39",
      "ref": "Matthew 15:15",
      "arabic_page": 80,
      "text": "\"Jelaskanlah perumpamaan itu kepada kami.\"",
      "ref_id": "Matius 15:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 67,
      "diatessaron_verse": "39",
      "ref": "Mark 7:18",
      "arabic_page": 80,
      "text": "Maka jawab-Nya: \"Apakah kamu juga tidak dapat memahaminya? Tidak tahukah kamu bahwa segala sesuatu dari luar yang masuk ke dalam",
      "ref_id": "Markus 7:18",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 20
    },
    {
      "id": 68,
      "diatessaron_verse": "40",
      "ref": "Mark 7:18",
      "arabic_page": 80,
      "text": "seseorang tidak dapat menajiskannya,",
      "ref_id": "Markus 7:18",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 4
    },
    {
      "id": 69,
      "diatessaron_verse": "40",
      "ref": "Mark 7:19",
      "arabic_page": 80,
      "text": "karena bukan masuk ke dalam hati tetapi ke dalam perutnya, lalu dibuang di jamban?\" Dengan demikian",
      "ref_id": "Markus 7:19",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 16
    },
    {
      "id": 70,
      "diatessaron_verse": "41",
      "ref": "Mark 7:19",
      "arabic_page": 80,
      "text": "Ia menyatakan semua makanan halal.",
      "ref_id": "Markus 7:19",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 5
    },
    {
