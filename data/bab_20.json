      "ref": "Mark 7:2",
      "arabic_page": 78,
      "text": "tidak dibasuh.",
      "ref_id": "Markus 7:2",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 2
    },
    {
      "id": 31,
      "diatessaron_verse": "19",
      "ref": "Mark 7:3",
      "arabic_page": 78,
      "text": "Sebab orang-orang Farisi seperti orang-orang Yahudi lainnya tidak makan kalau tidak melakukan pembasuhan tangan lebih dulu,",
      "ref_id": "Markus 7:3",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 16
    },
    {
