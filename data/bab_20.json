      "diatessaron_verse": "29",
      "ref": "Matthew 15:7",
      "arabic_page": 79,
      "text": "Hai orang-orang munafik! Benarlah nubuat Yesaya tentang kamu:",
      "ref_id": "Matius 15:7",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
