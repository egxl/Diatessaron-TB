      "diatessaron_verse": "13",
      "ref": "Luke 11:37",
      "arabic_page": 78,
      "text": "untuk makan di rumahnya. Maka masuklah Ia ke rumah itu, lalu duduk makan.",
      "ref_id": "Lukas 11:37",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 23,
      "diatessaron_verse": "13",
      "ref": "Luke 11:38",
      "arabic_page": 78,
      "text": "Orang Farisi itu melihat hal itu",
