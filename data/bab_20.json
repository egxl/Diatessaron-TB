      "diatessaron_verse": "43",
      "ref": "Mark 7:22",
      "arabic_page": 80,
      "text": "perzinahan, keserakahan, kejahatan, kelicikan, hawa nafsu, iri hati, hujat, kesombongan, kebebalan.",
