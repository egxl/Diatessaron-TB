      "diatessaron_verse": "41",
      "ref": "Matthew 15:18",
      "arabic_page": 80,
      "text": "Tetapi apa yang keluar dari mulut",
      "ref_id": "Matius 15:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
