      "diatessaron_verse": "42",
      "ref": "Matthew 15:18",
      "arabic_page": 80,
      "text": "berasal dari hati dan itulah yang menajiskan orang.",
      "ref_id": "Matius 15:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 73,
      "diatessaron_verse": "42",
      "ref": "Mark 7:21",
      "arabic_page": 80,
      "text": "sebab dari dalam,",
      "ref_id": "Markus 7:21",
