      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 21
    },
    {
      "id": 21,
      "diatessaron_verse": "12",
      "ref": "Luke 11:37",
      "arabic_page": 78,
      "text": "Ketika Yesus selesai mengajar, seorang Farisi mengundang Dia",
