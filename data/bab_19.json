      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 12
    },
    {
      "id": 32,
      "diatessaron_verse": "19",
      "ref": "John 6:25",
      "arabic_page": 75,
      "text": "Ketika orang banyak menemukan Yesus di seberang laut itu, mereka berkata kepada-Nya:",
