      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 6
    },
    {
      "id": 45,
      "diatessaron_verse": "26",
      "ref": "John 6:32",
      "arabic_page": 75,
      "text": "Maka kata Yesus kepada mereka: \"Aku berkata kepadamu, sesungguhnya bukan Musa yang memberikan kamu roti dari sorga,",
