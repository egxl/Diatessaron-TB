    {
      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Matthew 14:25",
      "arabic_page": null,
      "text": "Kira-kira jam tiga malam datanglah Yesus kepada mereka",
      "ref_id": "Matius 14:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Matthew 14:25",
      "arabic_page": null,
      "text": "berjalan di atas air.",
      "ref_id": "Matius 14:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "John 6:19",
      "arabic_page": null,
      "text": "Sesudah mereka mendayung kira-kira dua tiga mil jauhnya,",
      "ref_id": "Yohanes 6:19",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 8
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "John 6:19",
      "arabic_page": null,
      "text": "Ketika murid-murid-Nya melihat Dia berjalan di atas air, mereka terkejut dan berseru: \"Itu hantu!\", lalu",
      "ref_id": "Yohanes 6:19",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 15
    },
    {
      "id": 5,
      "diatessaron_verse": "4",
      "ref": "John 6:19",
      "arabic_page": null,
      "text": "berteriak-teriak karena takut.",
      "ref_id": "Yohanes 6:19",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 3
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Matthew 14:27",
      "arabic_page": null,
      "text": "Tetapi segera Yesus berkata kepada mereka:",
      "ref_id": "Matius 14:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "Matthew 14:27",
      "arabic_page": null,
      "text": "\"Tenanglah! Aku ini, jangan takut!\"",
      "ref_id": "Matius 14:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Matthew 14:28",
      "arabic_page": null,
      "text": "Lalu Petrus berseru dan menjawab Dia: \"Tuhan, apabila Engkau itu,",
      "ref_id": "Matius 14:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 9,
      "diatessaron_verse": "6",
      "ref": "Matthew 14:28",
      "arabic_page": null,
      "text": "suruhlah aku datang kepada-Mu berjalan di atas air.\"",
      "ref_id": "Matius 14:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 10,
      "diatessaron_verse": "6",
      "ref": "Matthew 14:29",
      "arabic_page": null,
      "text": "Kata Yesus: \"Datanglah!\"",
      "ref_id": "Matius 14:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "Matthew 14:29",
      "arabic_page": null,
      "text": "Maka Petrus turun dari perahu dan berjalan di atas air mendapatkan Yesus.",
      "ref_id": "Matius 14:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 12,
      "diatessaron_verse": "7",
      "ref": "Matthew 14:30",
      "arabic_page": 74,
      "text": "Tetapi ketika dirasanya tiupan angin, takutlah ia dan mulai tenggelam lalu berteriak: \"Tuhan, tolonglah aku!\"",
      "ref_id": "Matius 14:30",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 13,
      "diatessaron_verse": "7",
      "ref": "Matthew 14:31",
      "arabic_page": 74,
      "text": "Segera Yesus mengulurkan tangan-Nya, memegang dia dan berkata:",
      "ref_id": "Matius 14:31",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 14,
      "diatessaron_verse": "9",
      "ref": "Matthew 14:31",
      "arabic_page": 74,
      "text": "\"Hai orang yang kurang percaya, mengapa engkau bimbang?\"",
      "ref_id": "Matius 14:31",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "Matthew 14:32",
      "arabic_page": 74,
      "text": "Lalu mereka naik",
      "ref_id": "Matius 14:32",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 16,
      "diatessaron_verse": "10",
      "ref": "Matthew 14:32",
      "arabic_page": 74,
      "text": "ke perahu dan anginpun redalah.",
      "ref_id": "Matius 14:32",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 17,
      "diatessaron_verse": "10",
      "ref": "Matthew 14:33",
      "arabic_page": 74,
      "text": "Dan orang-orang yang ada di perahu menyembah Dia, katanya: \"Sesungguhnya Engkau",
      "ref_id": "Matius 14:33",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 18,
      "diatessaron_verse": "11",
      "ref": "Matthew 14:33",
      "arabic_page": 74,
      "text": "Anak Allah.\"",
      "ref_id": "Matius 14:33",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 19,
      "diatessaron_verse": "11",
      "ref": "John 6:21b",
      "arabic_page": 74,
      "text": "dan seketika juga perahu itu sampai ke pantai yang mereka tujui.",
      "ref_id": "Yohanes 6:21b",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 11
    },
    {
      "id": 20,
      "diatessaron_verse": "12",
      "ref": "Matthew 14:34",
      "arabic_page": 74,
      "text": "Setibanya di seberang mereka mendarat di Genesaret.",
      "ref_id": "Matius 14:34",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 21,
      "diatessaron_verse": "12",
      "ref": "Mark 6:51b",
      "arabic_page": 74,
      "text": "Mereka sangat tercengang dan bingung,",
      "ref_id": "Markus 6:51b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 5
    },
    {
      "id": 22,
      "diatessaron_verse": "12",
      "ref": "Mark 6:52",
      "arabic_page": 74,
      "text": "sebab sesudah peristiwa roti itu mereka belum juga mengerti, dan hati mereka tetap degil.",
      "ref_id": "Markus 6:52",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 14
    },
    {
      "id": 23,
      "diatessaron_verse": "14",
      "ref": "Matthew 14:35",
      "arabic_page": 74,
      "text": "Ketika Yesus dikenal oleh orang-orang di tempat itu, mereka memberitahukannya ke seluruh daerah itu. Maka semua orang yang sakit dibawa kepada-Nya.",
      "ref_id": "Matius 14:35",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 21
    },
    {
      "id": 24,
      "diatessaron_verse": "14",
      "ref": "Mark 6:55b",
      "arabic_page": 74,
      "text": "dan mulai mengusung orang-orang sakit",
      "ref_id": "Markus 6:55b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 5
    },
    {
      "id": 25,
      "diatessaron_verse": "15",
      "ref": "Mark 6:55b",
      "arabic_page": 74,
      "text": "di atas tilamnya kepada Yesus, di mana saja kabarnya Ia berada.",
      "ref_id": "Markus 6:55b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 26,
      "diatessaron_verse": "15",
      "ref": "Mark 6:56",
      "arabic_page": 74,
      "text": "Ke manapun Ia pergi, ke desa-desa, ke kota-kota, atau ke kampung-kampung, orang meletakkan orang-orang sakit di pasar dan memohon kepada-Nya, supaya mereka diperkenankan hanya menjamah jumbai jubah-Nya saja. Dan semua orang yang menjamah-Nya menjadi sembuh.",
      "ref_id": "Markus 6:56",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 35
    },
    {
      "id": 27,
      "diatessaron_verse": "16",
      "ref": "John 6:22",
      "arabic_page": 74,
      "text": "Pada keesokan harinya orang banyak, yang masih tinggal di seberang, melihat bahwa di situ tidak ada perahu selain dari pada yang satu tadi dan bahwa Yesus tidak turut naik ke perahu itu bersama-sama dengan murid-murid-Nya, dan bahwa",
      "ref_id": "Yohanes 6:22",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 37
    },
    {
      "id": 28,
      "diatessaron_verse": "17",
      "ref": "John 6:22",
      "arabic_page": 74,
      "text": "murid-murid-Nya saja yang berangkat.",
      "ref_id": "Yohanes 6:22",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 4
    },
    {
      "id": 29,
      "diatessaron_verse": "17",
      "ref": "John 6:23",
      "arabic_page": 74,
      "text": "Tetapi sementara itu beberapa perahu lain datang dari Tiberias dekat ke tempat mereka makan roti, sesudah Tuhan mengucapkan syukur atasnya.",
      "ref_id": "Yohanes 6:23",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 20
    },
    {
      "id": 30,
      "diatessaron_verse": "17",
      "ref": "John 6:24",
      "arabic_page": 74,
      "text": "Ketika orang banyak melihat, bahwa Yesus tidak ada di situ dan murid-murid-Nya juga tidak,",
      "ref_id": "Yohanes 6:24",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 14
    },
    {
      "id": 31,
      "diatessaron_verse": "19",
      "ref": "John 6:24",
      "arabic_page": 75,
      "text": "mereka naik ke perahu-perahu itu lalu berangkat ke Kapernaum untuk mencari Yesus.",
