      "diatessaron_verse": "20",
      "ref": "John 6:26",
      "arabic_page": 75,
      "text": "Yesus menjawab mereka: \"Aku berkata kepadamu, sesungguhnya kamu mencari Aku, bukan karena kamu telah melihat tanda-tanda, melainkan karena kamu",
      "ref_id": "Yohanes 6:26",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
