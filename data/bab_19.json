      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 12
    },
    {
      "id": 33,
      "diatessaron_verse": "20",
      "ref": "John 6:25",
      "arabic_page": 75,
      "text": "\"Rabi, bilamana Engkau tiba di sini?\"",
      "ref_id": "Yohanes 6:25",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 6
    },
    {
