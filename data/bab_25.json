      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 58,
      "diatessaron_verse": "34",
      "ref": "Matthew 19:7",
      "arabic_page": 99,
      "text": "Kata mereka kepada-Nya: \"Jika demikian, apakah sebabnya Musa memerintahkan untuk memberikan surat cerai jika orang menceraikan isterinya?\"",
