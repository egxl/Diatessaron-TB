      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 23,
      "diatessaron_verse": "13",
      "ref": "Matthew 18:6",
      "arabic_page": 97,
      "text": "\"Tetapi barangsiapa menyesatkan salah satu dari anak-anak kecil ini yang percaya kepada-Ku, lebih baik baginya jika sebuah batu kilangan diikatkan pada lehernya lalu ia ditenggelamkan ke dalam laut.",
      "ref_id": "Matius 18:6",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 28
