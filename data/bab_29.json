      "arabic_page": 113,
      "text": "Tetapi tuan itu menjawab seorang dari mereka: Saudara, aku tidak berlaku tidak adil terhadap engkau. Bukankah",
      "ref_id": "Matius 20:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
