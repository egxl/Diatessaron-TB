      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 7
    },
    {
      "id": 14,
      "diatessaron_verse": "9",
      "ref": "Mark 10:29b",
      "arabic_page": 111,
      "text": "karena Aku dan karena Injil meninggalkan rumahnya, saudaranya laki-laki atau saudaranya perempuan, ibunya atau bapanya, anak-anaknya atau ladangnya,",
      "ref_id": "Markus 10:29b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 18
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "Luke 18:30",
      "arabic_page": 111,
      "text": "akan menerima kembali lipat ganda pada masa ini juga, dan pada zaman yang akan datang ia akan menerima hidup yang kekal.\"",
      "ref_id": "Lukas 18:30",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 21
    },
    {
      "id": 16,
      "diatessaron_verse": "9",
      "ref": "Mark 10:30b",
      "arabic_page": 111,
      "text": "Sekarang pada masa ini juga akan menerima kembali seratus kali lipat: rumah, saudara laki-laki, saudara perempuan, ibu, anak dan ladang, sekalipun disertai berbagai penganiayaan,",
      "ref_id": "Markus 10:30b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 24
    },
    {
      "id": 17,
      "diatessaron_verse": "11",
      "ref": "Mark 10:30b",
      "arabic_page": 111,
      "text": "dan pada zaman yang akan datang ia akan menerima hidup yang kekal.",
      "ref_id": "Markus 10:30b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 12
    },
    {
      "id": 18,
      "diatessaron_verse": "11",
      "ref": "Mark 10:31",
      "arabic_page": 111,
      "text": "Tetapi banyak orang yang terdahulu akan menjadi yang terakhir dan yang terakhir akan menjadi yang terdahulu.\"",
