      "diatessaron_verse": "35",
      "ref": "Matthew 20:8",
      "arabic_page": 113,
      "text": "upah mereka, mulai dengan mereka yang masuk terakhir hingga mereka yang masuk terdahulu.",
      "ref_id": "Matius 20:8",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 60,
      "diatessaron_verse": "35",
      "ref": "Matthew 20:9",
      "arabic_page": 113,
      "text": "Maka datanglah",
