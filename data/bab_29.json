      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 21,
      "diatessaron_verse": "13",
      "ref": "Luke 16:15",
      "arabic_page": 111,
      "text": "Lalu Ia berkata kepada mereka: \"Kamu membenarkan diri di hadapan orang, tetapi Allah mengetahui hatimu. Sebab apa yang dikagumi manusia, dibenci oleh Allah.",
      "ref_id": "Lukas 16:15",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 23
    },
    {
      "id": 22,
      "diatessaron_verse": "14",
      "ref": "Luke 16:19",
      "arabic_page": 111,
      "text": "\"Ada seorang kaya yang selalu berpakaian jubah ungu dan kain halus, dan",
      "ref_id": "Lukas 16:19",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
