      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 55,
      "diatessaron_verse": "32",
      "ref": "Matthew 20:6",
      "arabic_page": 113,
      "text": "Kira-kira pukul lima petang ia keluar lagi dan mendapati orang-orang lain pula, lalu katanya kepada mereka: Mengapa kamu menganggur saja di sini sepanjang hari?",
      "ref_id": "Matius 20:6",
      "book_code": "mat",
