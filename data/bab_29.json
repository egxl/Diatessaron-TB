      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 29,
      "diatessaron_verse": "18",
      "ref": "Luke 16:23",
      "arabic_page": 112,
      "text": "Orang kaya itu juga mati, lalu dikubur. Dan sementara ia menderita sengsara di alam maut",
