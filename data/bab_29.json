      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 19
    },
    {
      "id": 53,
      "diatessaron_verse": "31",
      "ref": "Matthew 20:5",
      "arabic_page": 113,
      "text": "Kira-kira pukul dua belas dan pukul tiga petang ia keluar pula dan",
      "ref_id": "Matius 20:5",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
