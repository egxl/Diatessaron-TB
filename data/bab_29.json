      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Matthew 19:23",
      "arabic_page": null,
      "text": "Yesus berkata kepada murid-murid-Nya: \"Aku berkata kepadamu, sesungguhnya sukar sekali bagi seorang kaya untuk masuk ke dalam Kerajaan",
      "ref_id": "Matius 19:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 18
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Matthew 19:23",
      "arabic_page": null,
      "text": "Sorga.",
      "ref_id": "Matius 19:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 1
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Matthew 19:24",
      "arabic_page": null,
      "text": "Sekali lagi Aku berkata kepadamu, lebih mudah seekor unta masuk melalui lobang",
      "ref_id": "Matius 19:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Matthew 19:24",
      "arabic_page": null,
      "text": "jarum dari pada seorang kaya masuk ke dalam Kerajaan Allah.\"",
      "ref_id": "Matius 19:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "Mark 10:24",
      "arabic_page": null,
      "text": "Murid-murid-Nya tercengang mendengar perkataan-Nya itu. Tetapi Yesus menyambung lagi: \"Anak-anak-Ku, alangkah sukarnya masuk ke dalam",
      "ref_id": "Markus 10:24",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 15
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Mark 10:24",
      "arabic_page": null,
      "text": "Kerajaan Allah. Mark 10:26 Mereka makin gempar dan berkata seorang",
      "ref_id": "Markus 10:24",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 10
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "Mark 10:24",
      "arabic_page": null,
      "text": "kepada yang lain: \"Jika demikian, siapakah yang dapat diselamatkan?\"",
      "ref_id": "Markus 10:24",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 9
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Mark 10:27",
      "arabic_page": null,
      "text": "Yesus memandang mereka dan berkata: \"Bagi manusia hal itu tidak mungkin, tetapi bukan demikian bagi Allah.",
      "ref_id": "Markus 10:27",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 16
    },
    {
      "id": 9,
      "diatessaron_verse": "6",
      "ref": "Mark 10:27",
      "arabic_page": 111,
      "text": "Sebab segala sesuatu adalah mungkin bagi Allah.\" [Matthew 19:27] Lalu Petrus menjawab dan berkata kepada Yesus: \"Kami ini telah meninggalkan segala sesuatu dan mengikut Engkau; jadi apakah yang akan",
      "ref_id": "Markus 10:27",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 29
    },
    {
      "id": 10,
      "diatessaron_verse": "7",
      "ref": "Mark 10:27",
      "arabic_page": 111,
      "text": "kami peroleh?\"",
      "ref_id": "Markus 10:27",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 2
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "Matthew 19:28",
      "arabic_page": 111,
      "text": "Kata Yesus kepada mereka: \"Aku berkata kepadamu, sesungguhnya pada waktu penciptaan kembali, apabila Anak Manusia bersemayam di takhta kemuliaan-Nya, kamu, yang telah mengikut Aku,",
      "ref_id": "Matius 19:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 24
    },
    {
      "id": 12,
      "diatessaron_verse": "8",
      "ref": "Matthew 19:28",
      "arabic_page": 111,
      "text": "akan duduk juga di atas dua belas takhta untuk menghakimi kedua belas suku Israel.",
      "ref_id": "Matius 19:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 14
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "Mark 10:29b",
      "arabic_page": 111,
      "text": "\"Aku berkata kepadamu, sesungguhnya setiap orang yang",
