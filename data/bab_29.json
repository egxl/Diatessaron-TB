    {
      "id": 52,
      "diatessaron_verse": "30",
      "ref": "Matthew 20:4",
      "arabic_page": 113,
      "text": "Katanya kepada mereka: Pergi jugalah kamu ke kebun anggurku dan apa yang pantas akan kuberikan kepadamu. Dan merekapun pergi.",
