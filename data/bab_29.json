    {
      "id": 28,
      "diatessaron_verse": "17",
      "ref": "Luke 16:22",
      "arabic_page": 112,
      "text": "Kemudian matilah orang miskin itu, lalu dibawa oleh malaikat-malaikat ke pangkuan Abraham.",
