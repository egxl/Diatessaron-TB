      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Matthew 10:16",
      "arabic_page": null,
      "text": "\"Lihat, Aku mengutus kamu seperti domba ke tengah-tengah serigala, sebab itu hendaklah kamu cerdik seperti ular dan",
      "ref_id": "Matius 10:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Matthew 10:16",
      "arabic_page": null,
      "text": "tulus seperti merpati.",
      "ref_id": "Matius 10:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Matthew 10:17",
      "arabic_page": null,
      "text": "Tetapi waspadalah terhadap semua orang; karena ada yang akan menyerahkan kamu kepada",
      "ref_id": "Matius 10:17",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Matthew 10:17",
      "arabic_page": null,
      "text": "majelis agama dan mereka akan menyesah kamu di rumah ibadatnya.",
      "ref_id": "Matius 10:17",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "Matthew 10:18",
      "arabic_page": null,
      "text": "Dan karena Aku, kamu akan digiring ke muka penguasa-penguasa dan raja-raja sebagai suatu kesaksian bagi mereka dan bagi orang-orang yang tidak mengenal Allah.",
      "ref_id": "Matius 10:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 23
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Matthew 10:19",
      "arabic_page": null,
      "text": "Apabila mereka menyerahkan kamu, janganlah kamu kuatir akan bagaimana dan akan apa yang harus",
      "ref_id": "Matius 10:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 14
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "Matthew 10:19",
      "arabic_page": null,
      "text": "kamu katakan, karena semuanya itu akan dikaruniakan kepadamu pada saat itu juga.",
      "ref_id": "Matius 10:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Matthew 10:20",
      "arabic_page": null,
      "text": "Karena bukan kamu",
      "ref_id": "Matius 10:20",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 9,
      "diatessaron_verse": "6",
      "ref": "Matthew 10:20",
      "arabic_page": null,
      "text": "yang berkata-kata, melainkan Roh Bapamu; Dia yang akan berkata-kata di dalam kamu.",
      "ref_id": "Matius 10:20",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 10,
      "diatessaron_verse": "6",
      "ref": "Matthew 10:21",
      "arabic_page": null,
      "text": "Orang akan menyerahkan saudaranya untuk dibunuh, demikian juga seorang ayah akan anaknya. Dan anak-anak akan memberontak terhadap",
      "ref_id": "Matius 10:21",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "Matthew 10:21",
      "arabic_page": null,
      "text": "orang tuanya dan akan membunuh mereka.",
      "ref_id": "Matius 10:21",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 12,
      "diatessaron_verse": "7",
      "ref": "Matthew 10:22",
      "arabic_page": null,
      "text": "Dan kamu akan dibenci semua orang oleh karena",
      "ref_id": "Matius 10:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "Matthew 10:22",
      "arabic_page": null,
      "text": "nama-Ku; tetapi orang yang bertahan sampai pada kesudahannya akan selamat.",
      "ref_id": "Matius 10:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 14,
      "diatessaron_verse": "8",
      "ref": "Matthew 10:23",
      "arabic_page": null,
      "text": "Apabila mereka menganiaya kamu dalam kota yang satu, larilah ke kota yang lain; karena Aku berkata kepadamu: Sesungguhnya sebelum kamu selesai mengunjungi kota-kota Israel, Anak Manusia sudah datang.",
      "ref_id": "Matius 10:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 28
    },
    {
      "id": 15,
      "diatessaron_verse": "9, 10",
      "ref": "Matthew 10:24",
      "arabic_page": null,
      "text": "Seorang murid tidak lebih dari pada gurunya, atau seorang hamba dari pada tuannya.",
      "ref_id": "Matius 10:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 16,
      "diatessaron_verse": "9, 10",
      "ref": "Matthew 10:25",
      "arabic_page": null,
      "text": "Cukuplah bagi seorang murid jika ia menjadi sama seperti gurunya dan bagi seorang hamba jika ia menjadi sama seperti tuannya. Jika tuan rumah disebut Beelzebul, apalagi",
      "ref_id": "Matius 10:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 26
    },
    {
      "id": 17,
      "diatessaron_verse": "11",
      "ref": "Matthew 10:25",
      "arabic_page": null,
      "text": "seisi rumahnya.",
      "ref_id": "Matius 10:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 18,
      "diatessaron_verse": "11",
      "ref": "Matthew 10:26",
      "arabic_page": null,
      "text": "Jadi janganlah kamu takut terhadap mereka, karena tidak ada sesuatupun yang tertutup",
      "ref_id": "Matius 10:26",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 19,
      "diatessaron_verse": "12",
      "ref": "Matthew 10:26",
      "arabic_page": 51,
      "text": "yang tidak akan dibuka dan tidak ada sesuatupun yang tersembunyi yang tidak akan diketahui.",
      "ref_id": "Matius 10:26",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 14
    },
    {
      "id": 20,
      "diatessaron_verse": "12",
      "ref": "Matthew 10:27",
      "arabic_page": 51,
      "text": "Apa yang Kukatakan kepadamu dalam gelap, katakanlah itu dalam terang; dan apa yang",
      "ref_id": "Matius 10:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 21,
      "diatessaron_verse": "13",
      "ref": "Matthew 10:27",
      "arabic_page": 51,
      "text": "dibisikkan ke telingamu, beritakanlah itu dari atas atap rumah.",
      "ref_id": "Matius 10:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 22,
      "diatessaron_verse": "13",
      "ref": "Luke 12:4",
      "arabic_page": 51,
      "text": "Aku berkata kepadamu, hai sahabat-sahabat-Ku,",
      "ref_id": "Lukas 12:4",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 23,
      "diatessaron_verse": "13",
      "ref": "Matthew 10:28",
      "arabic_page": 51,
      "text": "janganlah kamu takut kepada mereka yang dapat membunuh tubuh, tetapi yang tidak",
      "ref_id": "Matius 10:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 24,
      "diatessaron_verse": "14",
      "ref": "Matthew 10:28",
      "arabic_page": 51,
      "text": "berkuasa membunuh jiwa;",
      "ref_id": "Matius 10:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 25,
      "diatessaron_verse": "14",
      "ref": "Luke 12:5",
      "arabic_page": 51,
      "text": "Aku akan menunjukkan kepada kamu siapakah yang harus kamu takuti.",
      "ref_id": "Lukas 12:5",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 26,
      "diatessaron_verse": "14",
      "ref": "Matthew 10:28b",
      "arabic_page": 51,
      "text": "takutlah terutama kepada Dia yang berkuasa membinasakan baik",
      "ref_id": "Matius 10:28b",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 27,
      "diatessaron_verse": "15",
      "ref": "Matthew 10:28b",
      "arabic_page": 51,
      "text": "jiwa maupun tubuh di dalam neraka.",
      "ref_id": "Matius 10:28b",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 28,
      "diatessaron_verse": "15",
      "ref": "Matthew 10:29",
      "arabic_page": 51,
      "text": "Bukankah burung pipit dijual dua ekor seduit? Namun seekorpun dari padanya tidak akan jatuh ke",
      "ref_id": "Matius 10:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 29,
      "diatessaron_verse": "16",
      "ref": "Matthew 10:29",
      "arabic_page": 51,
      "text": "bumi di luar kehendak Bapamu.",
      "ref_id": "Matius 10:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 30,
      "diatessaron_verse": "16",
      "ref": "Matthew 10:30",
      "arabic_page": 51,
      "text": "Dan kamu, rambut kepalamupun",
      "ref_id": "Matius 10:30",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 31,
      "diatessaron_verse": "17, 18",
      "ref": "Matthew 10:30",
      "arabic_page": 51,
      "text": "terhitung semuanya",
      "ref_id": "Matius 10:30",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 32,
      "diatessaron_verse": "17, 18",
      "ref": "Matthew 10:31",
      "arabic_page": 51,
      "text": "Sebab itu janganlah kamu takut, karena kamu lebih berharga dari pada banyak burung pipit.",
      "ref_id": "Matius 10:31",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 14
    },
    {
      "id": 33,
      "diatessaron_verse": "17, 18",
      "ref": "Matthew 10:32",
      "arabic_page": 51,
      "text": "Setiap orang yang mengakui Aku di depan manusia, Aku juga akan mengakuinya di depan Bapa-Ku",
      "ref_id": "Matius 10:32",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 34,
      "diatessaron_verse": "19",
      "ref": "Matthew 10:32",
      "arabic_page": 51,
      "text": "yang di sorga.",
      "ref_id": "Matius 10:32",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 35,
      "diatessaron_verse": "19",
      "ref": "Matthew 10:33",
      "arabic_page": 51,
      "text": "Tetapi barangsiapa menyangkal Aku di depan manusia, Aku juga akan menyangkalnya di depan Bapa-Ku yang di sorga.\"",
      "ref_id": "Matius 10:33",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
    {
      "id": 36,
      "diatessaron_verse": "20",
      "ref": "Luke 12:51",
      "arabic_page": 51,
      "text": "Kamu menyangka, bahwa Aku datang untuk membawa damai di atas bumi? Bukan, kata-Ku kepadamu, bukan damai,",
      "ref_id": "Lukas 12:51",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 16
    },
    {
      "id": 37,
      "diatessaron_verse": "21",
      "ref": "Luke 12:51",
      "arabic_page": 51,
      "text": "melainkan pertentangan.",
      "ref_id": "Lukas 12:51",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 38,
      "diatessaron_verse": "21",
      "ref": "Luke 12:52",
      "arabic_page": 51,
      "text": "Karena mulai dari sekarang akan ada pertentangan antara lima orang di dalam satu rumah,",
      "ref_id": "Lukas 12:52",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 39,
      "diatessaron_verse": "22",
      "ref": "Luke 12:52",
      "arabic_page": 51,
      "text": "tiga melawan dua dan dua melawan tiga.",
      "ref_id": "Lukas 12:52",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 40,
      "diatessaron_verse": "22",
      "ref": "Luke 12:53",
      "arabic_page": 51,
      "text": "Mereka akan saling bertentangan, ayah melawan anaknya laki-laki dan anak laki-laki melawan ayahnya, ibu melawan anaknya perempuan, dan anak perempuan melawan ibunya, ibu mertua melawan menantunya perempuan dan",
      "ref_id": "Lukas 12:53",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 28
    },
    {
      "id": 41,
      "diatessaron_verse": "23",
      "ref": "Luke 12:53",
      "arabic_page": 51,
      "text": "menantu perempuan melawan ibu mertuanya.\"",
      "ref_id": "Lukas 12:53",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 42,
      "diatessaron_verse": "23",
      "ref": "Matthew 10:36",
      "arabic_page": 51,
      "text": "dan musuh orang ialah orang-orang seisi rumahnya.",
      "ref_id": "Matius 10:36",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 43,
      "diatessaron_verse": "24",
      "ref": "Matthew 10:37",
      "arabic_page": 52,
      "text": "Barangsiapa mengasihi bapa atau ibunya lebih dari pada-Ku, ia tidak layak bagi-Ku; dan barangsiapa mengasihi anaknya laki-laki atau perempuan lebih dari pada-Ku, ia tidak layak bagi-Ku.",
      "ref_id": "Matius 10:37",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 26
    },
    {
      "id": 44,
      "diatessaron_verse": "25",
      "ref": "Matthew 10:38",
      "arabic_page": 52,
      "text": "Barangsiapa tidak memikul salibnya dan mengikut Aku, ia tidak layak",
      "ref_id": "Matius 10:38",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 45,
      "diatessaron_verse": "26",
      "ref": "Matthew 10:38",
      "arabic_page": 52,
      "text": "bagi-Ku.",
      "ref_id": "Matius 10:38",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 1
    },
    {
      "id": 46,
      "diatessaron_verse": "26",
      "ref": "Matthew 10:39",
      "arabic_page": 52,
      "text": "Barangsiapa mempertahankan nyawanya, ia akan kehilangan nyawanya, dan barangsiapa kehilangan nyawanya karena Aku, ia akan memperolehnya.",
      "ref_id": "Matius 10:39",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 47,
      "diatessaron_verse": "27",
      "ref": "Matthew 10:40",
      "arabic_page": 52,
      "text": "Barangsiapa menyambut kamu, ia menyambut Aku, dan barangsiapa menyambut Aku, ia menyambut",
      "ref_id": "Matius 10:40",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 48,
      "diatessaron_verse": "28",
      "ref": "Matthew 10:40",
      "arabic_page": 52,
      "text": "Dia yang mengutus Aku.",
      "ref_id": "Matius 10:40",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 49,
      "diatessaron_verse": "28",
      "ref": "Matthew 10:41",
      "arabic_page": 52,
      "text": "Barangsiapa menyambut seorang nabi sebagai nabi, ia akan menerima upah nabi, dan barangsiapa menyambut seorang benar",
      "ref_id": "Matius 10:41",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 50,
      "diatessaron_verse": "29",
      "ref": "Matthew 10:41",
      "arabic_page": 52,
      "text": "sebagai orang benar, ia akan menerima upah orang benar.",
      "ref_id": "Matius 10:41",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 51,
      "diatessaron_verse": "29",
      "ref": "Matthew 10:42",
      "arabic_page": 52,
      "text": "Dan barangsiapa memberi air sejuk secangkir sajapun kepada salah seorang yang kecil ini, karena ia murid-Ku, Aku berkata kepadamu: Sesungguhnya ia tidak akan kehilangan upahnya dari padanya.\"",
      "ref_id": "Matius 10:42",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 27
    },
    {
      "id": 52,
      "diatessaron_verse": "30",
      "ref": "Matthew 11:1",
      "arabic_page": 52,
      "text": "Setelah Yesus selesai berpesan kepada kedua belas murid-Nya, pergilah Ia dari sana untuk",
