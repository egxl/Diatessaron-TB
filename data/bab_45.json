      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 27
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "John 13:27",
      "arabic_page": 170,
      "text": "Dan sesudah Yudas menerima roti itu, ia kerasukan Iblis. Maka Yesus berkata kepadanya: \"Apa yang",
      "ref_id": "Yohanes 13:27",
      "book_code": "yoh",
