      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Mark 7:31",
      "arabic_page": null,
      "text": "Kemudian Yesus meninggalkan pula daerah Tirus dan dengan melalui Sidon pergi ke",
      "ref_id": "Markus 7:31",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 12
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Mark 7:31",
      "arabic_page": null,
      "text": "danau Galilea, di tengah-tengah daerah Dekapolis.",
      "ref_id": "Markus 7:31",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 6
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Mark 7:32",
      "arabic_page": null,
      "text": "Di situ orang membawa kepada-Nya seorang yang tuli dan yang gagap dan memohon kepada-Nya, supaya Ia meletakkan tangan-Nya",
      "ref_id": "Markus 7:32",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 18
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Mark 7:32",
      "arabic_page": null,
      "text": "atas orang itu.",
      "ref_id": "Markus 7:32",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 3
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "Mark 7:33",
      "arabic_page": null,
      "text": "Dan sesudah Yesus memisahkan dia dari orang banyak, sehingga mereka sendirian,",
      "ref_id": "Markus 7:33",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Mark 7:33",
      "arabic_page": null,
      "text": "Ia memasukkan jari-Nya ke telinga orang itu, lalu Ia meludah dan meraba lidah orang itu.",
      "ref_id": "Markus 7:33",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 15
    },
    {
      "id": 7,
      "diatessaron_verse": "4",
      "ref": "Mark 7:34",
      "arabic_page": null,
      "text": "Kemudian sambil menengadah",
      "ref_id": "Markus 7:34",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 3
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Mark 7:34",
      "arabic_page": null,
      "text": "ke langit Yesus menarik nafas dan berkata kepadanya: \"Efata!\", artinya: Terbukalah!",
      "ref_id": "Markus 7:34",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 9,
      "diatessaron_verse": "5",
      "ref": "Mark 7:35",
      "arabic_page": null,
      "text": "Maka",
      "ref_id": "Markus 7:35",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 1
    },
    {
      "id": 10,
      "diatessaron_verse": "6",
      "ref": "Mark 7:35",
      "arabic_page": null,
      "text": "terbukalah telinga orang itu dan seketika itu terlepas pulalah pengikat lidahnya, lalu ia berkata-kata dengan baik.",
      "ref_id": "Markus 7:35",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 16
    },
    {
      "id": 11,
      "diatessaron_verse": "6",
      "ref": "Mark 7:36",
      "arabic_page": null,
      "text": "Yesus berpesan kepada orang-orang yang ada di situ supaya jangan menceriterakannya kepada siapapun juga.",
      "ref_id": "Markus 7:36",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 14
    },
    {
      "id": 12,
      "diatessaron_verse": "7",
      "ref": "Mark 7:36",
      "arabic_page": null,
      "text": "Tetapi makin dilarang-Nya mereka, makin luas mereka memberitakannya.",
      "ref_id": "Markus 7:36",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 8
    },
    {
      "id": 13,
      "diatessaron_verse": "7",
      "ref": "Mark 7:37",
      "arabic_page": 82,
      "text": "Mereka takjub dan tercengang dan berkata: \"Ia menjadikan segala-galanya baik, yang tuli dijadikan-Nya mendengar, yang bisu dijadikan-Nya berkata-kata.\"",
      "ref_id": "Markus 7:37",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 18
    },
    {
      "id": 14,
      "diatessaron_verse": "8, 9",
      "ref": "John 4:4",
      "arabic_page": 82,
      "text": "Ia harus melintasi daerah Samaria.,",
      "ref_id": "Yohanes 4:4",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 5
    },
    {
      "id": 15,
      "diatessaron_verse": "8, 9",
      "ref": "John 4:5",
      "arabic_page": 82,
      "text": "Maka sampailah Ia ke sebuah kota di Samaria, yang bernama Sikhar dekat tanah yang diberikan Yakub dahulu kepada",
      "ref_id": "Yohanes 4:5",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 18
    },
    {
      "id": 16,
      "diatessaron_verse": "10",
      "ref": "John 4:5",
      "arabic_page": 82,
      "text": "anaknya, Yusuf.",
      "ref_id": "Yohanes 4:5",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 2
    },
    {
      "id": 17,
      "diatessaron_verse": "10",
      "ref": "John 4:6",
      "arabic_page": 82,
      "text": "Di situ terdapat sumur Yakub. Yesus sangat letih oleh perjalanan, karena itu Ia duduk di pinggir sumur itu.",
      "ref_id": "Yohanes 4:6",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 18
    },
    {
      "id": 18,
      "diatessaron_verse": "11",
      "ref": "John 4:6",
      "arabic_page": 82,
      "text": "Hari kira-kira pukul dua belas.",
      "ref_id": "Yohanes 4:6",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 5
    },
    {
      "id": 19,
      "diatessaron_verse": "11",
      "ref": "John 4:7",
      "arabic_page": 82,
      "text": "Maka datanglah seorang perempuan Samaria hendak menimba air. Kata Yesus",
      "ref_id": "Yohanes 4:7",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 10
    },
    {
      "id": 20,
      "diatessaron_verse": "12",
      "ref": "John 4:7",
      "arabic_page": 82,
      "text": "kepadanya: \"Berilah Aku minum.\"",
      "ref_id": "Yohanes 4:7",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 4
    },
    {
      "id": 21,
      "diatessaron_verse": "12",
      "ref": "John 4:8",
      "arabic_page": 82,
      "text": "Sebab murid-murid-Nya telah pergi ke kota",
      "ref_id": "Yohanes 4:8",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 6
    },
    {
      "id": 22,
      "diatessaron_verse": "13",
      "ref": "John 4:8",
      "arabic_page": 82,
      "text": "membeli makanan.",
      "ref_id": "Yohanes 4:8",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 2
    },
    {
      "id": 23,
      "diatessaron_verse": "13",
      "ref": "John 4:9",
      "arabic_page": 82,
      "text": "Maka kata perempuan Samaria itu kepada-Nya: \"Masakan Engkau, seorang Yahudi, minta minum kepadaku, seorang Samaria?\" (Sebab orang Yahudi tidak bergaul dengan orang Samaria.)",
      "ref_id": "Yohanes 4:9",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 23
    },
    {
      "id": 24,
      "diatessaron_verse": "14",
      "ref": "John 4:10",
      "arabic_page": 82,
      "text": "Jawab Yesus kepadanya: \"Jikalau engkau tahu tentang karunia Allah dan siapakah Dia yang berkata kepadamu:",
      "ref_id": "Yohanes 4:10",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 15
    },
    {
      "id": 25,
      "diatessaron_verse": "15",
      "ref": "John 4:10",
      "arabic_page": 82,
      "text": "Berilah Aku minum! niscaya engkau telah meminta kepada-Nya dan Ia telah memberikan kepadamu air hidup.\"",
      "ref_id": "Yohanes 4:10",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 15
    },
    {
      "id": 26,
      "diatessaron_verse": "15",
      "ref": "John 4:11",
      "arabic_page": 82,
      "text": "Kata perempuan itu kepada-Nya: \"Tuhan, Engkau tidak punya timba dan sumur ini amat dalam;",
      "ref_id": "Yohanes 4:11",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 14
    },
    {
      "id": 27,
      "diatessaron_verse": "16",
      "ref": "John 4:11",
      "arabic_page": 82,
      "text": "dari manakah Engkau memperoleh air hidup itu?",
      "ref_id": "Yohanes 4:11",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 7
    },
    {
      "id": 28,
      "diatessaron_verse": "16",
      "ref": "John 4:12",
      "arabic_page": 82,
      "text": "Adakah Engkau lebih besar dari pada bapa kami Yakub, yang memberikan sumur ini kepada kami dan yang telah minum sendiri dari dalamnya, ia serta anak-anaknya dan ternaknya?\"",
      "ref_id": "Yohanes 4:12",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 27
    },
    {
      "id": 29,
      "diatessaron_verse": "17",
      "ref": "John 4:13",
      "arabic_page": 82,
      "text": "Jawab Yesus kepadanya: \"Barangsiapa minum air ini, ia akan haus lagi,",
      "ref_id": "Yohanes 4:13",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 11
    },
    {
      "id": 30,
      "diatessaron_verse": "18",
      "ref": "John 4:14",
      "arabic_page": 82,
      "text": "tetapi barangsiapa minum air yang akan Kuberikan kepadanya, ia tidak akan haus untuk selama-lamanya. Sebaliknya air yang akan Kuberikan kepadanya, akan menjadi mata air di dalam dirinya, yang terus-menerus memancar",
      "ref_id": "Yohanes 4:14",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 30
    },
    {
      "id": 31,
      "diatessaron_verse": "19",
      "ref": "John 4:14",
      "arabic_page": 82,
      "text": "sampai kepada hidup yang kekal.\"",
      "ref_id": "Yohanes 4:14",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 5
    },
    {
      "id": 32,
      "diatessaron_verse": "19",
      "ref": "John 4:15",
      "arabic_page": 82,
      "text": "Kata perempuan itu kepada-Nya: \"Tuhan, berikanlah aku air itu,",
      "ref_id": "Yohanes 4:15",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 9
    },
    {
      "id": 33,
      "diatessaron_verse": "20",
      "ref": "John 4:15",
      "arabic_page": 82,
      "text": "supaya aku tidak haus dan tidak usah datang lagi ke sini untuk menimba air.\"",
      "ref_id": "Yohanes 4:15",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 14
    },
