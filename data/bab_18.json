      "arabic_page": 70,
      "text": "lalu bersumpah kepadanya: \"Apa saja yang kauminta akan kuberikan kepadamu,",
      "ref_id": "Markus 6:23",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 10
    },
