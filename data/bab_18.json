      "diatessaron_verse": "14",
      "ref": "Mark 6:24",
      "arabic_page": 70,
      "text": "Anak itu pergi dan menanyakan ibunya: \"Apa yang harus kuminta?\" Jawabnya:",
      "ref_id": "Markus 6:24",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 28,
      "diatessaron_verse": "15",
      "ref": "Mark 6:24",
      "arabic_page": 70,
      "text": "\"Kepala Yohanes Pembaptis!\"",
