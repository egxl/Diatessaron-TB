      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 21
    },
    {
      "id": 24,
      "diatessaron_verse": "13",
      "ref": "Mark 6:22",
      "arabic_page": 70,
      "text": "\"Minta dari padaku apa saja yang kauingini, maka akan kuberikan kepadamu!\",",
      "ref_id": "Markus 6:22",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
