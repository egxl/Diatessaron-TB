      "diatessaron_verse": "53",
      "ref": "Matthew 5:23",
      "arabic_page": 33,
      "text": "hati saudaramu terhadap engkau,",
      "ref_id": "Matius 5:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 83,
      "diatessaron_verse": "53",
      "ref": "Matthew 5:24",
      "arabic_page": 33,
      "text": "tinggalkanlah persembahanmu di depan mezbah itu dan pergilah berdamai dahulu dengan",
      "ref_id": "Matius 5:24",
