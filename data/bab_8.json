      "diatessaron_verse": "52",
      "ref": "Matthew 5:22",
      "arabic_page": 33,
      "text": "siapa yang berkata: Jahil! harus diserahkan ke dalam neraka yang menyala-nyala.",
      "ref_id": "Matius 5:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
