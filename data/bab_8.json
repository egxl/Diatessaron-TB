      "diatessaron_verse": "39",
      "ref": "Luke 6:26",
      "arabic_page": 32,
      "text": "Celakalah kamu, jika semua orang memuji kamu; karena secara demikian juga nenek moyang mereka telah memperlakukan nabi-nabi palsu.\"",
      "ref_id": "Lukas 6:26",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 18
    },
    {
