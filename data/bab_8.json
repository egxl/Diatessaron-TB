      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 55,
      "diatessaron_verse": "36",
      "ref": "Matthew 5:12",
      "arabic_page": 32,
      "text": "Bersukacita dan bergembiralah, karena upahmu besar di sorga, sebab demikian juga telah dianiaya nabi-nabi yang sebelum kamu.\"",
      "ref_id": "Matius 5:12",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
    {
      "id": 56,
      "diatessaron_verse": "37",
      "ref": "Luke 6:24",
      "arabic_page": 32,
      "text": "Tetapi celakalah kamu, hai kamu yang kaya, karena dalam kekayaanmu kamu telah memperoleh penghiburanmu.",
