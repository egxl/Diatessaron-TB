      "diatessaron_verse": "43",
      "ref": "Matthew 5:16",
      "arabic_page": 32,
      "text": "Demikianlah hendaknya terangmu bercahaya di depan orang, supaya mereka melihat",
      "ref_id": "Matius 5:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
