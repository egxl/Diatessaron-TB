      "diatessaron_verse": "44",
      "ref": "Matthew 5:16",
      "arabic_page": 32,
      "text": "perbuatanmu yang baik dan memuliakan Bapamu yang di sorga.\"",
      "ref_id": "Matius 5:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 68,
      "diatessaron_verse": "44",
      "ref": "Mark 4:22",
      "arabic_page": 32,
      "text": "Sebab tidak ada sesuatu yang tersembunyi yang tidak akan dinyatakan, dan tidak ada sesuatu yang rahasia yang tidak akan tersingkap.",
      "ref_id": "Markus 4:22",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 20
    },
    {
      "id": 69,
      "diatessaron_verse": "44",
      "ref": "Mark 4:23",
      "arabic_page": 32,
      "text": "Barangsiapa mempunyai telinga untuk mendengar, hendaklah ia mendengar!\"",
      "ref_id": "Markus 4:23",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 8
    },
    {
