      "diatessaron_verse": "47",
      "ref": "Matthew 5:18",
      "arabic_page": 33,
      "text": "Karena Aku berkata kepadamu: Sesungguhnya selama belum lenyap langit dan bumi ini, satu iota atau satu titikpun tidak akan ditiadakan dari hukum Taurat, sebelum",
      "ref_id": "Matius 5:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 24
    },
    {
