    },
    {
      "id": 8,
      "diatessaron_verse": "6",
      "ref": "Matthew 12:19",
      "arabic_page": null,
      "text": "Ia tidak akan berbantah dan tidak akan berteriak dan orang tidak akan mendengar suara-Nya di jalan-jalan.",
