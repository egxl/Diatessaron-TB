      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 57,
      "diatessaron_verse": "38",
      "ref": "Luke 6:25",
      "arabic_page": 32,
      "text": "Celakalah kamu, yang sekarang ini kenyang, karena kamu akan lapar. Celakalah kamu, yang sekarang ini tertawa, karena kamu akan berdukacita dan menangis.",
      "ref_id": "Lukas 6:25",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 22
