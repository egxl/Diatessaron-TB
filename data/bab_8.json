      "diatessaron_verse": "61",
      "ref": "Matthew 5:30",
      "arabic_page": 34,
      "text": "satu dari anggota tubuhmu binasa dari pada tubuhmu dengan utuh masuk neraka.",
      "ref_id": "Matius 5:30",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 98,
      "diatessaron_verse": "61",
      "ref": "Matthew 5:31",
      "arabic_page": 34,
      "text": "Telah difirmankan juga: Siapa yang menceraikan isterinya harus memberi surat cerai kepadanya.",
      "ref_id": "Matius 5:31",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 99,
      "diatessaron_verse": "62",
      "ref": "Matthew 5:32",
      "arabic_page": 34,
      "text": "Tetapi Aku berkata kepadamu: Setiap orang yang menceraikan isterinya kecuali karena zinah, ia menjadikan isterinya berzinah; dan siapa yang kawin dengan perempuan yang diceraikan, ia berbuat zinah.",
      "ref_id": "Matius 5:32",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 27
    }
