      "ref": "Matthew 5:25[a",
      "arabic_page": 33,
      "text": "Segeralah berdamai dengan lawanmu.",
      "ref_id": "Matius 5:25[a",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
