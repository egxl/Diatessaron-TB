      "diatessaron_verse": "56",
      "ref": "Matthew 5:26",
      "arabic_page": 33,
      "text": "Aku berkata kepadamu: Sesungguhnya engkau tidak akan keluar dari sana, sebelum engkau membayar hutangmu sampai lunas.",
      "ref_id": "Matius 5:26",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 91,
      "diatessaron_verse": "57, 58",
      "ref": "Matthew 5:27",
      "arabic_page": 33,
      "text": "Kamu telah mendengar firman: Jangan berzinah.",
      "ref_id": "Matius 5:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 92,
      "diatessaron_verse": "57, 58",
      "ref": "Matthew 5:28",
      "arabic_page": 33,
      "text": "Tetapi Aku berkata kepadamu: Setiap orang yang memandang perempuan serta menginginkannya,",
      "ref_id": "Matius 5:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 93,
      "diatessaron_verse": "59",
      "ref": "Matthew 5:28",
      "arabic_page": 34,
      "text": "sudah berzinah dengan dia di dalam hatinya.",
      "ref_id": "Matius 5:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 94,
      "diatessaron_verse": "59",
      "ref": "Matthew 5:29",
      "arabic_page": 34,
      "text": "Maka jika matamu yang kanan menyesatkan engkau, cungkillah dan buanglah itu, karena lebih baik bagimu jika satu dari",
      "ref_id": "Matius 5:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 18
    },
