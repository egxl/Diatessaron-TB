      "id": 95,
      "diatessaron_verse": "60",
      "ref": "Matthew 5:29",
      "arabic_page": 34,
      "text": "anggota tubuhmu binasa, dari pada tubuhmu dengan utuh dicampakkan ke dalam neraka.",
      "ref_id": "Matius 5:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 96,
      "diatessaron_verse": "60",
      "ref": "Matthew 5:30",
      "arabic_page": 34,
      "text": "Dan jika tanganmu yang kanan menyesatkan engkau, penggallah dan buanglah itu, karena lebih baik bagimu jika",
      "ref_id": "Matius 5:30",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
