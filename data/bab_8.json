      "diatessaron_verse": "40",
      "ref": "Luke 6:27[a",
      "arabic_page": 32,
      "text": "Tetapi kepada kamu, yang mendengarkan Aku, Aku berkata:",
      "ref_id": "Lukas 6:27[a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 60,
      "diatessaron_verse": "40",
      "ref": "Matthew 5:13",
      "arabic_page": 32,
      "text": "\"Kamu adalah garam dunia. Jika garam itu menjadi tawar, dengan apakah ia diasinkan? Tidak ada lagi gunanya",
      "ref_id": "Matius 5:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
    {
      "id": 61,
      "diatessaron_verse": "41",
      "ref": "Matthew 5:13",
      "arabic_page": 32,
      "text": "selain dibuang dan diinjak orang.",
      "ref_id": "Matius 5:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 62,
      "diatessaron_verse": "41",
      "ref": "Matthew 5:14",
      "arabic_page": 32,
      "text": "Kamu adalah terang dunia.",
      "ref_id": "Matius 5:14",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 63,
      "diatessaron_verse": "42",
      "ref": "Matthew 5:14",
      "arabic_page": 32,
      "text": "Kota yang terletak di atas gunung tidak mungkin tersembunyi.",
      "ref_id": "Matius 5:14",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 64,
      "diatessaron_verse": "42",
      "ref": "Matthew 5:15",
      "arabic_page": 32,
      "text": "Lagipula orang tidak menyalakan pelita lalu meletakkannya di bawah gantang, melainkan di atas kaki dian sehingga menerangi",
      "ref_id": "Matius 5:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
