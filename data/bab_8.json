      "diatessaron_verse": "51",
      "ref": "Matthew 5:22",
      "arabic_page": 33,
      "text": "Tetapi Aku berkata kepadamu: Setiap orang yang marah terhadap saudaranya harus dihukum; siapa yang berkata kepada saudaranya: Kafir! harus dihadapkan ke Mahkamah Agama dan",
      "ref_id": "Matius 5:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 24
    },
