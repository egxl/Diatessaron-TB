      "diatessaron_verse": "48",
      "ref": "Matthew 5:18",
      "arabic_page": 33,
      "text": "semuanya terjadi.",
      "ref_id": "Matius 5:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 74,
      "diatessaron_verse": "48",
      "ref": "Matthew 5:19",
      "arabic_page": 33,
      "text": "Karena itu siapa yang meniadakan salah satu perintah hukum Taurat sekalipun yang paling kecil, dan mengajarkannya demikian kepada orang lain, ia akan menduduki tempat yang paling rendah di dalam Kerajaan Sorga; tetapi siapa yang melakukan dan mengajarkan segala perintah-perintah hukum Taurat, ia akan menduduki tempat yang tinggi di dalam",
      "ref_id": "Matius 5:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 49
    },
    {
      "id": 75,
      "diatessaron_verse": "49",
      "ref": "Matthew 5:19",
      "arabic_page": 33,
      "text": "Kerajaan Sorga.",
      "ref_id": "Matius 5:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
