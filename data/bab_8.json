      "ref": "Matthew 5:23",
      "arabic_page": 33,
      "text": "Sebab itu, jika engkau mempersembahkan persembahanmu di atas mezbah dan engkau teringat akan sesuatu yang ada dalam",
      "ref_id": "Matius 5:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
