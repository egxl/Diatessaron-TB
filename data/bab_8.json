      "diatessaron_verse": "46",
      "ref": "Matthew 5:17",
      "arabic_page": 32,
      "text": "\"Janganlah kamu menyangka, bahwa Aku datang untuk meniadakan hukum Taurat atau kitab para nabi. Aku datang bukan untuk meniadakannya,",
      "ref_id": "Matius 5:17",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
