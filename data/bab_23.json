      "diatessaron_verse": "43",
      "ref": "Matthew 16:22",
      "arabic_page": 91,
      "text": "katanya: \"Tuhan, kiranya Allah menjauhkan hal itu! Hal itu sekali-kali takkan menimpa Engkau.\"",
      "ref_id": "Matius 16:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
