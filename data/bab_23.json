      "diatessaron_verse": "48",
      "ref": "Mark 8:37",
      "arabic_page": 91,
      "text": "Karena apakah",
      "ref_id": "Markus 8:37",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
