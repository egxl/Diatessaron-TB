      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 60,
      "diatessaron_verse": "33",
      "ref": "Matthew 16:14",
      "arabic_page": 90,
      "text": "Jawab mereka: \"Ada yang mengatakan: Yohanes Pembaptis, ada juga yang mengatakan: Elia dan ada pula yang mengatakan: Yeremia atau salah seorang dari",
      "ref_id": "Matius 16:14",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 22
    },
