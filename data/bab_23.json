      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 63,
      "diatessaron_verse": "35",
      "ref": "Matthew 16:16",
      "arabic_page": 90,
      "text": "Maka jawab Simon Petrus:",
      "ref_id": "Matius 16:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 64,
      "diatessaron_verse": "36",
      "ref": "Matthew 16:16",
      "arabic_page": 91,
      "text": "\"Engkau adalah Mesias, Anak Allah yang hidup!\"",
