      "ref": "Mark 8:35",
      "arabic_page": 91,
      "text": "; tetapi barangsiapa kehilangan nyawanya karena Aku dan karena Injil, ia akan menyelamatkannya.",
      "ref_id": "Markus 8:35",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 13
    },
    {
