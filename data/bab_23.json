      "diatessaron_verse": "36",
      "ref": "Matthew 16:17",
      "arabic_page": 91,
      "text": "Kata Yesus kepadanya: \"Berbahagialah engkau Simon bin Yunus sebab",
      "ref_id": "Matius 16:17",
