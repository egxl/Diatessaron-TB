      "diatessaron_verse": "41",
      "ref": "Mark 8:31b",
      "arabic_page": 91,
      "text": "bahwa Anak Manusia harus menanggung banyak penderitaan dan ditolak oleh tua-tua, imam-imam kepala dan ahli-ahli Taurat, lalu dibunuh",
      "ref_id": "Markus 8:31b",
      "book_code": "mrk",
