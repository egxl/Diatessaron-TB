      "diatessaron_verse": "38",
      "ref": "Matthew 16:18",
      "arabic_page": 91,
      "text": "dan alam maut tidak akan menguasainya.",
      "ref_id": "Matius 16:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 69,
      "diatessaron_verse": "38",
      "ref": "Matthew 16:19",
      "arabic_page": 91,
      "text": "Kepadamu akan Kuberikan kunci Kerajaan Sorga. Apa yang kauikat di dunia ini akan terikat di sorga dan",
      "ref_id": "Matius 16:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
