      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 62,
      "diatessaron_verse": "35",
      "ref": "Matthew 16:15",
      "arabic_page": 90,
      "text": "Lalu Yesus bertanya kepada mereka: \"Tetapi apa katamu, siapakah Aku ini?\"",
