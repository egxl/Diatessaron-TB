      "book_id": "Markus",
      "word_count": 4
    },
    {
      "id": 82,
      "diatessaron_verse": "44",
      "ref": "Matthew 16:23b",
      "arabic_page": 91,
      "text": "\"Enyahlah Iblis. Engkau suatu batu sandungan bagi-Ku, sebab engkau bukan memikirkan apa yang dipikirkan Allah, melainkan apa yang dipikirkan manusia.\"",
