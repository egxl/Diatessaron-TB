      "diatessaron_verse": "2",
      "ref": "Matthew 15:29",
      "arabic_page": null,
      "text": "naik ke atas bukit lalu duduk di situ.",
      "ref_id": "Matius 15:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Matthew 15:30a",
      "arabic_page": null,
      "text": "Kemudian orang banyak berbondong-bondong datang kepada-Nya membawa orang lumpuh, orang timpang, orang buta, orang bisu dan banyak lagi yang lain,",
      "ref_id": "Matius 15:30a",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 20
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Matthew 15:30a",
      "arabic_page": null,
      "text": "lalu meletakkan mereka pada kaki Yesus.",
      "ref_id": "Matius 15:30a",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "John 4:45b",
      "arabic_page": null,
      "text": "karena mereka telah melihat segala sesuatu yang dikerjakan-Nya di",
      "ref_id": "Yohanes 4:45b",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 9
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "John 4:45b",
      "arabic_page": null,
      "text": "Yerusalem pada pesta itu, sebab mereka sendiripun turut ke pesta itu.",
      "ref_id": "Yohanes 4:45b",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 11
    },
    {
      "id": 7,
      "diatessaron_verse": "4",
      "ref": "Matthew 15:30b",
      "arabic_page": null,
      "text": "dan Ia menyembuhkan mereka semuanya.",
      "ref_id": "Matius 15:30b",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 8,
      "diatessaron_verse": "4",
      "ref": "Matthew 15:31",
      "arabic_page": null,
      "text": "Maka takjublah orang banyak itu melihat orang bisu berkata-kata, orang timpang sembuh, orang lumpuh berjalan, orang buta melihat, dan mereka memuliakan Allah Israel.",
      "ref_id": "Matius 15:31",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 23
    },
    {
      "id": 9,
      "diatessaron_verse": "5",
      "ref": "Matthew 15:32",
      "arabic_page": null,
      "text": "Lalu Yesus memanggil murid-murid-Nya dan berkata: \"Hati-Ku tergerak oleh belas kasihan kepada orang banyak itu. Sudah tiga hari mereka mengikuti Aku dan mereka tidak mempunyai makanan. Aku tidak mau menyuruh mereka pulang dengan lapar, nanti mereka pingsan di jalan.\"",
      "ref_id": "Matius 15:32",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 39
    },
    {
      "id": 10,
      "diatessaron_verse": "5",
      "ref": "Mark 8:3b",
      "arabic_page": null,
      "text": "sebab ada yang datang dari jauh.\"",
      "ref_id": "Markus 8:3b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 6
    },
    {
      "id": 11,
      "diatessaron_verse": "6",
      "ref": "Mark 8:3b",
      "arabic_page": 89,
      "text": "datang dari jauh.\"",
      "ref_id": "Markus 8:3b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 3
    },
    {
      "id": 12,
      "diatessaron_verse": "6",
      "ref": "Matthew 15:33",
      "arabic_page": 89,
      "text": "Kata murid-murid-Nya kepada-Nya: \"Bagaimana di tempat sunyi ini kita mendapat",
      "ref_id": "Matius 15:33",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 13,
      "diatessaron_verse": "7",
      "ref": "Matthew 15:33",
      "arabic_page": 89,
      "text": "roti untuk mengenyangkan orang banyak yang begitu besar jumlahnya?\"",
      "ref_id": "Matius 15:33",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 14,
      "diatessaron_verse": "7",
      "ref": "Matthew 15:34",
      "arabic_page": 89,
      "text": "Kata Yesus kepada mereka: \"",
      "ref_id": "Matius 15:34",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 15,
      "diatessaron_verse": "8",
      "ref": "Matthew 15:34",
      "arabic_page": 89,
      "text": "Berapa roti ada padamu?\" \"Tujuh,\" jawab mereka, \"dan ada lagi beberapa ikan kecil.\"",
      "ref_id": "Matius 15:34",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 16,
      "diatessaron_verse": "8",
      "ref": "Matthew 15:35",
      "arabic_page": 89,
      "text": "Lalu Yesus",
      "ref_id": "Matius 15:35",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 17,
      "diatessaron_verse": "9",
      "ref": "Matthew 15:35",
      "arabic_page": 89,
      "text": "menyuruh orang banyak itu duduk di tanah.",
      "ref_id": "Matius 15:35",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 18,
      "diatessaron_verse": "9",
      "ref": "Matthew 15:36",
      "arabic_page": 89,
      "text": "Sesudah itu Ia mengambil ketujuh roti dan ikan-ikan itu, mengucap syukur, memecah-mecahkannya dan memberikannya kepada murid-murid-Nya,",
      "ref_id": "Matius 15:36",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 19,
      "diatessaron_verse": "10",
      "ref": "Matthew 15:36",
      "arabic_page": 89,
      "text": "lalu murid-murid-Nya memberikannya pula kepada orang banyak.",
      "ref_id": "Matius 15:36",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 20,
      "diatessaron_verse": "10",
      "ref": "Matthew 15:37",
      "arabic_page": 89,
      "text": "Dan mereka semuanya makan sampai kenyang. Kemudian orang mengumpulkan potongan-potongan roti yang sisa, tujuh bakul penuh.",
      "ref_id": "Matius 15:37",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 21,
      "diatessaron_verse": "11",
      "ref": "Matthew 15:38",
      "arabic_page": 89,
      "text": "Yang ikut makan ialah empat ribu laki-laki, tidak termasuk perempuan dan anak-anak.",
      "ref_id": "Matius 15:38",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 22,
      "diatessaron_verse": "12",
      "ref": "Matthew 15:39",
      "arabic_page": 89,
      "text": "Lalu Yesus menyuruh orang banyak itu pulang. Ia naik perahu dan bertolak ke daerah Magadan.",
      "ref_id": "Matius 15:39",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 23,
      "diatessaron_verse": "13",
      "ref": "Mark 8:11",
      "arabic_page": 89,
      "text": "Lalu muncullah orang-orang Farisi dan bersoal jawab dengan Yesus. Untuk mencobai Dia mereka meminta dari pada-Nya suatu tanda dari sorga.",
      "ref_id": "Markus 8:11",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 20
    },
    {
      "id": 24,
      "diatessaron_verse": "14",
      "ref": "Mark 8:12",
      "arabic_page": 89,
      "text": "Maka mengeluhlah Ia dalam hati-Nya dan berkata: \"Mengapa angkatan ini meminta tanda?",
      "ref_id": "Markus 8:12",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 12
    },
    {
      "id": 25,
      "diatessaron_verse": "14",
      "ref": "Luke 11:29",
      "arabic_page": 89,
      "text": "Mereka menghendaki suatu tanda, tetapi kepada mereka tidak akan diberikan tanda selain",
      "ref_id": "Lukas 11:29",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 26,
      "diatessaron_verse": "15",
      "ref": "Luke 11:29",
      "arabic_page": 89,
      "text": "tanda nabi Yunus.",
      "ref_id": "Lukas 11:29",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 27,
      "diatessaron_verse": "15",
      "ref": "Mark 8:12b",
      "arabic_page": 89,
      "text": "Aku berkata kepadamu, sesungguhnya kepada angkatan ini sekali-kali tidak akan diberi",
      "ref_id": "Markus 8:12b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 28,
      "diatessaron_verse": "16",
      "ref": "Mark 8:12b",
      "arabic_page": 89,
      "text": "tanda.\"",
      "ref_id": "Markus 8:12b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 1
    },
    {
      "id": 29,
      "diatessaron_verse": "16",
      "ref": "Mark 8:13",
      "arabic_page": 89,
      "text": "Ia meninggalkan mereka; Ia naik pula ke perahu dan bertolak ke seberang.",
      "ref_id": "Markus 8:13",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 12
    },
    {
      "id": 30,
      "diatessaron_verse": "17",
      "ref": "Mark 8:14",
      "arabic_page": 89,
      "text": "Kemudian ternyata murid-murid Yesus lupa membawa roti,",
      "ref_id": "Markus 8:14",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 7
    },
    {
      "id": 31,
      "diatessaron_verse": "18",
      "ref": "Mark 8:14",
      "arabic_page": 89,
      "text": "hanya sebuah saja yang ada pada mereka dalam perahu.",
      "ref_id": "Markus 8:14",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 9
    },
    {
      "id": 32,
      "diatessaron_verse": "18",
      "ref": "Mark 8:15a",
      "arabic_page": 89,
      "text": "Lalu Yesus memperingatkan mereka, kata-Nya:",
      "ref_id": "Markus 8:15a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 5
    },
    {
      "id": 33,
      "diatessaron_verse": "18",
      "ref": "Matthew 16:6b",
      "arabic_page": 89,
      "text": "\"Berjaga-jagalah dan awaslah terhadap ragi orang Farisi dan dan Saduki.\"",
      "ref_id": "Matius 16:6b",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 34,
      "diatessaron_verse": "19",
      "ref": "Matthew 16:6b",
      "arabic_page": 89,
      "text": "dan ragi Herodes.\"",
      "ref_id": "Matius 16:6b",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 35,
      "diatessaron_verse": "19",
      "ref": "Matthew 16:7",
      "arabic_page": 89,
      "text": "Maka mereka berpikir-pikir dan seorang berkata kepada yang lain: \"Itu dikatakan-Nya karena kita",
      "ref_id": "Matius 16:7",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 36,
      "diatessaron_verse": "20",
      "ref": "Matthew 16:7",
      "arabic_page": 89,
      "text": "tidak membawa roti.\"",
      "ref_id": "Matius 16:7",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 37,
      "diatessaron_verse": "20",
      "ref": "Matthew 16:8",
      "arabic_page": 89,
      "text": "Dan ketika Yesus mengetahui apa yang mereka perbincangkan, Ia berkata: \"Mengapa kamu memperbincangkan soal tidak ada roti? Hai orang-orang yang kurang percaya!",
      "ref_id": "Matius 16:8",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 22
    },
    {
      "id": 38,
      "diatessaron_verse": "20",
      "ref": "Mark 8:17b",
      "arabic_page": 89,
      "text": "Belum jugakah kamu faham dan mengerti? Telah degilkah hatimu?",
      "ref_id": "Markus 8:17b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 9
    },
    {
      "id": 39,
      "diatessaron_verse": "20",
      "ref": "Mark 8:18",
      "arabic_page": 89,
      "text": "Kamu mempunyai mata, tidakkah kamu melihat",
      "ref_id": "Markus 8:18",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 6
    },
    {
      "id": 40,
      "diatessaron_verse": "22",
      "ref": "Mark 8:18",
      "arabic_page": 90,
      "text": "dan kamu mempunyai telinga, tidakkah kamu mendengar? Tidakkah kamu ingat lagi,",
      "ref_id": "Markus 8:18",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 41,
      "diatessaron_verse": "22",
      "ref": "Mark 8:19",
      "arabic_page": 90,
      "text": "pada waktu Aku memecah-mecahkan lima roti untuk lima ribu orang itu, berapa",
      "ref_id": "Markus 8:19",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 12
    },
    {
      "id": 42,
      "diatessaron_verse": "23",
      "ref": "Mark 8:19",
      "arabic_page": 90,
      "text": "bakul penuh potongan-potongan roti kamu kumpulkan?\" Jawab mereka: \"Dua belas bakul.\"",
      "ref_id": "Markus 8:19",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 43,
      "diatessaron_verse": "23",
      "ref": "Mark 8:20",
      "arabic_page": 90,
      "text": "\"Dan pada waktu tujuh roti untuk empat ribu orang itu, berapa bakul penuh potongan-potongan roti kamu kumpulkan?\"",
      "ref_id": "Markus 8:20",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 17
    },
    {
      "id": 44,
      "diatessaron_verse": "24",
      "ref": "Mark 8:20",
      "arabic_page": 90,
      "text": "Jawab mereka: \"Tujuh bakul.\"",
      "ref_id": "Markus 8:20",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 4
    },
    {
      "id": 45,
      "diatessaron_verse": "24",
      "ref": "Matthew 16:11",
      "arabic_page": 90,
      "text": "Bagaimana mungkin kamu tidak mengerti bahwa bukan roti yang Kumaksudkan. Aku berkata kepadamu: Waspadalah terhadap ragi orang Farisi",
      "ref_id": "Matius 16:11",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 18
    },
    {
      "id": 46,
      "diatessaron_verse": "25",
      "ref": "Matthew 16:11",
      "arabic_page": 90,
      "text": "dan Saduki.\"",
      "ref_id": "Matius 16:11",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 47,
      "diatessaron_verse": "25",
      "ref": "Matthew 16:12",
      "arabic_page": 90,
      "text": "Ketika itu barulah mereka mengerti bahwa bukan maksud-Nya supaya mereka waspada terhadap ragi roti, melainkan terhadap ajaran orang Farisi dan Saduki.",
      "ref_id": "Matius 16:12",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 21
    },
    {
      "id": 48,
      "diatessaron_verse": "26",
      "ref": "Mark 8:22",
      "arabic_page": 90,
      "text": "Kemudian tibalah Yesus dan murid-murid-Nya di Betsaida. Di situ orang membawa kepada Yesus seorang buta",
      "ref_id": "Markus 8:22",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 15
    },
    {
      "id": 49,
      "diatessaron_verse": "27",
      "ref": "Mark 8:22",
      "arabic_page": 90,
      "text": "dan mereka memohon kepada-Nya, supaya Ia menjamah dia.",
      "ref_id": "Markus 8:22",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 8
    },
    {
      "id": 50,
      "diatessaron_verse": "27",
      "ref": "Mark 8:23",
      "arabic_page": 90,
      "text": "Yesus memegang tangan orang buta itu dan membawa dia ke luar kampung. Lalu Ia meludahi mata orang itu dan",
      "ref_id": "Markus 8:23",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 19
    },
    {
      "id": 51,
      "diatessaron_verse": "28",
      "ref": "Mark 8:23",
      "arabic_page": 90,
      "text": "meletakkan tangan-Nya atasnya, dan bertanya: \"Sudahkah kaulihat sesuatu?\"",
      "ref_id": "Markus 8:23",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 8
    },
    {
      "id": 52,
      "diatessaron_verse": "28",
      "ref": "Mark 8:24",
      "arabic_page": 90,
      "text": "Orang itu memandang ke depan,",
      "ref_id": "Markus 8:24",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 5
    },
    {
      "id": 53,
      "diatessaron_verse": "29",
      "ref": "Mark 8:24",
      "arabic_page": 90,
      "text": "lalu berkata: \"Aku melihat orang, sebab melihat mereka berjalan-jalan, tetapi tampaknya seperti pohon-pohon.\"",
      "ref_id": "Markus 8:24",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 13
    },
    {
      "id": 54,
      "diatessaron_verse": "29",
      "ref": "Mark 8:25",
      "arabic_page": 90,
      "text": "Yesus meletakkan lagi tangan-Nya pada mata orang itu,",
      "ref_id": "Markus 8:25",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 8
    },
    {
      "id": 55,
      "diatessaron_verse": "30",
      "ref": "Mark 8:25",
      "arabic_page": 90,
      "text": "maka orang itu sungguh-sungguh melihat dan telah sembuh, sehingga ia dapat melihat segala sesuatu dengan jelas.",
      "ref_id": "Markus 8:25",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 16
    },
    {
      "id": 56,
      "diatessaron_verse": "30",
      "ref": "Mark 8:26",
      "arabic_page": 90,
      "text": "Sesudah itu Yesus menyuruh dia pulang ke rumahnya dan berkata: \"Jangan masuk ke kampung!\"",
      "ref_id": "Markus 8:26",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 14
    },
