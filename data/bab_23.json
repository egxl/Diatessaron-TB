      "diatessaron_verse": "39",
      "ref": "Matthew 16:19",
      "arabic_page": 91,
      "text": "apa yang kaulepaskan di dunia ini akan terlepas di sorga.\"",
      "ref_id": "Matius 16:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 71,
      "diatessaron_verse": "39",
      "ref": "Matthew 16:20",
      "arabic_page": 91,
      "text": "Lalu Yesus melarang murid-murid-Nya supaya jangan memberitahukan kepada siapapun",
      "ref_id": "Matius 16:20",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
