    },
    {
      "id": 2,
      "diatessaron_verse": "1, 2",
      "ref": "Matthew 2:2",
      "arabic_page": null,
      "text": "dan bertanya-tanya: \"Di manakah Dia, raja orang Yahudi yang baru dilahirkan itu? Kami telah melihat bintang-Nya di Timur dan kami datang",
      "ref_id": "Matius 2:2",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
