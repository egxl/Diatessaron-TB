      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 48,
      "diatessaron_verse": "31",
      "ref": "Luke 2:47",
      "arabic_page": 12,
      "text": "Dan semua orang yang mendengar Dia sangat heran akan",
      "ref_id": "Lukas 2:47",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 49,
      "diatessaron_verse": "32",
      "ref": "Luke 2:47",
      "arabic_page": 12,
      "text": "kecerdasan-Nya dan segala jawab yang diberikan-Nya.",
      "ref_id": "Lukas 2:47",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
