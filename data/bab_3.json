    },
    {
      "id": 3,
      "diatessaron_verse": "3",
      "ref": "Matthew 2:2",
      "arabic_page": null,
      "text": "untuk menyembah Dia.\"",
      "ref_id": "Matius 2:2",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Matthew 2:3",
      "arabic_page": null,
      "text": "Ketika raja Herodes mendengar hal itu terkejutlah ia beserta seluruh",
      "ref_id": "Matius 2:3",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 5,
      "diatessaron_verse": "4",
      "ref": "Matthew 2:3",
      "arabic_page": null,
      "text": "Yerusalem.",
      "ref_id": "Matius 2:3",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 1
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Matthew 2:4",
      "arabic_page": null,
      "text": "Maka dikumpulkannya semua imam kepala dan ahli Taurat",
      "ref_id": "Matius 2:4",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "Matthew 2:4",
      "arabic_page": null,
      "text": "bangsa Yahudi, lalu dimintanya keterangan dari mereka, di mana Mesias akan dilahirkan.",
      "ref_id": "Matius 2:4",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Matthew 2:5",
      "arabic_page": null,
      "text": "Mereka berkata kepadanya: \"Di Betlehem di tanah Yudea, karena demikianlah ada tertulis dalam kitab nabi:",
      "ref_id": "Matius 2:5",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 9,
      "diatessaron_verse": "6",
      "ref": "Matthew 2:6",
      "arabic_page": null,
      "text": "Dan engkau Betlehem, tanah Yehuda, engkau sekali-kali bukanlah yang terkecil di antara mereka yang memerintah Yehuda, karena dari padamulah akan bangkit seorang pemimpin, yang akan menggembalakan umat-Ku Israel.\"",
      "ref_id": "Matius 2:6",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 28
    },
    {
      "id": 10,
      "diatessaron_verse": "7",
      "ref": "Matthew 2:7",
      "arabic_page": null,
      "text": "Lalu dengan diam-diam Herodes memanggil orang-orang majus itu dan dengan teliti bertanya kepada mereka, bilamana",
      "ref_id": "Matius 2:7",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 11,
      "diatessaron_verse": "8",
      "ref": "Matthew 2:7",
      "arabic_page": null,
      "text": "bintang itu nampak.",
      "ref_id": "Matius 2:7",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 12,
      "diatessaron_verse": "8",
      "ref": "Matthew 2:8",
      "arabic_page": null,
      "text": "Kemudian ia menyuruh mereka ke Betlehem, katanya: \"Pergi dan selidikilah dengan seksama hal-hal mengenai Anak itu dan segera sesudah kamu menemukan Dia,",
      "ref_id": "Matius 2:8",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 22
    },
    {
      "id": 13,
      "diatessaron_verse": "9",
      "ref": "Matthew 2:8",
      "arabic_page": null,
      "text": "kabarkanlah kepadaku supaya akupun datang menyembah Dia.\"",
      "ref_id": "Matius 2:8",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 14,
      "diatessaron_verse": "9",
      "ref": "Matthew 2:9",
      "arabic_page": 11,
      "text": "Setelah mendengar kata-kata raja itu, berangkatlah mereka. Dan lihatlah, bintang yang mereka lihat di Timur itu mendahului mereka hingga tiba dan berhenti di atas tempat, di mana Anak itu",
      "ref_id": "Matius 2:9",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 29
    },
    {
      "id": 15,
      "diatessaron_verse": "10, 11",
      "ref": "Matthew 2:9",
      "arabic_page": 11,
      "text": "berada.",
      "ref_id": "Matius 2:9",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 1
    },
    {
      "id": 16,
      "diatessaron_verse": "10, 11",
      "ref": "Matthew 2:10",
      "arabic_page": 11,
      "text": "Ketika mereka melihat bintang itu, sangat bersukacitalah mereka.",
      "ref_id": "Matius 2:10",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 17,
      "diatessaron_verse": "10, 11",
      "ref": "Matthew 2:11",
      "arabic_page": 11,
      "text": "Maka masuklah mereka ke dalam rumah itu dan melihat Anak itu bersama Maria, ibu-Nya, lalu sujud menyembah Dia. Merekapun membuka tempat harta bendanya dan mempersembahkan persembahan kepada-Nya, yaitu emas,",
      "ref_id": "Matius 2:11",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 29
    },
    {
      "id": 18,
      "diatessaron_verse": "12",
      "ref": "Matthew 2:11",
      "arabic_page": 11,
      "text": "kemenyan dan mur.",
      "ref_id": "Matius 2:11",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 19,
      "diatessaron_verse": "12",
      "ref": "Matthew 2:12",
      "arabic_page": 11,
      "text": "Dan karena diperingatkan dalam mimpi, supaya jangan kembali kepada Herodes, maka pulanglah mereka ke negerinya melalui jalan lain.",
      "ref_id": "Matius 2:12",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 18
    },
    {
      "id": 20,
      "diatessaron_verse": "13",
      "ref": "Matthew 2:13",
      "arabic_page": 11,
      "text": "Setelah orang-orang majus itu berangkat, nampaklah malaikat Tuhan kepada Yusuf dalam mimpi dan berkata: \"Bangunlah, ambillah Anak itu serta ibu-Nya, larilah ke Mesir dan tinggallah di sana sampai Aku berfirman kepadamu, karena Herodes akan mencari Anak itu",
      "ref_id": "Matius 2:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 37
    },
    {
      "id": 21,
      "diatessaron_verse": "14",
      "ref": "Matthew 2:13",
      "arabic_page": 11,
      "text": "untuk membunuh Dia.\".",
      "ref_id": "Matius 2:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 22,
      "diatessaron_verse": "14",
      "ref": "Matthew 2:14",
      "arabic_page": 11,
      "text": "Maka Yusufpun bangunlah, diambilnya Anak itu serta ibu-Nya malam itu juga, lalu",
      "ref_id": "Matius 2:14",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 23,
      "diatessaron_verse": "15",
      "ref": "Matthew 2:14",
      "arabic_page": 11,
      "text": "menyingkir ke Mesir,",
      "ref_id": "Matius 2:14",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 24,
      "diatessaron_verse": "15",
      "ref": "Matthew 2:15",
      "arabic_page": 11,
      "text": "dan tinggal di sana hingga Herodes mati. Hal itu terjadi supaya genaplah yang difirmankan Tuhan oleh nabi: \"Dari",
      "ref_id": "Matius 2:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 18
    },
    {
      "id": 25,
      "diatessaron_verse": "16",
      "ref": "Matthew 2:15",
      "arabic_page": 11,
      "text": "Mesir Kupanggil Anak-Ku.\"",
      "ref_id": "Matius 2:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 26,
      "diatessaron_verse": "16",
      "ref": "Matthew 2:16",
      "arabic_page": 11,
      "text": "Ketika Herodes tahu, bahwa ia telah diperdayakan oleh orang-orang majus itu, ia sangat marah. Lalu ia menyuruh membunuh semua anak di Betlehem dan sekitarnya, yaitu anak-anak yang berumur dua tahun ke bawah, sesuai dengan waktu",
      "ref_id": "Matius 2:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 35
    },
    {
      "id": 27,
      "diatessaron_verse": "17",
      "ref": "Matthew 2:16",
      "arabic_page": 11,
      "text": "yang dapat diketahuinya dari orang-orang majus itu.",
      "ref_id": "Matius 2:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 28,
      "diatessaron_verse": "17",
      "ref": "Matthew 2:17",
      "arabic_page": 11,
      "text": "Dengan demikian genaplah firman yang disampaikan oleh nabi Yeremia:",
      "ref_id": "Matius 2:17",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 29,
      "diatessaron_verse": "18",
      "ref": "Matthew 2:18",
      "arabic_page": 11,
      "text": "\"Terdengarlah suara di Rama, tangis dan ratap yang amat sedih; Rahel menangisi anak-anaknya dan ia tidak mau dihibur, sebab mereka tidak ada lagi.\"",
      "ref_id": "Matius 2:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 23
    },
    {
      "id": 30,
      "diatessaron_verse": "19",
      "ref": "Matthew 2:19",
      "arabic_page": 11,
      "text": "Setelah Herodes mati, nampaklah malaikat Tuhan kepada",
      "ref_id": "Matius 2:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 31,
      "diatessaron_verse": "20",
      "ref": "Matthew 2:19",
      "arabic_page": 11,
      "text": "Yusuf dalam mimpi di Mesir, katanya:",
      "ref_id": "Matius 2:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 32,
      "diatessaron_verse": "20",
      "ref": "Matthew 2:20",
      "arabic_page": 12,
      "text": "\"Bangunlah, ambillah Anak itu serta ibu-Nya dan berangkatlah ke tanah Israel, karena mereka yang hendak membunuh Anak itu, sudah mati.\"",
      "ref_id": "Matius 2:20",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 20
    },
    {
      "id": 33,
      "diatessaron_verse": "21",
      "ref": "Matthew 2:21",
      "arabic_page": 12,
      "text": "Lalu Yusufpun bangunlah, diambilnya Anak itu serta ibu-Nya dan pergi ke tanah",
      "ref_id": "Matius 2:21",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 34,
      "diatessaron_verse": "22",
      "ref": "Matthew 2:21",
      "arabic_page": 12,
      "text": "Israel.",
      "ref_id": "Matius 2:21",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 1
    },
    {
      "id": 35,
      "diatessaron_verse": "22",
      "ref": "Matthew 2:22",
      "arabic_page": 12,
      "text": "Tetapi setelah didengarnya, bahwa Arkhelaus menjadi raja di Yudea menggantikan Herodes, ayahnya, ia takut ke sana. Karena dinasihati dalam mimpi,",
      "ref_id": "Matius 2:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 20
    },
    {
      "id": 36,
      "diatessaron_verse": "23",
      "ref": "Matthew 2:22",
      "arabic_page": 12,
      "text": "pergilah Yusuf ke daerah Galilea.",
      "ref_id": "Matius 2:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 37,
      "diatessaron_verse": "23",
      "ref": "Matthew 2:23",
      "arabic_page": 12,
      "text": "Setibanya di sana iapun tinggal di sebuah kota yang bernama Nazaret. Hal itu terjadi supaya genaplah firman yang disampaikan oleh nabi-nabi, bahwa Ia akan disebut: Orang Nazaret.",
      "ref_id": "Matius 2:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 27
    },
    {
      "id": 38,
      "diatessaron_verse": "24",
      "ref": "Luke 2:40",
      "arabic_page": 12,
      "text": "Anak itu bertambah besar dan menjadi kuat, penuh hikmat, dan kasih karunia Allah ada pada-Nya.",
      "ref_id": "Lukas 2:40",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 15
    },
    {
      "id": 39,
      "diatessaron_verse": "25",
      "ref": "Luke 2:41",
      "arabic_page": 12,
      "text": "Tiap-tiap tahun orang tua Yesus pergi ke Yerusalem pada hari raya Paskah.",
      "ref_id": "Lukas 2:41",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 40,
      "diatessaron_verse": "26",
      "ref": "Luke 2:42",
      "arabic_page": 12,
      "text": "Ketika Yesus telah berumur dua belas tahun pergilah mereka ke Yerusalem seperti yang lazim",
      "ref_id": "Lukas 2:42",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 41,
      "diatessaron_verse": "27",
      "ref": "Luke 2:42",
      "arabic_page": 12,
      "text": "pada hari raya itu.",
      "ref_id": "Lukas 2:42",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 42,
      "diatessaron_verse": "27",
      "ref": "Luke 2:43",
      "arabic_page": 12,
      "text": "Sehabis hari-hari perayaan itu, ketika mereka berjalan pulang,",
      "ref_id": "Lukas 2:43",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 43,
      "diatessaron_verse": "28",
      "ref": "Luke 2:43",
      "arabic_page": 12,
      "text": "tinggallah Yesus di Yerusalem tanpa diketahui orang tua-Nya.",
      "ref_id": "Lukas 2:43",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 44,
      "diatessaron_verse": "28",
      "ref": "Luke 2:44",
      "arabic_page": 12,
      "text": "Karena mereka menyangka bahwa Ia ada di antara orang-orang seperjalanan mereka, berjalanlah mereka sehari perjalanan jauhnya, lalu mencari Dia di antara kaum keluarga dan kenalan mereka.",
      "ref_id": "Lukas 2:44",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 26
    },
    {
      "id": 45,
      "diatessaron_verse": "29",
      "ref": "Luke 2:45",
      "arabic_page": 12,
      "text": "Karena mereka tidak menemukan Dia, kembalilah mereka ke Yerusalem sambil terus mencari Dia.",
      "ref_id": "Lukas 2:45",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 46,
      "diatessaron_verse": "30",
      "ref": "Luke 2:46",
      "arabic_page": 12,
      "text": "Sesudah tiga hari mereka menemukan Dia dalam Bait Allah; Ia sedang duduk di tengah-tengah alim ulama,",
      "ref_id": "Lukas 2:46",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 16
    },
    {
      "id": 47,
      "diatessaron_verse": "31",
      "ref": "Luke 2:46",
      "arabic_page": 12,
      "text": "sambil mendengarkan mereka dan mengajukan pertanyaan-pertanyaan kepada mereka.",
