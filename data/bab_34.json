      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 1
    },
    {
      "id": 50,
      "diatessaron_verse": "29, 30",
      "ref": "Matthew 22:38",
      "arabic_page": 130,
      "text": "Itulah hukum yang terutama dan yang pertama.",
