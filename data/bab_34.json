      "diatessaron_verse": "14, 15",
      "ref": "Matthew 22:27",
      "arabic_page": 129,
      "text": "Dan akhirnya, sesudah mereka semua, perempuan itupun mati.",
      "ref_id": "Matius 22:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
