      "diatessaron_verse": "28",
      "ref": "Mark 12:29",
      "arabic_page": 130,
      "text": "Israel, Tuhan Allah kita, Tuhan itu esa. [Mark 12:30] Kasihilah Tuhan, Allahmu, dengan segenap hatimu dan dengan segenap jiwamu dan dengan segenap akal budimu dan dengan segenap",
      "ref_id": "Markus 12:29",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
