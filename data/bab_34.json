      "diatessaron_verse": "31",
      "ref": "Mark 12:31",
      "arabic_page": 130,
      "text": "lebih utama dari pada kedua hukum ini.\"",
      "ref_id": "Markus 12:31",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 7
    },
