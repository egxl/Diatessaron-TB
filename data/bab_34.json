      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 28,
      "diatessaron_verse": "17",
      "ref": "Matthew 22:29",
      "arabic_page": 129,
      "text": "sebab kamu tidak mengerti Kitab Suci maupun kuasa Allah!",
      "ref_id": "Matius 22:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
