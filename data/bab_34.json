      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Matthew 22:15",
      "arabic_page": null,
      "text": "Kemudian pergilah orang-orang Farisi; mereka berunding bagaimana mereka dapat menjerat Yesus dengan suatu pertanyaan. [Luke 20:20b]",
      "ref_id": "Matius 22:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Matthew 22:15",
      "arabic_page": null,
      "text": "dan menyerahkan-Nya kepada wewenang dan kuasa wali negeri.",
      "ref_id": "Matius 22:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Matthew 22:16",
      "arabic_page": 129,
      "text": "Mereka menyuruh murid-murid mereka bersama-sama orang-orang Herodian bertanya kepada-Nya: \" Guru, kami tahu, Engkau adalah seorang yang jujur dan dengan jujur mengajar jalan Allah dan Engkau tidak takut kepada siapapun juga, sebab Engkau tidak",
      "ref_id": "Matius 22:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 34
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Matthew 22:16",
      "arabic_page": 129,
      "text": "mencari muka.",
      "ref_id": "Matius 22:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "Matthew 22:17",
      "arabic_page": 129,
      "text": "Katakanlah kepada kami pendapat-Mu: Apakah diperbolehkan",
      "ref_id": "Matius 22:17",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Matthew 22:17",
      "arabic_page": 129,
      "text": "membayar pajak kepada Kaisar atau tidak?\"",
      "ref_id": "Matius 22:17",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 7,
      "diatessaron_verse": "4",
      "ref": "Mark 12:14",
      "arabic_page": 129,
      "text": "Haruskah kami bayar atau tidak?\"",
      "ref_id": "Markus 12:14",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 5
    },
    {
      "id": 8,
      "diatessaron_verse": "4",
      "ref": "Mark 12:15a",
      "arabic_page": 129,
      "text": "Tetapi Yesus mengetahui",
      "ref_id": "Markus 12:15a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 3
    },
    {
      "id": 9,
      "diatessaron_verse": "5",
      "ref": "Mark 12:15a",
      "arabic_page": 129,
      "text": "kemunafikan mereka, lalu berkata kepada mereka: [Mat. 22:18b] \"Mengapa kamu mencobai Aku, hai orang-orang munafik?",
      "ref_id": "Markus 12:15a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 15
    },
    {
      "id": 10,
      "diatessaron_verse": "5",
      "ref": "Luke 20:24a",
      "arabic_page": 129,
      "text": "\"Tunjukkanlah kepada-Ku",
      "ref_id": "Lukas 20:24a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 11,
      "diatessaron_verse": "6",
      "ref": "Luke 20:24a",
      "arabic_page": 129,
      "text": "suatu dinar; [Mat. 22:19a] Mereka membawa suatu dinar kepada-Nya.",
      "ref_id": "Lukas 20:24a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 12,
      "diatessaron_verse": "6",
      "ref": "Matthew 22:20",
      "arabic_page": 129,
      "text": "Maka Ia bertanya kepada mereka: \"Gambar dan tulisan siapakah ini?\"",
      "ref_id": "Matius 22:20",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 13,
      "diatessaron_verse": "7, 8",
      "ref": "Matthew 22:21",
      "arabic_page": 129,
      "text": "Jawab mereka: \"Gambar dan tulisan Kaisar.\" Lalu kata Yesus kepada mereka: \"Berikanlah kepada Kaisar apa yang wajib kamu berikan kepada Kaisar dan kepada Allah apa yang wajib kamu berikan kepada Allah.\"",
      "ref_id": "Matius 22:21",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 31
    },
    {
      "id": 14,
      "diatessaron_verse": "7, 8",
      "ref": "Luke 20:26",
      "arabic_page": 129,
      "text": "Dan mereka tidak dapat menjerat Dia dalam perkataan-Nya di depan orang banyak. Mereka heran akan jawab-Nya itu dan mereka diam.",
      "ref_id": "Lukas 20:26",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 20
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "Matthew 22:23",
      "arabic_page": 129,
      "text": "Pada hari itu datanglah kepada Yesus beberapa orang Saduki, yang berpendapat, bahwa",
      "ref_id": "Matius 22:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 16,
      "diatessaron_verse": "10",
      "ref": "Matthew 22:23",
      "arabic_page": 129,
      "text": "tidak ada kebangkitan. Mereka bertanya kepada-Nya:",
      "ref_id": "Matius 22:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 17,
      "diatessaron_verse": "10",
      "ref": "Matthew 22:24",
      "arabic_page": 129,
      "text": "\"Guru, Musa mengatakan, bahwa jika seorang mati dengan tiada meninggalkan anak, saudaranya harus kawin dengan isterinya itu dan membangkitkan keturunan",
      "ref_id": "Matius 22:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 20
    },
    {
      "id": 18,
      "diatessaron_verse": "11",
      "ref": "Matthew 22:24",
      "arabic_page": 129,
      "text": "bagi saudaranya itu. [Luke 20:29] Adalah tujuh orang bersaudara. Yang pertama kawin dengan seorang perempuan",
      "ref_id": "Matius 22:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 19,
      "diatessaron_verse": "12",
      "ref": "Matthew 22:24",
      "arabic_page": 129,
      "text": "lalu mati dengan tidak meninggalkan anak.",
      "ref_id": "Matius 22:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 20,
      "diatessaron_verse": "12",
      "ref": "Luke 20:30",
      "arabic_page": 129,
      "text": "Lalu perempuan itu dikawini oleh yang kedua,",
      "ref_id": "Lukas 20:30",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 21,
      "diatessaron_verse": "12",
      "ref": "Mark 12:21a",
      "arabic_page": 129,
      "text": "dan mati dengan tidak meninggalkan keturunan.",
      "ref_id": "Markus 12:21a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 6
    },
    {
      "id": 22,
      "diatessaron_verse": "13",
      "ref": "Luke 20:31",
      "arabic_page": 129,
      "text": "dan oleh yang ketiga dan demikianlah berturut-turut oleh ketujuh saudara itu, mereka semuanya",
      "ref_id": "Lukas 20:31",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 23,
      "diatessaron_verse": "14, 15",
      "ref": "Luke 20:31",
      "arabic_page": 129,
      "text": "mati dengan tidak meninggalkan anak.",
      "ref_id": "Lukas 20:31",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
