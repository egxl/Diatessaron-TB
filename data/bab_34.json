      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 44,
      "diatessaron_verse": "26",
      "ref": "Luke 10:25b",
      "arabic_page": 130,
      "text": "\"Guru, apa yang harus kuperbuat untuk memperoleh hidup yang kekal?\"",
      "ref_id": "Lukas 10:25b",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
