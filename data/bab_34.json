      "diatessaron_verse": "51",
      "ref": "John 7:33",
      "arabic_page": 132,
      "text": "Tinggal sedikit waktu saja Aku ada bersama kamu dan sesudah itu Aku akan pergi kepada Dia yang telah mengutus Aku.",
