      "diatessaron_verse": "14, 15",
      "ref": "Matthew 22:28",
      "arabic_page": 129,
      "text": "Siapakah di antara ketujuh orang itu yang menjadi suami perempuan itu pada hari kebangkitan? Sebab mereka semua telah beristerikan",
      "ref_id": "Matius 22:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 19
    },
    {
      "id": 26,
      "diatessaron_verse": "16",
