      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 12
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "John 19:15",
      "arabic_page": 192,
      "text": "Maka berteriaklah mereka: \"Enyahkan Dia! Enyahkan Dia! Salibkan Dia!\" Kata Pilatus kepada mereka: \"Haruskah aku menyalibkan rajamu?\" Jawab imam-imam kepala: \"Kami tidak mempunyai raja selain dari pada",
      "ref_id": "Yohanes 19:15",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 27
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "John 19:15",
      "arabic_page": 192,
      "text": "Kaisar!\"",
      "ref_id": "Yohanes 19:15",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 1
    },
    {
      "id": 7,
      "diatessaron_verse": "4",
      "ref": "Matthew 27:24",
      "arabic_page": 192,
      "text": "Ketika Pilatus melihat bahwa segala usaha akan sia-sia, malah sudah mulai timbul kekacauan, ia mengambil air dan membasuh tangannya di hadapan orang banyak dan berkata: \"Aku",
      "ref_id": "Matius 27:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 26
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Matthew 27:24",
      "arabic_page": 192,
      "text": "tidak bersalah terhadap darah orang ini; itu urusan kamu sendiri!\"",
      "ref_id": "Matius 27:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 9,
      "diatessaron_verse": "5",
      "ref": "Matthew 27:25",
      "arabic_page": 192,
      "text": "Dan seluruh rakyat itu",
      "ref_id": "Matius 27:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 10,
      "diatessaron_verse": "6",
      "ref": "Matthew 27:25",
      "arabic_page": 192,
      "text": "menjawab: \"Biarlah darah-Nya ditanggungkan atas kami dan atas anak-anak kami!\"",
      "ref_id": "Matius 27:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 11,
      "diatessaron_verse": "6",
      "ref": "John 19:16a",
      "arabic_page": 192,
      "text": "Akhirnya Pilatus menyerahkan Yesus kepada mereka untuk disalibkan.",
