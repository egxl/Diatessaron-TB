      "book_id": "Yohanes",
      "word_count": 6
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "John 19:14",
      "arabic_page": 192,
      "text": "kira-kira jam dua belas. Kata Pilatus kepada orang-orang Yahudi itu: \"Inilah rajamu!\"",
