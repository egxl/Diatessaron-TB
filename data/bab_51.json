      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 20
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "Matthew 27:3",
      "arabic_page": 192,
      "text": "tiga puluh perak itu kepada imam-imam kepala dan tua-tua,",
      "ref_id": "Matius 27:3",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
