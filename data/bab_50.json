      "text": "membebaskan raja orang Yahudi bagimu?",
      "ref_id": "Yohanes 18:39",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 5
    },
    {
      "id": 39,
      "diatessaron_verse": "24",
      "ref": "John 18:40",
      "arabic_page": 190,
      "text": "Mereka berteriak pula: \"Jangan Dia, melainkan Barabas!\" Barabas adalah seorang",
