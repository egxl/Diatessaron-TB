      "book_id": "Markus",
      "word_count": 4
    },
    {
      "id": 48,
      "diatessaron_verse": "28",
      "ref": "Matthew 27:18",
      "arabic_page": 190,
      "text": "Ia memang mengetahui, bahwa mereka telah menyerahkan Yesus karena dengki.",
