    {
      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Luke 23:4",
      "arabic_page": null,
      "text": "Kata Pilatus kepada imam-imam kepala dan seluruh orang banyak itu: \"Aku tidak mendapati",
      "ref_id": "Lukas 23:4",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Luke 23:4",
      "arabic_page": null,
      "text": "kesalahan apapun pada orang ini.\"",
      "ref_id": "Lukas 23:4",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Luke 23:5",
      "arabic_page": null,
      "text": "Tetapi mereka makin kuat mendesak, katanya: \"Ia menghasut rakyat dengan ajaran-Nya di seluruh Yudea, Ia mulai di Galilea dan sudah sampai",
      "ref_id": "Lukas 23:5",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 21
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Luke 23:5",
      "arabic_page": null,
      "text": "ke sini.\"",
      "ref_id": "Lukas 23:5",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "Luke 23:6",
      "arabic_page": null,
      "text": "Ketika Pilatus mendengar itu ia bertanya, apakah orang itu seorang Galilea.",
      "ref_id": "Lukas 23:6",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Luke 23:7",
      "arabic_page": null,
      "text": "Dan ketika ia tahu, bahwa Yesus seorang dari wilayah Herodes, ia mengirim Dia menghadap Herodes, yang pada waktu itu ada juga di Yerusalem.",
      "ref_id": "Lukas 23:7",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 23
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "Luke 23:8",
      "arabic_page": null,
      "text": "Ketika Herodes melihat Yesus, ia sangat girang. Sebab sudah lama ia ingin melihat-Nya, karena ia sering mendengar tentang Dia, lagipula ia mengharapkan",
      "ref_id": "Lukas 23:8",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 22
    },
    {
      "id": 8,
      "diatessaron_verse": "6",
      "ref": "Luke 23:8",
      "arabic_page": 189,
      "text": "melihat bagaimana Yesus mengadakan suatu tanda.",
      "ref_id": "Lukas 23:8",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 9,
      "diatessaron_verse": "6",
      "ref": "Luke 23:9",
      "arabic_page": 189,
      "text": "Ia mengajukan banyak pertanyaan kepada Yesus, tetapi",
      "ref_id": "Lukas 23:9",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 10,
      "diatessaron_verse": "7",
      "ref": "Luke 23:9",
      "arabic_page": 189,
      "text": "Yesus tidak memberi jawaban apapun.",
      "ref_id": "Lukas 23:9",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "Luke 23:10",
      "arabic_page": 189,
      "text": "Sementara itu imam-imam kepala dan ahli-ahli Taurat",
      "ref_id": "Lukas 23:10",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 12,
      "diatessaron_verse": "8",
      "ref": "Luke 23:10",
      "arabic_page": 189,
      "text": "maju ke depan dan melontarkan tuduhan-tuduhan yang berat terhadap Dia.",
      "ref_id": "Lukas 23:10",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "Luke 23:11",
      "arabic_page": 189,
      "text": "Maka mulailah Herodes dan pasukannya menista dan mengolok-olokkan Dia, ia mengenakan jubah kebesaran kepada-Nya lalu",
      "ref_id": "Lukas 23:11",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 15
    },
    {
      "id": 14,
      "diatessaron_verse": "9",
      "ref": "Luke 23:11",
      "arabic_page": 189,
      "text": "mengirim Dia kembali kepada Pilatus.",
      "ref_id": "Lukas 23:11",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "Luke 23:12",
      "arabic_page": 189,
      "text": "Dan pada hari itu juga bersahabatlah Herodes dan Pilatus; sebelum itu mereka bermusuhan.",
      "ref_id": "Lukas 23:12",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 16,
      "diatessaron_verse": "10, 11",
      "ref": "Luke 23:13",
      "arabic_page": 189,
      "text": "Lalu Pilatus mengumpulkan imam-imam kepala dan pemimpin-pemimpin serta rakyat,",
      "ref_id": "Lukas 23:13",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 17,
      "diatessaron_verse": "10, 11",
      "ref": "Luke 23:14",
      "arabic_page": 189,
      "text": "dan berkata kepada mereka: \"Kamu telah membawa orang ini kepadaku sebagai seorang yang menyesatkan rakyat. Kamu lihat sendiri bahwa aku telah memeriksa-Nya, dan dari kesalahan-kesalahan yang kamu",
      "ref_id": "Lukas 23:14",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 27
    },
    {
      "id": 18,
      "diatessaron_verse": "12",
      "ref": "Luke 23:14",
      "arabic_page": 189,
      "text": "tuduhkan kepada-Nya tidak ada yang kudapati pada-Nya.",
      "ref_id": "Lukas 23:14",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 19,
      "diatessaron_verse": "12",
      "ref": "Luke 23:15",
      "arabic_page": 189,
      "text": "Dan Herodes juga tidak, sebab ia mengirimkan Dia kembali kepada kami. Sesungguhnya",
      "ref_id": "Lukas 23:15",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 20,
      "diatessaron_verse": "13",
      "ref": "Luke 23:15",
      "arabic_page": 189,
      "text": "tidak ada suatu apapun yang dilakukan-Nya yang setimpal dengan hukuman mati.",
      "ref_id": "Lukas 23:15",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 21,
      "diatessaron_verse": "13",
      "ref": "Luke 23:16",
      "arabic_page": 189,
      "text": "Jadi aku akan menghajar Dia, lalu",
      "ref_id": "Lukas 23:16",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 22,
      "diatessaron_verse": "14, 15",
      "ref": "Luke 23:16",
      "arabic_page": 189,
      "text": "melepaskan-Nya.\"",
      "ref_id": "Lukas 23:16",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 1
    },
    {
      "id": 23,
      "diatessaron_verse": "14, 15",
      "ref": "Luke 23:18a",
      "arabic_page": 189,
      "text": "Tetapi mereka berteriak bersama-sama: \"Enyahkanlah Dia.",
      "ref_id": "Lukas 23:18a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 24,
      "diatessaron_verse": "14, 15",
      "ref": "Mark 15:3a",
      "arabic_page": 189,
      "text": "Lalu",
      "ref_id": "Markus 15:3a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 1
    },
    {
      "id": 25,
      "diatessaron_verse": "16",
      "ref": "Mark 15:3a",
      "arabic_page": 189,
      "text": "imam-imam kepala mengajukan banyak tuduhan terhadap Dia.",
      "ref_id": "Markus 15:3a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 7
    },
    {
      "id": 26,
      "diatessaron_verse": "16",
      "ref": "Matthew 27:12",
      "arabic_page": 189,
      "text": "Tetapi atas",
      "ref_id": "Matius 27:12",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 27,
      "diatessaron_verse": "17",
      "ref": "Matthew 27:12",
      "arabic_page": 189,
      "text": "tuduhan yang diajukan imam-imam kepala dan tua-tua terhadap Dia, Ia tidak memberi jawab apapun.",
      "ref_id": "Matius 27:12",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 14
    },
    {
      "id": 28,
      "diatessaron_verse": "17",
      "ref": "Matthew 27:13",
      "arabic_page": 189,
      "text": "Maka kata Pilatus kepada-Nya: \"Tidakkah Engkau dengar",
      "ref_id": "Matius 27:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 29,
      "diatessaron_verse": "18",
      "ref": "Matthew 27:13",
      "arabic_page": 189,
      "text": "betapa banyaknya tuduhan saksi-saksi ini terhadap Engkau?\"",
      "ref_id": "Matius 27:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 30,
      "diatessaron_verse": "18",
      "ref": "Matthew 27:14",
      "arabic_page": 189,
      "text": "Tetapi Ia tidak menjawab suatu katapun, sehingga wali negeri itu sangat heran.",
      "ref_id": "Matius 27:14",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 31,
      "diatessaron_verse": "19",
      "ref": "Matthew 27:19",
      "arabic_page": 189,
      "text": "Ketika Pilatus sedang duduk di kursi pengadilan, isterinya mengirim pesan kepadanya: \"Jangan engkau mencampuri perkara orang benar itu, sebab karena Dia aku sangat menderita dalam mimpi tadi malam.\"",
      "ref_id": "Matius 27:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 28
    },
    {
      "id": 32,
      "diatessaron_verse": "20",
      "ref": "Matthew 27:15",
      "arabic_page": 189,
      "text": "Telah menjadi kebiasaan bagi wali negeri untuk membebaskan satu",
      "ref_id": "Matius 27:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 33,
      "diatessaron_verse": "21",
      "ref": "Matthew 27:15",
      "arabic_page": 189,
      "text": "orang hukuman pada tiap-tiap hari raya itu atas pilihan orang banyak.",
      "ref_id": "Matius 27:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 34,
      "diatessaron_verse": "21",
      "ref": "Matthew 27:16",
      "arabic_page": 189,
      "text": "Dan pada waktu itu ada dalam penjara seorang yang terkenal kejahatannya yang bernama",
      "ref_id": "Matius 27:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 35,
      "diatessaron_verse": "22, 23",
      "ref": "Matthew 27:16",
      "arabic_page": 189,
      "text": "Yesus Barabas.",
      "ref_id": "Matius 27:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 36,
      "diatessaron_verse": "22, 23",
      "ref": "Matthew 27:17a",
      "arabic_page": 189,
      "text": "Karena mereka sudah berkumpul di sana, Pilatus berkata kepada mereka:",
      "ref_id": "Matius 27:17a",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 37,
      "diatessaron_verse": "22, 23",
      "ref": "John 18:39",
      "arabic_page": 189,
      "text": "Tetapi pada kamu ada kebiasaan, bahwa pada Paskah aku membebaskan seorang bagimu. Maukah kamu, supaya aku",
