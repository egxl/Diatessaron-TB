      "arabic_page": 190,
      "text": "\"Siapa yang kamu kehendaki kubebaskan bagimu, Yesus Barabas atau Yesus, yang disebut Kristus?\"",
      "ref_id": "Matius 27:17b",
      "book_code": "mat",
