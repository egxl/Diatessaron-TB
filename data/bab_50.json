      "word_count": 10
    },
    {
      "id": 49,
      "diatessaron_verse": "29",
      "ref": "Matthew 27:20",
      "arabic_page": 190,
      "text": "Tetapi oleh hasutan imam-imam kepala dan tua-tua, orang banyak bertekad untuk meminta supaya Barabas dibebaskan dan",
      "ref_id": "Matius 27:20",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
