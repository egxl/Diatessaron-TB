      "diatessaron_verse": "7",
      "ref": "Matthew 1:23",
      "arabic_page": 7,
      "text": "--yang berarti: Allah menyertai kita.",
      "ref_id": "Matius 1:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "Matthew 1:24",
      "arabic_page": 7,
      "text": "Sesudah bangun dari tidurnya,",
      "ref_id": "Matius 1:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
