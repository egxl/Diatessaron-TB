      "diatessaron_verse": "8",
      "ref": "Matthew 1:24",
      "arabic_page": 7,
      "text": "Yusuf berbuat seperti yang diperintahkan malaikat Tuhan itu kepadanya. Ia mengambil Maria sebagai isterinya,",
      "ref_id": "Matius 1:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 14
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "Matthew 1:25[a",
      "arabic_page": 7,
      "text": "tetapi tidak bersetubuh dengan dia sampai ia melahirkan anaknya laki-laki.",
      "ref_id": "Matius 1:25[a",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
