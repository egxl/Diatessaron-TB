      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Matthew 1:18",
      "arabic_page": 7,
      "text": "Kelahiran Yesus Kristus adalah seperti berikut: Pada waktu Maria, ibu-Nya, bertunangan dengan Yusuf,",
      "ref_id": "Matius 1:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Matthew 1:18",
      "arabic_page": 7,
      "text": "ternyata ia mengandung dari Roh Kudus, sebelum mereka hidup sebagai suami isteri.",
      "ref_id": "Matius 1:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Matthew 1:19",
      "arabic_page": 7,
      "text": "Karena Yusuf suaminya, seorang yang tulus hati dan tidak mau mencemarkan nama isterinya di muka umum, ia bermaksud menceraikannya dengan diam-diam.",
      "ref_id": "Matius 1:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 21
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Matthew 1:20",
      "arabic_page": 7,
      "text": "Tetapi ketika ia mempertimbangkan maksud itu, malaikat Tuhan nampak kepadanya dalam mimpi dan berkata: \"Yusuf, anak Daud, janganlah engkau takut mengambil Maria sebagai isterimu, sebab",
      "ref_id": "Matius 1:20",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 25
    },
    {
      "id": 5,
      "diatessaron_verse": "4",
      "ref": "Matthew 1:20",
      "arabic_page": 7,
      "text": "anak yang di dalam kandungannya adalah dari Roh Kudus.",
      "ref_id": "Matius 1:20",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Matthew 1:21",
      "arabic_page": 7,
      "text": "Ia akan melahirkan anak laki-laki dan engkau akan",
      "ref_id": "Matius 1:21",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "Matthew 1:21",
      "arabic_page": 7,
      "text": "menamakan Dia Yesus, karena Dialah yang akan menyelamatkan umat-Nya dari dosa mereka.\"",
      "ref_id": "Matius 1:21",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Matthew 1:22",
      "arabic_page": 7,
      "text": "Hal itu terjadi supaya genaplah yang difirmankan Tuhan oleh nabi:",
      "ref_id": "Matius 1:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 9,
      "diatessaron_verse": "6",
      "ref": "Matthew 1:23",
      "arabic_page": 7,
      "text": "\"Sesungguhnya, anak dara itu akan mengandung dan melahirkan seorang anak laki-laki, dan mereka akan menamakan Dia Imanuel\"",
      "ref_id": "Matius 1:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
    {
