      "ref": "Luke 11:9",
      "arabic_page": 40,
      "text": "dibukakan bagimu.",
      "ref_id": "Lukas 11:9",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
