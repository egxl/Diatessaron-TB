    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Matthew 6:24",
      "arabic_page": 38,
      "text": "tidak mengindahkan yang lain. Kamu tidak dapat mengabdi kepada Allah dan kepada Mamon.\"",
      "ref_id": "Matius 6:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Matthew 6:25",
      "arabic_page": 38,
      "text": "\"Karena itu Aku berkata kepadamu: Janganlah kuatir akan hidupmu, akan apa yang hendak kamu makan atau minum, dan janganlah kuatir pula akan tubuhmu, akan apa yang hendak kamu pakai. Bukankah hidup itu lebih penting dari pada makanan dan tubuh itu lebih penting",
      "ref_id": "Matius 6:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 42
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Matthew 6:25",
      "arabic_page": 38,
      "text": "dari pada pakaian?",
      "ref_id": "Matius 6:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "Matthew 6:26",
      "arabic_page": 38,
      "text": "Pandanglah burung-burung di langit, yang tidak menabur dan tidak menuai dan tidak mengumpulkan bekal dalam lumbung, namun diberi makan oleh Bapamu yang di sorga. Bukankah kamu",
      "ref_id": "Matius 6:26",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 26
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Matthew 6:26",
      "arabic_page": 38,
      "text": "jauh melebihi burung-burung itu?",
      "ref_id": "Matius 6:26",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 7,
      "diatessaron_verse": "4",
      "ref": "Matthew 6:27",
      "arabic_page": 38,
      "text": "Siapakah di antara kamu yang karena kekuatirannya dapat menambahkan",
      "ref_id": "Matius 6:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Matthew 6:27",
      "arabic_page": 38,
      "text": "sehasta saja pada jalan hidupnya?",
      "ref_id": "Matius 6:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 9,
      "diatessaron_verse": "5",
      "ref": "Luke 12:26",
      "arabic_page": 38,
      "text": "Jadi, jikalau kamu tidak sanggup membuat barang yang paling kecil, mengapa kamu kuatir",
      "ref_id": "Lukas 12:26",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 10,
      "diatessaron_verse": "6, 7",
      "ref": "Luke 12:26",
      "arabic_page": 38,
      "text": "akan hal-hal lain?",
      "ref_id": "Lukas 12:26",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 11,
      "diatessaron_verse": "6, 7",
      "ref": "Matthew 6:28",
      "arabic_page": 38,
      "text": "Dan mengapa kamu kuatir akan pakaian? Perhatikanlah bunga bakung di ladang, yang tumbuh tanpa bekerja dan tanpa memintal,",
      "ref_id": "Matius 6:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 18
    },
    {
      "id": 12,
      "diatessaron_verse": "6, 7",
      "ref": "Matthew 6:29",
      "arabic_page": 38,
      "text": "namun Aku berkata kepadamu: Salomo dalam segala kemegahannyapun tidak berpakaian seindah salah satu",
      "ref_id": "Matius 6:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "Matthew 6:29",
      "arabic_page": 38,
      "text": "dari bunga itu.",
      "ref_id": "Matius 6:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 14,
      "diatessaron_verse": "8",
      "ref": "Matthew 6:30",
      "arabic_page": 38,
      "text": "Jadi jika demikian Allah mendandani rumput di ladang, yang hari ini ada dan besok",
      "ref_id": "Matius 6:30",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 14
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "Matthew 6:30",
      "arabic_page": 38,
      "text": "dibuang ke dalam api, tidakkah Ia akan terlebih lagi mendandani kamu, hai orang yang kurang percaya?",
      "ref_id": "Matius 6:30",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 16,
      "diatessaron_verse": "9",
      "ref": "Matthew 6:31",
      "arabic_page": 38,
      "text": "Sebab itu janganlah kamu kuatir dan berkata: Apakah yang akan kami makan? Apakah yang akan kami minum?",
      "ref_id": "Matius 6:31",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
    {
      "id": 17,
      "diatessaron_verse": "10",
      "ref": "Matthew 6:31",
      "arabic_page": 38,
      "text": "Apakah yang akan kami pakai?",
      "ref_id": "Matius 6:31",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 18,
      "diatessaron_verse": "10",
      "ref": "Luke 12:29[b",
      "arabic_page": 38,
      "text": "dan janganlah cemas hatimu.",
      "ref_id": "Lukas 12:29[b",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 19,
      "diatessaron_verse": "10",
      "ref": "Matthew 6:32",
      "arabic_page": 38,
      "text": "Semua itu dicari bangsa-bangsa yang tidak mengenal Allah. Akan tetapi Bapamu yang di sorga tahu,",
      "ref_id": "Matius 6:32",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 20,
      "diatessaron_verse": "11",
      "ref": "Matthew 6:32",
      "arabic_page": 38,
      "text": "bahwa kamu memerlukan semuanya itu.",
      "ref_id": "Matius 6:32",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 21,
      "diatessaron_verse": "11",
      "ref": "Matthew 6:33",
      "arabic_page": 38,
      "text": "Tetapi carilah dahulu Kerajaan Allah",
      "ref_id": "Matius 6:33",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 22,
      "diatessaron_verse": "12",
      "ref": "Matthew 6:33",
      "arabic_page": 39,
      "text": "dan kebenarannya, maka semuanya itu akan ditambahkan kepadamu.",
      "ref_id": "Matius 6:33",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 23,
      "diatessaron_verse": "12",
      "ref": "Matthew 6:34",
      "arabic_page": 39,
      "text": "Sebab itu janganlah kamu kuatir akan hari besok, karena hari besok mempunyai kesusahannya sendiri. Kesusahan sehari cukuplah untuk sehari.\"",
      "ref_id": "Matius 6:34",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 19
    },
    {
      "id": 24,
      "diatessaron_verse": "13",
      "ref": "Matthew 7:1",
      "arabic_page": 39,
      "text": "\"Jangan kamu menghakimi, supaya kamu tidak dihakimi.",
      "ref_id": "Matius 7:1",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 25,
      "diatessaron_verse": "13",
      "ref": "Luke 6:37[b",
      "arabic_page": 39,
      "text": "janganlah kamu menghukum, maka kamupun tidak akan dihukum; ampunilah dan kamu akan diampuni.",
      "ref_id": "Lukas 6:37[b",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 26,
      "diatessaron_verse": "14",
      "ref": "Luke 6:38",
      "arabic_page": 39,
      "text": "Berilah dan kamu akan diberi: suatu takaran yang baik, yang dipadatkan, yang digoncang dan yang tumpah ke luar akan dicurahkan ke dalam ribaanmu.",
      "ref_id": "Lukas 6:38",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 23
    },
    {
      "id": 27,
      "diatessaron_verse": "15",
      "ref": "Luke 6:38",
      "arabic_page": 39,
      "text": "Sebab ukuran yang kamu pakai untuk mengukur, akan diukurkan kepadamu.\"",
      "ref_id": "Lukas 6:38",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 28,
      "diatessaron_verse": "15",
      "ref": "Mark 4:24[b",
      "arabic_page": 39,
      "text": "\"Camkanlah apa yang kamu dengar! Ukuran yang kamu pakai untuk mengukur akan diukurkan kepadamu, dan di samping itu",
      "ref_id": "Markus 4:24[b",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 18
    },
    {
      "id": 29,
