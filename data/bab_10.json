      "diatessaron_verse": "28",
      "ref": "Luke 11:11",
      "arabic_page": 40,
      "text": "Bapa manakah di antara kamu, jika anaknya minta ikan dari padanya, akan memberikan ular kepada anaknya itu ganti ikan?",
      "ref_id": "Lukas 11:11",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 19
    },
    {
