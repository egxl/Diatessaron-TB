  "verses": [
    {
      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Luke 14:7",
      "arabic_page": null,
      "text": "Karena Yesus melihat, bahwa tamu-tamu berusaha menduduki tempat-tempat kehormatan,",
      "ref_id": "Lukas 14:7",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Luke 14:7",
      "arabic_page": null,
      "text": "Ia mengatakan perumpamaan ini kepada mereka:",
      "ref_id": "Lukas 14:7",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Luke 14:8",
      "arabic_page": null,
      "text": "\"Kalau seorang mengundang engkau ke pesta perkawinan, janganlah duduk di tempat kehormatan,",
      "ref_id": "Lukas 14:8",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Luke 14:8",
      "arabic_page": null,
      "text": "sebab mungkin orang itu telah mengundang seorang yang lebih terhormat dari padamu,",
      "ref_id": "Lukas 14:8",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "Luke 14:9",
      "arabic_page": null,
      "text": "supaya orang itu, yang mengundang engkau dan dia, jangan datang dan berkata kepadamu: Berilah tempat ini kepada orang itu. Lalu engkau dengan malu harus",
      "ref_id": "Lukas 14:9",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 24
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Luke 14:9",
      "arabic_page": null,
      "text": "pergi duduk di tempat yang paling rendah.",
      "ref_id": "Lukas 14:9",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 7,
      "diatessaron_verse": "4",
      "ref": "Luke 14:10",
      "arabic_page": null,
      "text": "Tetapi, apabila engkau diundang, pergilah duduk di tempat yang paling rendah. Mungkin tuan rumah akan datang dan berkata kepadamu: Sahabat, silakan duduk di depan. Dan",
      "ref_id": "Lukas 14:10",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 25
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Luke 14:10",
      "arabic_page": null,
      "text": "dengan demikian engkau akan menerima hormat di depan mata semua tamu yang lain.",
      "ref_id": "Lukas 14:10",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 9,
      "diatessaron_verse": "5",
      "ref": "Luke 14:11",
      "arabic_page": null,
      "text": "Sebab barangsiapa meninggikan diri, ia akan direndahkan dan barangsiapa merendahkan diri, ia akan ditinggikan.\"",
      "ref_id": "Lukas 14:11",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 10,
      "diatessaron_verse": "6",
      "ref": "Luke 14:12",
      "arabic_page": null,
      "text": "Dan Yesus berkata juga kepada orang yang mengundang Dia: \"Apabila engkau mengadakan perjamuan siang atau perjamuan malam, janganlah engkau mengundang sahabat-sahabatmu atau saudara-saudaramu atau kaum keluargamu atau",
      "ref_id": "Lukas 14:12",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 27
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "Luke 14:12",
      "arabic_page": null,
      "text": "tetangga-tetanggamu yang kaya, karena mereka akan membalasnya dengan mengundang engkau pula dan dengan demikian engkau mendapat balasnya.",
      "ref_id": "Lukas 14:12",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 17
    },
    {
      "id": 12,
      "diatessaron_verse": "7",
      "ref": "Luke 14:13",
      "arabic_page": null,
      "text": "Tetapi apabila engkau mengadakan perjamuan, undanglah orang-orang miskin, orang-orang cacat,",
      "ref_id": "Lukas 14:13",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "Luke 14:13",
      "arabic_page": null,
      "text": "orang-orang lumpuh dan orang-orang buta.",
      "ref_id": "Lukas 14:13",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 14,
      "diatessaron_verse": "8",
      "ref": "Luke 14:14",
      "arabic_page": null,
      "text": "Dan engkau akan berbahagia, karena mereka tidak mempunyai apa-apa untuk membalasnya",
      "ref_id": "Lukas 14:14",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "Luke 14:14",
      "arabic_page": null,
      "text": "kepadamu. Sebab engkau akan mendapat balasnya pada hari kebangkitan orang-orang benar.\"",
      "ref_id": "Lukas 14:14",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 16,
      "diatessaron_verse": "9",
      "ref": "Luke 14:15",
      "arabic_page": null,
      "text": "Mendengar itu berkatalah seorang dari tamu-tamu itu kepada Yesus: \"Berbahagialah orang yang akan dijamu dalam Kerajaan Allah.\"",
      "ref_id": "Lukas 14:15",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 17
    },
    {
      "id": 17,
      "diatessaron_verse": "10, 11",
      "ref": "Matthew 22:1",
      "arabic_page": null,
      "text": "Lalu Yesus berbicara pula dalam perumpamaan kepada mereka:",
      "ref_id": "Matius 22:1",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 18,
      "diatessaron_verse": "10, 11",
      "ref": "Matthew 22:2",
      "arabic_page": 115,
      "text": "\"Hal Kerajaan Sorga seumpama seorang raja, yang mengadakan perjamuan kawin untuk anaknya.",
      "ref_id": "Matius 22:2",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 19,
      "diatessaron_verse": "10, 11",
      "ref": "Luke 14:16b",
      "arabic_page": 115,
      "text": "dan",
      "ref_id": "Lukas 14:16b",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 1
    },
    {
      "id": 20,
      "diatessaron_verse": "12",
      "ref": "Luke 14:16b",
      "arabic_page": 115,
      "text": "ia mengundang banyak orang.",
      "ref_id": "Lukas 14:16b",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 21,
      "diatessaron_verse": "12",
      "ref": "Luke 14:17",
      "arabic_page": 115,
      "text": "Menjelang perjamuan itu dimulai, ia menyuruh hambanya mengatakan kepada para undangan: Marilah, sebab segala sesuatu sudah siap.",
      "ref_id": "Lukas 14:17",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 17
    },
    {
      "id": 22,
      "diatessaron_verse": "13",
      "ref": "Luke 14:18",
      "arabic_page": 115,
      "text": "Tetapi mereka bersama-sama meminta maaf. Yang pertama berkata kepadanya: Aku telah membeli ladang dan aku harus pergi",
      "ref_id": "Lukas 14:18",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 17
    },
    {
      "id": 23,
      "diatessaron_verse": "14",
      "ref": "Luke 14:18",
      "arabic_page": 115,
      "text": "melihatnya; aku minta dimaafkan.",
      "ref_id": "Lukas 14:18",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 24,
      "diatessaron_verse": "14",
      "ref": "Luke 14:19",
      "arabic_page": 115,
      "text": "Yang lain berkata: Aku telah membeli lima pasang lembu kebiri dan aku harus pergi mencobanya;",
      "ref_id": "Lukas 14:19",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 15
    },
    {
      "id": 25,
      "diatessaron_verse": "15",
      "ref": "Luke 14:19",
      "arabic_page": 115,
      "text": "aku minta dimaafkan.",
      "ref_id": "Lukas 14:19",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 26,
      "diatessaron_verse": "15",
      "ref": "Luke 14:20",
      "arabic_page": 115,
      "text": "Yang lain lagi berkata: Aku baru kawin",
      "ref_id": "Lukas 14:20",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 27,
      "diatessaron_verse": "16",
      "ref": "Luke 14:20",
      "arabic_page": 115,
      "text": "dan karena itu aku tidak dapat datang.",
      "ref_id": "Lukas 14:20",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 28,
      "diatessaron_verse": "16",
      "ref": "Matthew 22:4",
      "arabic_page": 115,
      "text": "Ia menyuruh pula hamba-hamba lain, pesannya: Katakanlah kepada orang-orang yang diundang itu: Sesungguhnya hidangan, telah kusediakan, lembu-lembu jantan dan ternak piaraanku",
      "ref_id": "Matius 22:4",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 21
    },
    {
      "id": 29,
      "diatessaron_verse": "17",
      "ref": "Matthew 22:4",
      "arabic_page": 115,
      "text": "telah disembelih; semuanya telah tersedia, datanglah ke perjamuan kawin ini.",
      "ref_id": "Matius 22:4",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 30,
      "diatessaron_verse": "17",
      "ref": "Matthew 22:5",
      "arabic_page": 115,
      "text": "Tetapi orang-orang yang diundang itu tidak mengindahkannya;",
      "ref_id": "Matius 22:5",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 31,
      "diatessaron_verse": "18",
      "ref": "Matthew 22:5",
      "arabic_page": 115,
      "text": "ada yang pergi ke ladangnya, ada yang pergi mengurus usahanya,",
      "ref_id": "Matius 22:5",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 32,
      "diatessaron_verse": "18",
      "ref": "Matthew 22:6",
      "arabic_page": 115,
      "text": "dan yang lain menangkap",
      "ref_id": "Matius 22:6",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 33,
      "diatessaron_verse": "19",
      "ref": "Matthew 22:6",
      "arabic_page": 115,
      "text": "hamba-hambanya itu, menyiksanya dan membunuhnya.",
      "ref_id": "Matius 22:6",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 34,
      "diatessaron_verse": "19",
      "ref": "Luke 14:21a",
      "arabic_page": 115,
      "text": "Maka",
      "ref_id": "Lukas 14:21a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 1
    },
    {
      "id": 35,
      "diatessaron_verse": "20",
      "ref": "Luke 14:21a",
      "arabic_page": 115,
      "text": "kembalilah hamba itu dan menyampaikan semuanya itu kepada tuannya.",
      "ref_id": "Lukas 14:21a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 36,
      "diatessaron_verse": "20",
      "ref": "Matthew 22:7",
      "arabic_page": 115,
      "text": "Maka murkalah raja itu, lalu menyuruh pasukannya ke sana untuk membinasakan pembunuh-pembunuh itu dan",
      "ref_id": "Matius 22:7",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 14
    },
    {
      "id": 37,
      "diatessaron_verse": "21",
      "ref": "Matthew 22:7",
      "arabic_page": 115,
      "text": "membakar kota mereka.",
      "ref_id": "Matius 22:7",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 38,
      "diatessaron_verse": "21",
      "ref": "Matthew 22:8",
      "arabic_page": 115,
      "text": "Sesudah itu ia berkata kepada hamba-hambanya: Perjamuan kawin telah tersedia, tetapi orang-orang",
      "ref_id": "Matius 22:8",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 39,
      "diatessaron_verse": "22",
      "ref": "Matthew 22:8",
      "arabic_page": 115,
      "text": "yang diundang tadi tidak layak untuk itu.",
      "ref_id": "Matius 22:8",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 40,
      "diatessaron_verse": "22",
      "ref": "Luke 14:21c",
      "arabic_page": 115,
      "text": "Pergilah dengan segera ke segala jalan dan lorong kota dan bawalah ke mari orang-orang miskin dan orang-orang cacat dan orang-orang buta dan orang-orang lumpuh.",
      "ref_id": "Lukas 14:21c",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 24
    },
    {
      "id": 41,
      "diatessaron_verse": "23",
      "ref": "Luke 14:22",
      "arabic_page": 115,
      "text": "Kemudian hamba itu melaporkan: Tuan, apa yang tuan",
      "ref_id": "Lukas 14:22",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 42,
      "diatessaron_verse": "24",
      "ref": "Luke 14:22",
      "arabic_page": 115,
      "text": "perintahkan itu sudah dilaksanakan, tetapi sekalipun demikian masih ada tempat.",
      "ref_id": "Lukas 14:22",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 43,
      "diatessaron_verse": "24",
      "ref": "Luke 14:23",
      "arabic_page": 115,
      "text": "Lalu kata tuan itu kepada hambanya: Pergilah ke semua jalan dan lintasan",
      "ref_id": "Lukas 14:23",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 44,
      "diatessaron_verse": "25",
      "ref": "Luke 14:23",
      "arabic_page": 116,
      "text": "dan paksalah orang-orang, yang ada di situ, masuk, karena rumahku harus penuh.",
      "ref_id": "Lukas 14:23",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 45,
      "diatessaron_verse": "25",
      "ref": "Luke 14:24",
      "arabic_page": 116,
      "text": "Sebab Aku berkata kepadamu: Tidak ada seorangpun dari orang-orang yang telah diundang itu akan menikmati jamuan-Ku.\"",
      "ref_id": "Lukas 14:24",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 16
    },
    {
      "id": 46,
      "diatessaron_verse": "26",
      "ref": "Matthew 22:10",
      "arabic_page": 116,
      "text": "Maka pergilah hamba-hamba itu dan mereka mengumpulkan semua orang yang dijumpainya di jalan-jalan,",
      "ref_id": "Matius 22:10",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 47,
      "diatessaron_verse": "27",
      "ref": "Matthew 22:10",
      "arabic_page": 116,
      "text": "orang-orang jahat dan orang-orang baik, sehingga penuhlah ruangan perjamuan kawin itu dengan tamu.",
      "ref_id": "Matius 22:10",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 48,
      "diatessaron_verse": "27",
      "ref": "Matthew 22:11",
      "arabic_page": 116,
      "text": "Ketika raja itu masuk untuk bertemu dengan",
      "ref_id": "Matius 22:11",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 49,
      "diatessaron_verse": "28",
      "ref": "Matthew 22:11",
      "arabic_page": 116,
      "text": "tamu-tamu itu, ia melihat seorang yang tidak berpakaian pesta.",
      "ref_id": "Matius 22:11",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 50,
      "diatessaron_verse": "28",
      "ref": "Matthew 22:12",
      "arabic_page": 116,
      "text": "Ia berkata kepadanya: Hai saudara, bagaimana engkau masuk ke mari dengan tidak mengenakan pakaian pesta? Tetapi orang itu diam saja.",
      "ref_id": "Matius 22:12",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 20
    },
    {
      "id": 51,
      "diatessaron_verse": "29",
      "ref": "Matthew 22:13",
      "arabic_page": 116,
      "text": "Lalu kata raja itu kepada hamba-hambanya: Ikatlah kaki dan tangannya dan campakkanlah orang itu ke dalam kegelapan yang paling gelap, di sanalah akan terdapat ratap dan",
      "ref_id": "Matius 22:13",
      "book_code": "mat",
