      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 14,
      "diatessaron_verse": "9",
      "ref": "Matthew 9:18[b",
      "arabic_page": null,
      "text": "tangan-Mu atasnya, maka ia akan hidup.\"",
      "ref_id": "Matius 9:18[b",
      "book_code": "mat",
