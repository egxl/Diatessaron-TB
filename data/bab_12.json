      "diatessaron_verse": "48, 49",
      "ref": "Matthew 10:8",
      "arabic_page": 49,
      "text": "dengan cuma-cuma.",
      "ref_id": "Matius 10:8",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 80,
      "diatessaron_verse": "48, 49",
      "ref": "Matthew 10:9",
      "arabic_page": 49,
      "text": "Janganlah kamu membawa emas atau perak atau tembaga dalam ikat pinggangmu.",
      "ref_id": "Matius 10:9",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 81,
      "diatessaron_verse": "48, 49",
      "ref": "Matthew 10:10",
      "arabic_page": 49,
      "text": "Janganlah kamu membawa bekal dalam perjalanan, janganlah kamu membawa baju dua helai,",
