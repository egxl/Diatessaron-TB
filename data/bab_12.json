      "ref": "Luke 9:2",
      "arabic_page": 49,
      "text": "untuk memberitakan Kerajaan Allah dan untuk menyembuhkan orang,",
      "ref_id": "Lukas 9:2",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 74,
      "diatessaron_verse": "44",
      "ref": "Matthew 10:5",
      "arabic_page": 49,
      "text": "Kedua belas murid itu diutus oleh Yesus dan Ia berpesan kepada mereka: \"Janganlah kamu menyimpang ke jalan bangsa lain atau masuk ke dalam kota orang Samaria,",
      "ref_id": "Matius 10:5",
      "book_code": "mat",
