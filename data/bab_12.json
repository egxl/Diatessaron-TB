      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 9
    },
    {
      "id": 18,
      "diatessaron_verse": "11, 12",
      "ref": "Mark 5:25",
      "arabic_page": null,
      "text": "Adalah di situ seorang perempuan yang sudah dua belas tahun lamanya menderita pendarahan.",
