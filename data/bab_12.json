      "ref": "Matthew 9:19",
      "arabic_page": null,
      "text": "dengan murid-murid-Nya.",
      "ref_id": "Matius 9:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 17,
      "diatessaron_verse": "10",
      "ref": "Mark 5:24[b",
      "arabic_page": null,
      "text": "Orang banyak berbondong-bondong mengikuti Dia dan berdesak-desakan di dekat-Nya.",
