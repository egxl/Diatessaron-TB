    {
      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Luke 8:37a",
      "arabic_page": null,
      "text": "Lalu seluruh penduduk daerah Gerasa meminta kepada Yesus, supaya Ia meninggalkan mereka, sebab mereka sangat ketakutan.",
      "ref_id": "Lukas 8:37a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 16
    },
    {
      "id": 2,
      "diatessaron_verse": "2, 3",
      "ref": "Matthew 9:1",
      "arabic_page": null,
      "text": "Sesudah itu naiklah Yesus ke dalam perahu lalu menyeberang. Kemudian sampailah Ia ke kota-Nya sendiri.",
      "ref_id": "Matius 9:1",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 3,
      "diatessaron_verse": "2, 3",
      "ref": "Luke 8:38",
      "arabic_page": null,
      "text": "Dan orang yang telah ditinggalkan setan-setan itu meminta supaya ia diperkenankan menyertai-Nya.",
      "ref_id": "Lukas 8:38",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 4,
      "diatessaron_verse": "4",
      "ref": "Luke 8:38",
      "arabic_page": null,
      "text": "Tetapi Yesus menyuruh dia pergi, kata-Nya:",
      "ref_id": "Lukas 8:38",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 5,
      "diatessaron_verse": "4",
      "ref": "Luke 8:39[a",
      "arabic_page": null,
      "text": "\"Pulanglah ke rumahmu dan ceriterakanlah segala sesuatu",
      "ref_id": "Lukas 8:39[a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 6,
      "diatessaron_verse": "5",
      "ref": "Luke 8:39[a",
      "arabic_page": null,
      "text": "yang telah diperbuat Allah atasmu.\"",
      "ref_id": "Lukas 8:39[a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "Mark 5:20",
      "arabic_page": null,
      "text": "Orang itupun pergilah dan mulai memberitakan di daerah Dekapolis segala apa yang telah diperbuat Yesus atas dirinya dan mereka semua menjadi heran.",
      "ref_id": "Markus 5:20",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 22
    },
    {
      "id": 8,
      "diatessaron_verse": "6",
      "ref": "Mark 5:21a",
      "arabic_page": null,
      "text": "Sesudah Yesus menyeberang lagi dengan perahu,[Luke 8:40b] orang banyak menyambut Dia",
      "ref_id": "Markus 5:21a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
    {
      "id": 9,
      "diatessaron_verse": "7",
      "ref": "Mark 5:21a",
      "arabic_page": null,
      "text": "sebab mereka semua menanti-nantikan Dia.",
      "ref_id": "Markus 5:21a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 5
    },
    {
      "id": 10,
      "diatessaron_verse": "7",
      "ref": "Luke 8:41[a",
      "arabic_page": null,
      "text": "Maka datanglah seorang yang bernama Yairus. Ia adalah kepala rumah ibadat.",
      "ref_id": "Lukas 8:41[a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 11,
      "diatessaron_verse": "8",
      "ref": "Luke 8:41[a",
      "arabic_page": null,
      "text": "Sambil tersungkur di depan kaki Yesus ia memohon kepada-Nya, supaya Yesus datang ke rumahnya,",
      "ref_id": "Lukas 8:41[a",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 12,
      "diatessaron_verse": "8",
      "ref": "Mark 5:23[a",
      "arabic_page": null,
      "text": "dan memohon dengan sangat kepada-Nya: \"Anakku perempuan sedang sakit, hampir mati,",
      "ref_id": "Markus 5:23[a",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 11
    },
