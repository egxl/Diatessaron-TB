      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "Matthew 9:19",
      "arabic_page": null,
      "text": "Lalu Yesuspun bangunlah dan mengikuti orang itu bersama-sama",
      "ref_id": "Matius 9:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
