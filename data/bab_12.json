      "diatessaron_verse": "47",
      "ref": "Matthew 10:7",
      "arabic_page": 49,
      "text": "beritakanlah: Kerajaan Sorga sudah dekat.",
      "ref_id": "Matius 10:7",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 78,
      "diatessaron_verse": "47",
      "ref": "Matthew 10:8",
      "arabic_page": 49,
      "text": "Sembuhkanlah orang sakit; bangkitkanlah orang mati; tahirkanlah orang kusta; usirlah setan-setan. Kamu telah memperolehnya dengan cuma-cuma, karena itu berikanlah pula",
      "ref_id": "Matius 10:8",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 20
    },
