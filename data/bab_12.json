      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 13
    },
    {
      "id": 19,
      "diatessaron_verse": "11, 12",
      "ref": "Mark 5:26",
      "arabic_page": null,
      "text": "Ia telah berulang-ulang diobati oleh berbagai tabib, sehingga telah dihabiskannya semua yang ada padanya, namun sama sekali tidak ada faedahnya malah sebaliknya",
