      "text": "melainkan pergilah kepada domba-domba yang hilang dari umat Israel.",
      "ref_id": "Matius 10:6",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 76,
      "diatessaron_verse": "45, 46",
      "ref": "Matthew 10:7",
      "arabic_page": 49,
      "text": "Pergilah dan",
