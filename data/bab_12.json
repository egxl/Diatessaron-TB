      "diatessaron_verse": "13",
      "ref": "Mark 5:26",
      "arabic_page": null,
      "text": "keadaannya makin memburuk.",
      "ref_id": "Markus 5:26",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 3
    },
    {
      "id": 21,
      "diatessaron_verse": "13",
      "ref": "Mark 5:27",
      "arabic_page": null,
      "text": "Dia sudah mendengar berita-berita tentang Yesus, maka di tengah-tengah orang banyak itu ia",
      "ref_id": "Markus 5:27",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 13
    },
    {
