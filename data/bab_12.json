      "ref_id": "Lukas 8:45[b",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 30,
      "diatessaron_verse": "18",
      "ref": "Luke 8:46",
      "arabic_page": 47,
      "text": "Tetapi Yesus berkata: \"Ada seorang yang menjamah Aku, sebab Aku merasa ada",
