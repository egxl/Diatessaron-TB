      "id": 82,
      "diatessaron_verse": "50",
      "ref": "Matthew 10:10",
      "arabic_page": 49,
      "text": "kasut atau tongkat, sebab seorang pekerja patut mendapat upahnya.",
      "ref_id": "Matius 10:10",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 83,
      "diatessaron_verse": "51",
      "ref": "Matthew 10:11",
      "arabic_page": 49,
      "text": "Apabila kamu masuk kota atau desa, carilah di situ seorang yang layak dan tinggallah padanya sampai",
      "ref_id": "Matius 10:11",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 84,
      "diatessaron_verse": "52, 53",
      "ref": "Matthew 10:11",
      "arabic_page": 49,
      "text": "kamu berangkat.",
      "ref_id": "Matius 10:11",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 85,
      "diatessaron_verse": "52, 53",
      "ref": "Matthew 10:12",
      "arabic_page": 49,
      "text": "Apabila kamu masuk rumah orang, berilah salam kepada mereka.",
      "ref_id": "Matius 10:12",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 86,
      "diatessaron_verse": "52, 53",
      "ref": "Matthew 10:13",
      "arabic_page": 49,
      "text": "Jika mereka layak menerimanya,",
      "ref_id": "Matius 10:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 87,
      "diatessaron_verse": "54",
      "ref": "Matthew 10:13",
      "arabic_page": 49,
      "text": "salammu itu turun ke atasnya, jika tidak, salammu itu kembali kepadamu.",
      "ref_id": "Matius 10:13",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 88,
      "diatessaron_verse": "54",
      "ref": "Matthew 10:14",
      "arabic_page": 49,
      "text": "Dan apabila seorang tidak menerima kamu dan tidak mendengar perkataanmu, keluarlah dan tinggalkanlah rumah atau kota itu",
      "ref_id": "Matius 10:14",
      "book_code": "mat",
      "book_en": "Matthew",
