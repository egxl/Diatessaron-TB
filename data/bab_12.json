      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 54,
      "diatessaron_verse": "31",
      "ref": "Luke 8:56",
      "arabic_page": 48,
      "text": "Dan takjublah orang tua anak itu,",
      "ref_id": "Lukas 8:56",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 55,
      "diatessaron_verse": "32",
      "ref": "Luke 8:56",
      "arabic_page": 48,
      "text": "tetapi Yesus melarang mereka memberitahukan kepada siapapun juga apa yang terjadi itu.",
      "ref_id": "Lukas 8:56",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 56,
      "diatessaron_verse": "33",
      "ref": "Matthew 9:27",
      "arabic_page": 48,
      "text": "Ketika Yesus meneruskan perjalanan-Nya dari sana, dua orang buta mengikuti-Nya sambil",
      "ref_id": "Matius 9:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 57,
      "diatessaron_verse": "34",
      "ref": "Matthew 9:27",
      "arabic_page": 48,
      "text": "berseru-seru dan berkata: \"Kasihanilah kami, hai Anak Daud.\"",
      "ref_id": "Matius 9:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 58,
      "diatessaron_verse": "34",
      "ref": "Matthew 9:28",
      "arabic_page": 48,
      "text": "Setelah Yesus masuk ke dalam sebuah rumah, datanglah kedua orang buta itu kepada-Nya dan Yesus berkata kepada mereka: \"Percayakah kamu,",
      "ref_id": "Matius 9:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 20
    },
    {
      "id": 59,
      "diatessaron_verse": "35",
      "ref": "Matthew 9:28",
      "arabic_page": 48,
      "text": "bahwa Aku dapat melakukannya?\" Mereka menjawab: \"Ya Tuhan, kami percaya.\"",
      "ref_id": "Matius 9:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 60,
      "diatessaron_verse": "35",
      "ref": "Matthew 9:29",
      "arabic_page": 48,
      "text": "Lalu Yesus",
      "ref_id": "Matius 9:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 61,
      "diatessaron_verse": "36",
      "ref": "Matthew 9:29",
      "arabic_page": 48,
      "text": "menjamah mata mereka sambil berkata: \"Jadilah kepadamu menurut imanmu.\"",
      "ref_id": "Matius 9:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 62,
      "diatessaron_verse": "36",
      "ref": "Matthew 9:30",
      "arabic_page": 48,
      "text": "Maka meleklah mata mereka. Dan Yesuspun dengan tegas berpesan kepada mereka, kata-Nya: \"Jagalah supaya jangan seorangpun mengetahui hal ini.\"",
      "ref_id": "Matius 9:30",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 19
    },
    {
      "id": 63,
      "diatessaron_verse": "37",
      "ref": "Matthew 9:31",
      "arabic_page": 48,
      "text": "Tetapi mereka keluar dan memasyhurkan Dia ke seluruh daerah itu.",
      "ref_id": "Matius 9:31",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
