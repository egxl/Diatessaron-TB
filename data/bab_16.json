  "verses": [
    {
      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Matthew 12:38",
      "arabic_page": null,
      "text": "Pada waktu itu berkatalah beberapa ahli Taurat dan orang Farisi kepada Yesus:",
      "ref_id": "Matius 12:38",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Matthew 12:38",
      "arabic_page": null,
      "text": "\"Guru, kami ingin melihat suatu tanda dari pada-Mu.\"",
      "ref_id": "Matius 12:38",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Matthew 12:39",
      "arabic_page": null,
      "text": "Tetapi jawab-Nya kepada mereka: \"Angkatan yang jahat dan tidak setia ini menuntut suatu tanda. Tetapi kepada mereka tidak akan diberikan",
      "ref_id": "Matius 12:39",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 20
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Matthew 12:39",
      "arabic_page": null,
      "text": "tanda selain tanda nabi Yunus.",
      "ref_id": "Matius 12:39",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "Luke 11:30",
      "arabic_page": null,
      "text": "Sebab seperti Yunus menjadi tanda untuk",
      "ref_id": "Lukas 11:30",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Luke 11:30",
      "arabic_page": null,
      "text": "orang-orang Niniwe, demikian pulalah Anak Manusia akan menjadi tanda untuk angkatan ini.",
      "ref_id": "Lukas 11:30",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 7,
      "diatessaron_verse": "4",
      "ref": "Matthew 12:40",
      "arabic_page": null,
      "text": "Sebab seperti Yunus tinggal di dalam perut ikan tiga hari tiga malam, demikian juga Anak Manusia",
      "ref_id": "Matius 12:40",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Matthew 12:40",
      "arabic_page": null,
      "text": "akan tinggal di dalam rahim bumi tiga hari tiga malam.",
      "ref_id": "Matius 12:40",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 9,
      "diatessaron_verse": "5",
      "ref": "Luke 11:31",
      "arabic_page": null,
      "text": "Pada waktu penghakiman, ratu dari Selatan itu akan bangkit bersama orang dari angkatan ini dan ia akan menghukum mereka. Sebab ratu ini datang dari ujung bumi untuk mendengarkan hikmat Salomo,",
      "ref_id": "Lukas 11:31",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 30
    },
    {
      "id": 10,
      "diatessaron_verse": "6",
      "ref": "Luke 11:31",
      "arabic_page": 62,
      "text": "dan sesungguhnya yang ada di sini lebih dari pada Salomo!",
      "ref_id": "Lukas 11:31",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 11,
      "diatessaron_verse": "6",
      "ref": "Matthew 12:41",
      "arabic_page": 62,
      "text": "Pada waktu penghakiman, orang-orang Niniwe akan bangkit bersama angkatan ini dan menghukumnya juga. Sebab orang-orang Niniwe itu bertobat setelah mendengar",
      "ref_id": "Matius 12:41",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 20
    },
    {
      "id": 12,
      "diatessaron_verse": "7",
      "ref": "Matthew 12:41",
      "arabic_page": 62,
      "text": "pemberitaan Yunus, dan sesungguhnya yang ada di sini lebih dari pada Yunus!",
      "ref_id": "Matius 12:41",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 13,
      "diatessaron_verse": "7",
      "ref": "Luke 11:24",
      "arabic_page": 62,
      "text": "\"Apabila roh jahat keluar dari manusia, iapun mengembara ke tempat-tempat yang tandus mencari perhentian, dan karena ia tidak mendapatnya,",
      "ref_id": "Lukas 11:24",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 19
    },
    {
      "id": 14,
      "diatessaron_verse": "8",
      "ref": "Luke 11:24",
      "arabic_page": 62,
      "text": "ia berkata: Aku akan kembali ke rumah yang telah kutinggalkan itu.",
      "ref_id": "Lukas 11:24",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 15,
      "diatessaron_verse": "8",
      "ref": "Luke 11:25",
      "arabic_page": 62,
      "text": "Maka pergilah ia dan mendapati rumah itu",
      "ref_id": "Lukas 11:25",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 16,
      "diatessaron_verse": "9",
      "ref": "Luke 11:25",
      "arabic_page": 62,
      "text": "bersih tersapu dan rapih teratur.",
      "ref_id": "Lukas 11:25",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 17,
      "diatessaron_verse": "9",
      "ref": "Luke 11:26",
      "arabic_page": 62,
      "text": "Lalu ia keluar dan mengajak tujuh roh lain yang lebih jahat dari padanya, dan mereka masuk dan berdiam di situ. Maka akhirnya keadaan orang itu",
      "ref_id": "Lukas 11:26",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 25
    },
    {
      "id": 18,
      "diatessaron_verse": "10",
      "ref": "Luke 11:26",
      "arabic_page": 62,
      "text": "lebih buruk dari pada keadaannya semula.\"",
      "ref_id": "Lukas 11:26",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 19,
      "diatessaron_verse": "10",
      "ref": "Matthew 12:45b",
      "arabic_page": 62,
      "text": "Demikian juga akan berlaku atas angkatan yang jahat ini.\"",
      "ref_id": "Matius 12:45b",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 20,
      "diatessaron_verse": "11",
      "ref": "Luke 11:27",
      "arabic_page": 62,
      "text": "Ketika Yesus masih berbicara, berserulah seorang perempuan dari antara orang banyak dan berkata kepada-Nya: \"Berbahagialah ibu yang telah mengandung Engkau dan susu yang telah",
      "ref_id": "Lukas 11:27",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 24
    },
    {
      "id": 21,
      "diatessaron_verse": "12",
      "ref": "Luke 11:27",
      "arabic_page": 62,
      "text": "menyusui Engkau.\"",
      "ref_id": "Lukas 11:27",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 22,
      "diatessaron_verse": "12",
      "ref": "Luke 11:28",
      "arabic_page": 62,
      "text": "Tetapi Ia berkata: \"Yang berbahagia ialah mereka yang mendengarkan firman Allah dan yang memeliharanya.\"",
      "ref_id": "Lukas 11:28",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 23,
      "diatessaron_verse": "13",
      "ref": "Matthew 12:46",
      "arabic_page": 62,
      "text": "Ketika Yesus masih berbicara dengan orang banyak itu, ibu-Nya dan",
      "ref_id": "Matius 12:46",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 24,
      "diatessaron_verse": "14",
      "ref": "Matthew 12:46",
      "arabic_page": 62,
      "text": "saudara-saudara-Nya berdiri di luar dan berusaha menemui Dia.",
      "ref_id": "Matius 12:46",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 25,
      "diatessaron_verse": "14",
      "ref": "Luke 8:19",
      "arabic_page": 62,
      "text": "Ibu dan saudara-saudara Yesus datang kepada-Nya, tetapi mereka tidak dapat mencapai Dia karena orang banyak.",
      "ref_id": "Lukas 8:19",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 15
    },
    {
      "id": 26,
      "diatessaron_verse": "15",
      "ref": "Mark 3:31",
      "arabic_page": 62,
      "text": "Sementara mereka berdiri di luar, mereka menyuruh orang memanggil Dia.",
      "ref_id": "Markus 3:31",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 10
    },
    {
      "id": 27,
      "diatessaron_verse": "15",
      "ref": "Matthew 12:47",
      "arabic_page": 62,
      "text": "Maka seorang berkata kepada-Nya: \"Lihatlah, ibu-Mu dan saudara-saudara-Mu ada di luar dan berusaha",
      "ref_id": "Matius 12:47",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 28,
      "diatessaron_verse": "16",
      "ref": "Matthew 12:47",
      "arabic_page": 62,
      "text": "menemui Engkau.\"",
      "ref_id": "Matius 12:47",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 29,
      "diatessaron_verse": "16",
      "ref": "Matthew 12:48",
      "arabic_page": 62,
      "text": "Tetapi jawab Yesus kepada orang yang menyampaikan berita itu kepada-Nya:",
      "ref_id": "Matius 12:48",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 30,
      "diatessaron_verse": "17",
      "ref": "Matthew 12:48",
      "arabic_page": 62,
      "text": "\"Siapa ibu-Ku? Dan siapa saudara-saudara-Ku?\"",
      "ref_id": "Matius 12:48",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 31,
      "diatessaron_verse": "17",
      "ref": "Matthew 22:49",
      "arabic_page": 62,
      "text": "Lalu kata-Nya, sambil menunjuk ke arah murid-murid-Nya: \"Ini ibu-Ku dan saudara-saudara-Ku!",
      "ref_id": "Matius 22:49",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 32,
      "diatessaron_verse": "18",
      "ref": "Matthew 12:50",
      "arabic_page": 62,
      "text": "Sebab siapapun yang melakukan kehendak Bapa-Ku di sorga, dialah saudara-Ku laki-laki, dialah saudara-Ku perempuan, dialah ibu-Ku.\"",
      "ref_id": "Matius 12:50",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 33,
      "diatessaron_verse": "19",
      "ref": "Luke 8:1",
      "arabic_page": 63,
      "text": "Tidak lama sesudah itu Yesus berjalan berkeliling dari kota ke kota dan dari desa ke desa memberitakan Injil Kerajaan Allah. Kedua belas murid-Nya bersama-sama dengan Dia,",
      "ref_id": "Lukas 8:1",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 26
    },
    {
      "id": 34,
      "diatessaron_verse": "20",
      "ref": "Luke 8:2",
      "arabic_page": 63,
      "text": "dan juga beberapa orang perempuan yang telah disembuhkan dari roh-roh jahat atau berbagai penyakit,",
      "ref_id": "Lukas 8:2",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 35,
      "diatessaron_verse": "21",
      "ref": "Luke 8:2",
      "arabic_page": 63,
      "text": "yaitu Maria yang disebut Magdalena, yang telah dibebaskan dari tujuh roh jahat,",
      "ref_id": "Lukas 8:2",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 36,
      "diatessaron_verse": "21",
      "ref": "Luke 8:3",
      "arabic_page": 63,
      "text": "Yohana isteri Khuza bendahara Herodes, Susana dan banyak perempuan lain. Perempuan-perempuan ini melayani rombongan itu dengan kekayaan mereka.",
      "ref_id": "Lukas 8:3",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 18
    },
    {
      "id": 37,
      "diatessaron_verse": "22",
      "ref": "Matthew 13:1",
      "arabic_page": 63,
      "text": "Pada hari itu keluarlah Yesus dari rumah itu dan duduk di tepi danau.",
      "ref_id": "Matius 13:1",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 38,
      "diatessaron_verse": "22",
      "ref": "Matthew 13:2",
      "arabic_page": 63,
      "text": "Maka datanglah orang banyak",
      "ref_id": "Matius 13:2",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 39,
      "diatessaron_verse": "23",
      "ref": "Matthew 13:2",
      "arabic_page": 63,
      "text": "berbondong-bondong lalu mengerumuni Dia, sehingga Ia naik ke perahu dan duduk di situ, sedangkan orang banyak semuanya berdiri",
      "ref_id": "Matius 13:2",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 18
    },
    {
      "id": 40,
      "diatessaron_verse": "24",
      "ref": "Matthew 13:2",
      "arabic_page": 63,
      "text": "di pantai.",
      "ref_id": "Matius 13:2",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 41,
      "diatessaron_verse": "24",
      "ref": "Matthew 13:3",
      "arabic_page": 63,
      "text": "Dan Ia mengucapkan banyak hal dalam perumpamaan kepada mereka. Kata-Nya: \"Adalah seorang penabur",
      "ref_id": "Matius 13:3",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 42,
      "diatessaron_verse": "25",
      "ref": "Matthew 13:3",
      "arabic_page": 63,
      "text": "keluar untuk menabur.",
      "ref_id": "Matius 13:3",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 43,
      "diatessaron_verse": "25",
      "ref": "Matthew 13:4",
      "arabic_page": 63,
      "text": "Pada waktu ia menabur, sebagian benih itu jatuh di pinggir jalan,",
      "ref_id": "Matius 13:4",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 44,
      "diatessaron_verse": "26",
      "ref": "Matthew 13:4",
      "arabic_page": 63,
      "text": "lalu datanglah burung dan memakannya sampai habis.",
      "ref_id": "Matius 13:4",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 45,
      "diatessaron_verse": "26",
      "ref": "Matthew 13:5",
      "arabic_page": 63,
      "text": "Sebagian jatuh di tanah yang berbatu-batu, yang tidak banyak tanahnya, lalu benih itupun segera tumbuh, karena",
      "ref_id": "Matius 13:5",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 46,
      "diatessaron_verse": "27",
      "ref": "Matthew 13:5",
      "arabic_page": 63,
      "text": "tanahnya tipis.",
      "ref_id": "Matius 13:5",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 47,
      "diatessaron_verse": "27",
      "ref": "Matthew 13:6",
      "arabic_page": 63,
      "text": "Tetapi sesudah matahari terbit, layulah ia dan menjadi kering karena tidak berakar.",
      "ref_id": "Matius 13:6",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 48,
      "diatessaron_verse": "28",
      "ref": "Matthew 13:7",
      "arabic_page": 63,
      "text": "Sebagian lagi jatuh di tengah semak duri, lalu makin besarlah semak itu",
      "ref_id": "Matius 13:7",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 49,
      "diatessaron_verse": "29",
      "ref": "Matthew 13:7",
      "arabic_page": 63,
      "text": "dan menghimpitnya sampai mati.",
      "ref_id": "Matius 13:7",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 50,
      "diatessaron_verse": "29",
      "ref": "Matthew 13:8",
      "arabic_page": 63,
      "text": "Dan sebagian jatuh di tanah yang baik lalu berbuah: ada yang seratus kali lipat, ada yang enam puluh kali lipat, ada yang tiga puluh kali lipat.",
      "ref_id": "Matius 13:8",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 26
    },
    {
      "id": 51,
      "diatessaron_verse": "30",
      "ref": "Luke 8:8c",
      "arabic_page": 63,
      "text": "Setelah berkata demikian Yesus berseru: \"Siapa mempunyai telinga untuk mendengar, hendaklah ia mendengar!\"",
      "ref_id": "Lukas 8:8c",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 52,
      "diatessaron_verse": "31",
      "ref": "Matthew 13:10",
