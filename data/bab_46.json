    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "John 14:22",
      "arabic_page": null,
      "text": "sebabnya maka Engkau hendak menyatakan diri-Mu kepada kami, dan bukan kepada dunia?\"",
      "ref_id": "Yohanes 14:22",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 12
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "John 14:23",
      "arabic_page": null,
      "text": "Jawab Yesus: \"Jika seorang mengasihi Aku, ia akan menuruti firman-Ku dan Bapa-Ku akan mengasihi dia dan Kami akan datang kepadanya dan diam bersama-sama dengan dia.",
      "ref_id": "Yohanes 14:23",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 25
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "John 14:24",
      "arabic_page": null,
      "text": "Barangsiapa tidak mengasihi Aku, ia tidak menuruti firman-Ku; dan firman yang kamu dengar itu bukanlah dari pada-Ku, melainkan dari Bapa yang mengutus Aku.",
      "ref_id": "Yohanes 14:24",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 23
    },
    {
      "id": 7,
      "diatessaron_verse": "5, 6",
      "ref": "John 14:25",
      "arabic_page": null,
      "text": "Semuanya itu Kukatakan kepadamu, selagi Aku berada bersama-sama dengan kamu;",
      "ref_id": "Yohanes 14:25",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 10
    },
    {
      "id": 8,
      "diatessaron_verse": "5, 6",
      "ref": "John 14:26",
      "arabic_page": null,
      "text": "tetapi Penghibur, yaitu Roh Kudus, yang akan diutus oleh Bapa dalam nama-Ku, Dialah yang akan mengajarkan segala sesuatu kepadamu dan",
      "ref_id": "Yohanes 14:26",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 20
    },
    {
      "id": 9,
      "diatessaron_verse": "7",
      "ref": "John 14:26",
      "arabic_page": 174,
      "text": "akan mengingatkan kamu akan semua yang telah Kukatakan kepadamu. J",
      "ref_id": "Yohanes 14:26",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 10
    },
    {
      "id": 10,
      "diatessaron_verse": "7",
      "ref": "John 14:27",
      "arabic_page": 174,
      "text": "Damai sejahtera Kutinggalkan bagimu. Damai sejahtera-Ku Kuberikan kepadamu, dan apa yang Kuberikan tidak seperti yang diberikan oleh dunia kepadamu.",
      "ref_id": "Yohanes 14:27",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 19
    },
    {
      "id": 11,
      "diatessaron_verse": "8",
      "ref": "John 14:27",
      "arabic_page": 174,
      "text": "Janganlah gelisah dan gentar hatimu.",
      "ref_id": "Yohanes 14:27",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 5
    },
    {
      "id": 12,
      "diatessaron_verse": "8",
      "ref": "John 14:28",
      "arabic_page": 174,
      "text": "Kamu telah mendengar, bahwa Aku telah berkata kepadamu: Aku pergi, tetapi Aku datang kembali kepadamu. Sekiranya kamu mengasihi Aku, kamu tentu akan bersukacita karena Aku pergi kepada",
      "ref_id": "Yohanes 14:28",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 27
    },
    {
      "id": 13,
      "diatessaron_verse": "9",
      "ref": "John 14:28",
      "arabic_page": 174,
      "text": "Bapa-Ku, sebab Bapa lebih besar dari pada Aku.",
      "ref_id": "Yohanes 14:28",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 8
    },
    {
      "id": 14,
      "diatessaron_verse": "9",
      "ref": "John 14:29",
      "arabic_page": 174,
      "text": "Dan sekarang juga Aku mengatakannya kepadamu sebelum hal itu",
