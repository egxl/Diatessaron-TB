      "diatessaron_verse": "70",
      "ref": "Luke 1:69",
      "arabic_page": 6,
      "text": "bagi kita di dalam keturunan Daud, hamba-Nya itu,",
      "ref_id": "Lukas 1:69",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 115,
      "diatessaron_verse": "71",
