      "diatessaron_verse": "76",
      "ref": "Luke 1:75",
      "arabic_page": 6,
      "text": "dalam kekudusan dan kebenaran di hadapan-Nya seumur hidup kita.",
      "ref_id": "Lukas 1:75",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
