      "book_id": "Yohanes",
      "word_count": 4
    },
    {
      "id": 3,
      "diatessaron_verse": "2,3",
      "ref": "John 1:2",
      "arabic_page": null,
      "text": "Ia pada mulanya bersama-sama dengan Allah.",
