      "text": "untuk melepaskan kita dari musuh-musuh kita dan dari tangan semua orang yang membenci kita,",
      "ref_id": "Lukas 1:71",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 117,
      "diatessaron_verse": "73",
      "ref": "Luke 1:72",
      "arabic_page": 6,
      "text": "untuk menunjukkan rahmat-Nya kepada nenek moyang kita dan mengingat akan perjanjian-Nya yang kudus,",
      "ref_id": "Lukas 1:72",
      "book_code": "luk",
