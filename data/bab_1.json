      "arabic_page": 6,
      "text": "--seperti yang telah difirmankan-Nya sejak purbakala oleh mulut nabi-nabi-Nya yang kudus--",
      "ref_id": "Lukas 1:70",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
