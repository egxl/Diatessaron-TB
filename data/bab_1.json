    },
    {
      "id": 4,
      "diatessaron_verse": "2,3",
      "ref": "John 1:3",
      "arabic_page": null,
      "text": "Segala sesuatu dijadikan oleh Dia, dan",
      "ref_id": "Yohanes 1:3",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 6
    },
    {
      "id": 5,
      "diatessaron_verse": "4",
      "ref": "John 1:3",
      "arabic_page": null,
      "text": "tanpa Dia tidak ada suatupun yang telah jadi dari segala yang telah dijadikan.",
      "ref_id": "Yohanes 1:3",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 13
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "John 1:4",
      "arabic_page": null,
      "text": "Dalam Dia ada hidup, dan hidup itu",
      "ref_id": "Yohanes 1:4",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 7
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "John 1:4",
      "arabic_page": null,
      "text": "adalah terang manusia.",
      "ref_id": "Yohanes 1:4",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 3
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "John 1:5",
      "arabic_page": null,
      "text": "Terang itu bercahaya di dalam kegelapan dan kegelapan itu tidak menguasainya.",
      "ref_id": "Yohanes 1:5",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 11
    },
    {
      "id": 9,
      "diatessaron_verse": "6",
      "ref": "Luke 1:5",
      "arabic_page": null,
      "text": "Pada zaman Herodes, raja Yudea, adalah seorang imam yang bernama Zakharia dari rombongan Abia. Isterinya juga berasal dari keturunan Harun, namanya",
      "ref_id": "Lukas 1:5",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 21
    },
    {
      "id": 10,
      "diatessaron_verse": "7",
      "ref": "Luke 1:5",
      "arabic_page": null,
      "text": "Elisabet.",
      "ref_id": "Lukas 1:5",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 1
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "Luke 1:6",
      "arabic_page": null,
      "text": "Keduanya adalah benar di hadapan Allah dan hidup menurut segala perintah,",
      "ref_id": "Lukas 1:6",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 12,
      "diatessaron_verse": "8",
      "ref": "Luke 1:6",
      "arabic_page": null,
      "text": "dan ketetapan Tuhan dengan tidak bercacat.",
      "ref_id": "Lukas 1:6",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "Luke 1:7",
      "arabic_page": null,
      "text": "Tetapi mereka tidak mempunyai anak, sebab",
      "ref_id": "Lukas 1:7",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 14,
      "diatessaron_verse": "9",
      "ref": "Luke 1:7",
      "arabic_page": null,
      "text": "Elisabet mandul dan keduanya telah lanjut umurnya.",
      "ref_id": "Lukas 1:7",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "Luke 1:8",
      "arabic_page": null,
      "text": "Pada suatu kali, waktu tiba giliran rombongannya, Zakharia melakukan",
      "ref_id": "Lukas 1:8",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 16,
      "diatessaron_verse": "10",
      "ref": "Luke 1:8",
      "arabic_page": 2,
      "text": "tugas keimaman di hadapan Tuhan,",
      "ref_id": "Lukas 1:8",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 17,
      "diatessaron_verse": "10",
      "ref": "Luke 1:9",
      "arabic_page": 2,
      "text": "Sebab ketika diundi, sebagaimana lazimnya, untuk menentukan imam yang bertugas, dialah yang ditunjuk untuk masuk ke dalam",
      "ref_id": "Lukas 1:9",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 17
    },
    {
      "id": 18,
      "diatessaron_verse": "11",
      "ref": "Luke 1:9",
      "arabic_page": 2,
      "text": "Bait Suci dan membakar ukupan di situ.",
      "ref_id": "Lukas 1:9",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 19,
      "diatessaron_verse": "11",
      "ref": "Luke 1:10",
      "arabic_page": 2,
      "text": "Sementara itu seluruh umat berkumpul di luar dan sembahyang. Waktu itu adalah",
      "ref_id": "Lukas 1:10",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 20,
      "diatessaron_verse": "12",
      "ref": "Luke 1:10",
      "arabic_page": 2,
      "text": "waktu pembakaran ukupan.",
      "ref_id": "Lukas 1:10",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 21,
      "diatessaron_verse": "12",
      "ref": "Luke 1:11",
      "arabic_page": 2,
      "text": "Maka tampaklah kepada Zakharia seorang malaikat Tuhan berdiri",
      "ref_id": "Lukas 1:11",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 22,
      "diatessaron_verse": "13",
      "ref": "Luke 1:11",
      "arabic_page": 2,
      "text": "di sebelah kanan mezbah pembakaran ukupan.",
      "ref_id": "Lukas 1:11",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 23,
      "diatessaron_verse": "13",
      "ref": "Luke 1:12",
      "arabic_page": 2,
      "text": "Melihat hal itu ia terkejut",
      "ref_id": "Lukas 1:12",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 24,
      "diatessaron_verse": "14",
      "ref": "Luke 1:12",
      "arabic_page": 2,
      "text": "dan menjadi takut.",
      "ref_id": "Lukas 1:12",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 25,
      "diatessaron_verse": "14",
      "ref": "Luke 1:13",
      "arabic_page": 2,
      "text": "Tetapi malaikat itu berkata kepadanya: \"Jangan takut, hai Zakharia, sebab doamu telah dikabulkan dan Elisabet, isterimu, akan melahirkan seorang anak laki-laki bagimu dan haruslah engkau",
      "ref_id": "Lukas 1:13",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 25
    },
    {
      "id": 26,
      "diatessaron_verse": "15",
      "ref": "Luke 1:13",
      "arabic_page": 2,
      "text": "menamai dia Yohanes.",
      "ref_id": "Lukas 1:13",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 27,
      "diatessaron_verse": "15",
      "ref": "Luke 1:14",
      "arabic_page": 2,
      "text": "Engkau akan bersukacita dan bergembira, bahkan banyak orang akan bersukacita",
      "ref_id": "Lukas 1:14",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 28,
      "diatessaron_verse": "16",
      "ref": "Luke 1:14",
      "arabic_page": 2,
      "text": "atas kelahirannya itu.",
      "ref_id": "Lukas 1:14",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 29,
      "diatessaron_verse": "16",
      "ref": "Luke 1:15",
      "arabic_page": 2,
      "text": "Sebab ia akan besar di hadapan Tuhan dan ia tidak akan minum anggur atau minuman keras dan ia akan penuh dengan Roh Kudus mulai dari",
      "ref_id": "Lukas 1:15",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 25
    },
    {
      "id": 30,
      "diatessaron_verse": "17",
      "ref": "Luke 1:15",
      "arabic_page": 2,
      "text": "rahim ibunya;",
      "ref_id": "Lukas 1:15",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 31,
      "diatessaron_verse": "17",
      "ref": "Luke 1:16",
      "arabic_page": 2,
      "text": "ia akan membuat banyak orang Israel berbalik kepada Tuhan,",
      "ref_id": "Lukas 1:16",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 32,
      "diatessaron_verse": "18",
      "ref": "Luke 1:16",
      "arabic_page": 2,
      "text": "Allah mereka,",
      "ref_id": "Lukas 1:16",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 33,
      "diatessaron_verse": "18",
      "ref": "Luke 1:17",
      "arabic_page": 2,
      "text": "dan ia akan berjalan mendahului Tuhan dalam roh dan kuasa Elia untuk membuat hati bapa-bapa berbalik kepada anak-anaknya dan hati orang-orang durhaka kepada pikiran orang-orang benar dan dengan demikian menyiapkan bagi Tuhan suatu umat yang layak bagi-Nya.\"",
      "ref_id": "Lukas 1:17",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 37
    },
    {
      "id": 34,
      "diatessaron_verse": "19",
      "ref": "Luke 1:18",
      "arabic_page": 2,
      "text": "Lalu kata Zakharia kepada malaikat itu: \"Bagaimanakah aku tahu, bahwa hal ini akan terjadi? Sebab aku sudah tua",
      "ref_id": "Lukas 1:18",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 18
    },
    {
      "id": 35,
      "diatessaron_verse": "20",
      "ref": "Luke 1:18",
      "arabic_page": 2,
      "text": "dan isteriku sudah lanjut umurnya.\"",
      "ref_id": "Lukas 1:18",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 5
    },
    {
      "id": 36,
      "diatessaron_verse": "20",
      "ref": "Luke 1:19",
      "arabic_page": 2,
      "text": "Jawab malaikat itu kepadanya: \"Akulah Gabriel yang melayani Allah dan aku telah diutus untuk berbicara dengan engkau dan untuk menyampaikan",
      "ref_id": "Lukas 1:19",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 20
    },
    {
      "id": 37,
      "diatessaron_verse": "21",
      "ref": "Luke 1:19",
      "arabic_page": 2,
      "text": "kabar baik ini kepadamu.",
      "ref_id": "Lukas 1:19",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 38,
      "diatessaron_verse": "21",
      "ref": "Luke 1:20",
      "arabic_page": 2,
      "text": "Sesungguhnya engkau akan menjadi bisu dan tidak dapat berkata-kata sampai kepada hari, di mana semuanya ini terjadi, karena engkau tidak percaya",
      "ref_id": "Lukas 1:20",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 21
    },
    {
      "id": 39,
      "diatessaron_verse": "22",
      "ref": "Luke 1:20",
      "arabic_page": 2,
      "text": "akan perkataanku yang akan nyata kebenarannya pada waktunya.\"",
      "ref_id": "Lukas 1:20",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 40,
      "diatessaron_verse": "22",
      "ref": "Luke 1:21",
      "arabic_page": 3,
      "text": "Sementara itu orang banyak menanti-nantikan Zakharia. Mereka menjadi heran, bahwa ia begitu lama berada dalam Bait Suci.",
      "ref_id": "Lukas 1:21",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 17
    },
    {
      "id": 41,
      "diatessaron_verse": "23",
      "ref": "Luke 1:22",
      "arabic_page": 3,
      "text": "Ketika ia keluar, ia tidak dapat berkata-kata kepada mereka dan mengertilah mereka, bahwa ia telah melihat suatu penglihatan di dalam Bait Suci. Lalu ia memberi isyarat kepada mereka,",
      "ref_id": "Lukas 1:22",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 28
    },
    {
      "id": 42,
      "diatessaron_verse": "24",
      "ref": "Luke 1:22",
      "arabic_page": 3,
      "text": "sebab ia tetap bisu.",
      "ref_id": "Lukas 1:22",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 43,
      "diatessaron_verse": "24",
      "ref": "Luke 1:23",
      "arabic_page": 3,
      "text": "Ketika selesai jangka waktu tugas jabatannya, ia pulang ke rumah.",
      "ref_id": "Lukas 1:23",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 44,
      "diatessaron_verse": "25",
      "ref": "Luke 1:24",
      "arabic_page": 3,
      "text": "Beberapa lama kemudian Elisabet, isterinya, mengandung dan selama lima",
      "ref_id": "Lukas 1:24",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 45,
      "diatessaron_verse": "26",
      "ref": "Luke 1:24",
      "arabic_page": 3,
      "text": "bulan ia tidak menampakkan diri, katanya:",
      "ref_id": "Lukas 1:24",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 46,
      "diatessaron_verse": "26",
      "ref": "Luke 1:25",
      "arabic_page": 3,
      "text": "\"Inilah suatu perbuatan Tuhan bagiku, dan sekarang Ia berkenan menghapuskan aibku di depan orang.\"",
      "ref_id": "Lukas 1:25",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 47,
      "diatessaron_verse": "27",
      "ref": "Luke 1:26",
      "arabic_page": 3,
      "text": "Dalam bulan yang keenam Allah menyuruh malaikat Gabriel pergi ke sebuah kota",
      "ref_id": "Lukas 1:26",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 48,
      "diatessaron_verse": "28",
      "ref": "Luke 1:26",
      "arabic_page": 3,
      "text": "di Galilea bernama Nazaret,",
      "ref_id": "Lukas 1:26",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 49,
      "diatessaron_verse": "28",
      "ref": "Luke 1:27",
      "arabic_page": 3,
      "text": "kepada seorang perawan yang bertunangan dengan seorang bernama Yusuf dari",
      "ref_id": "Lukas 1:27",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 50,
      "diatessaron_verse": "29",
      "ref": "Luke 1:27",
      "arabic_page": 3,
      "text": "keluarga Daud; nama perawan itu Maria.",
      "ref_id": "Lukas 1:27",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 51,
      "diatessaron_verse": "29",
      "ref": "Luke 1:28",
      "arabic_page": 3,
      "text": "Ketika malaikat itu masuk ke rumah Maria, ia berkata: \"Salam, hai engkau yang dikaruniai, Tuhan",
      "ref_id": "Lukas 1:28",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 15
    },
    {
      "id": 52,
      "diatessaron_verse": "30",
      "ref": "Luke 1:28",
      "arabic_page": 3,
      "text": "menyertai engkau.\"",
      "ref_id": "Lukas 1:28",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 53,
      "diatessaron_verse": "30",
      "ref": "Luke 1:29",
      "arabic_page": 3,
      "text": "Maria terkejut mendengar perkataan itu, lalu bertanya",
      "ref_id": "Lukas 1:29",
