      "ref": "Luke 1:65",
      "arabic_page": 5,
      "text": "Maka ketakutanlah semua orang yang tinggal di sekitarnya, dan segala peristiwa itu menjadi buah tutur di seluruh",
      "ref_id": "Lukas 1:65",
      "book_code": "luk",
