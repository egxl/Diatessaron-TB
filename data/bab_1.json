      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 110,
      "diatessaron_verse": "67",
      "ref": "Luke 1:66",
      "arabic_page": 5,
      "text": "Dan semua orang, yang mendengarnya, merenungkannya dan berkata: \"Menjadi apakah anak ini nanti?\" Sebab tangan Tuhan menyertai dia.",
      "ref_id": "Lukas 1:66",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 18
    },
    {
      "id": 111,
      "diatessaron_verse": "68",
      "ref": "Luke 1:67",
      "arabic_page": 5,
      "text": "Dan Zakharia, ayahnya, penuh dengan Roh Kudus, lalu bernubuat, katanya:",
      "ref_id": "Lukas 1:67",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 112,
      "diatessaron_verse": "69",
      "ref": "Luke 1:68",
      "arabic_page": 5,
      "text": "\"Terpujilah Tuhan, Allah Israel, sebab Ia melawat umat-Nya dan membawa kelepasan baginya,",
      "ref_id": "Lukas 1:68",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
