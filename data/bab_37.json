      "diatessaron_verse": "10",
      "ref": "John 10:7",
      "arabic_page": 140,
      "text": "Maka kata Yesus sekali lagi: \"Aku berkata kepadamu, sesungguhnya Akulah pintu ke",
      "ref_id": "Yohanes 10:7",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 12
    },
    {
      "id": 17,
      "diatessaron_verse": "11",
      "ref": "John 10:7",
      "arabic_page": 140,
      "text": "domba-domba itu.",
      "ref_id": "Yohanes 10:7",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 2
    },
    {
      "id": 18,
      "diatessaron_verse": "11",
      "ref": "John 10:8",
      "arabic_page": 140,
      "text": "Semua orang yang datang sebelum Aku, adalah pencuri dan perampok, dan domba-domba itu tidak mendengarkan mereka.",
