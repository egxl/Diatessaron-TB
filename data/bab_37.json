      "diatessaron_verse": "9",
      "ref": "John 10:5",
      "arabic_page": 140,
      "text": "padanya, karena suara orang-orang asing tidak mereka kenal.\"",
      "ref_id": "Yohanes 10:5",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 8
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "John 10:6",
      "arabic_page": 140,
      "text": "Itulah yang dikatakan Yesus dalam perumpamaan kepada mereka, tetapi mereka tidak mengerti apa maksudnya Ia berkata demikian kepada mereka.",
      "ref_id": "Yohanes 10:6",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 19
    },
    {
