      "word_count": 4
    },
    {
      "id": 23,
      "diatessaron_verse": "14",
      "ref": "John 10:11",
      "arabic_page": 140,
      "text": "Akulah gembala yang baik. Gembala yang baik memberikan",
      "ref_id": "Yohanes 10:11",
