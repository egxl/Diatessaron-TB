      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 19
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "John 10:1",
      "arabic_page": 140,
      "text": "Aku berkata kepadamu: Sesungguhnya siapa yang masuk ke dalam kandang domba dengan tidak melalui pintu, tetapi dengan memanjat tembok, ia adalah seorang pencuri dan seorang",
      "ref_id": "Yohanes 10:1",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 25
    },
    {
