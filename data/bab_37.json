      "diatessaron_verse": "41",
      "ref": "John 10:38",
      "arabic_page": 142,
      "text": "tetapi jikalau Aku melakukannya dan kamu tidak mau percaya kepada-Ku, percayalah akan pekerjaan-pekerjaan itu, supaya kamu boleh mengetahui dan mengerti, bahwa Bapa di dalam Aku dan Aku di dalam Bapa.\"",
      "ref_id": "Yohanes 10:38",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 30
