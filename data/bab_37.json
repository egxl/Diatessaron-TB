      "diatessaron_verse": "5, 6",
      "ref": "John 10:1",
      "arabic_page": 140,
      "text": "perampok;",
      "ref_id": "Yohanes 10:1",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 1
    },
    {
      "id": 8,
      "diatessaron_verse": "5, 6",
      "ref": "John 10:2",
      "arabic_page": 140,
      "text": "tetapi siapa yang masuk melalui pintu, ia adalah gembala domba.",
      "ref_id": "Yohanes 10:2",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 10
    },
    {
      "id": 9,
      "diatessaron_verse": "5, 6",
      "ref": "John 10:3",
      "arabic_page": 140,
      "text": "Untuk dia penjaga membuka pintu dan domba-domba mendengarkan suaranya",
      "ref_id": "Yohanes 10:3",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 9
    },
    {
      "id": 10,
      "diatessaron_verse": "7",
      "ref": "John 10:3",
      "arabic_page": 140,
      "text": "dan ia memanggil domba-dombanya masing-masing menurut namanya dan menuntunnya ke luar.",
      "ref_id": "Yohanes 10:3",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 11
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "John 10:4",
      "arabic_page": 140,
      "text": "Jika semua dombanya telah dibawanya ke luar, ia berjalan di depan mereka dan domba-domba itu mengikuti dia, karena",
      "ref_id": "Yohanes 10:4",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 18
    },
    {
      "id": 12,
      "diatessaron_verse": "8",
      "ref": "John 10:4",
      "arabic_page": 140,
      "text": "mereka mengenal suaranya.",
      "ref_id": "Yohanes 10:4",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 3
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "John 10:5",
      "arabic_page": 140,
      "text": "Tetapi seorang asing pasti tidak mereka ikuti, malah mereka lari dari",
      "ref_id": "Yohanes 10:5",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 11
    },
