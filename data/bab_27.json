  "verses": [
    {
      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Matthew 18:23",
      "arabic_page": null,
      "text": "Sebab hal Kerajaan Sorga seumpama seorang raja yang hendak mengadakan",
      "ref_id": "Matius 18:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Matthew 18:23",
      "arabic_page": null,
      "text": "perhitungan dengan hamba-hambanya.",
      "ref_id": "Matius 18:23",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Matthew 18:24",
      "arabic_page": null,
      "text": "Setelah ia mulai mengadakan perhitungan itu, dihadapkanlah kepadanya seorang yang",
      "ref_id": "Matius 18:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 10
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Matthew 18:24",
      "arabic_page": null,
      "text": "berhutang sepuluh ribu talenta.",
      "ref_id": "Matius 18:24",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "Matthew 18:25",
      "arabic_page": null,
      "text": "Tetapi karena orang itu tidak mampu melunaskan hutangnya, raja itu memerintahkan supaya ia dijual beserta anak isterinya",
      "ref_id": "Matius 18:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Matthew 18:25",
      "arabic_page": null,
      "text": "dan segala miliknya untuk pembayar hutangnya.",
      "ref_id": "Matius 18:25",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 7,
      "diatessaron_verse": "4",
      "ref": "Matthew 18:26",
      "arabic_page": null,
      "text": "Maka sujudlah hamba itu menyembah dia, katanya: Sabarlah dahulu, segala hutangku akan kulunaskan.",
      "ref_id": "Matius 18:26",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Matthew 18:27",
      "arabic_page": null,
      "text": "Lalu tergeraklah hati raja itu oleh belas kasihan akan hamba itu, sehingga ia membebaskannya dan menghapuskan",
      "ref_id": "Matius 18:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 16
    },
    {
      "id": 9,
      "diatessaron_verse": "6",
      "ref": "Matthew 18:27",
      "arabic_page": null,
      "text": "hutangnya.",
      "ref_id": "Matius 18:27",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 1
    },
    {
      "id": 10,
      "diatessaron_verse": "6",
      "ref": "Matthew 18:28",
      "arabic_page": 104,
      "text": "Tetapi ketika hamba itu keluar, ia bertemu dengan seorang hamba lain yang berhutang seratus dinar kepadanya. Ia menangkap dan mencekik kawannya itu,",
      "ref_id": "Matius 18:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 22
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "Matthew 18:28",
      "arabic_page": 104,
      "text": "katanya: Bayar hutangmu!",
      "ref_id": "Matius 18:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 12,
      "diatessaron_verse": "7",
      "ref": "Matthew 18:29",
      "arabic_page": 104,
      "text": "Maka sujudlah kawannya itu",
      "ref_id": "Matius 18:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "Matthew 18:29",
      "arabic_page": 104,
      "text": "dan memohon kepadanya: Sabarlah dahulu, hutangku itu akan kulunaskan.",
      "ref_id": "Matius 18:29",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 14,
      "diatessaron_verse": "8",
      "ref": "Matthew 18:30",
      "arabic_page": 104,
      "text": "Tetapi ia menolak dan menyerahkan kawannya itu ke dalam penjara sampai dilunaskannya hutangnya.",
      "ref_id": "Matius 18:30",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "Matthew 18:31",
      "arabic_page": 104,
      "text": "Melihat itu kawan-kawannya yang lain sangat sedih lalu",
      "ref_id": "Matius 18:31",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 16,
      "diatessaron_verse": "10",
      "ref": "Matthew 18:31",
      "arabic_page": 104,
      "text": "menyampaikan segala yang terjadi kepada tuan mereka.",
      "ref_id": "Matius 18:31",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 17,
      "diatessaron_verse": "10",
      "ref": "Matthew 18:32",
      "arabic_page": 104,
      "text": "Raja itu menyuruh memanggil orang itu dan berkata kepadanya: Hai hamba yang jahat, seluruh hutangmu telah kuhapuskan",
      "ref_id": "Matius 18:32",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 17
    },
    {
      "id": 18,
      "diatessaron_verse": "11",
      "ref": "Matthew 18:32",
      "arabic_page": 104,
      "text": "karena engkau memohonkannya kepadaku.",
      "ref_id": "Matius 18:32",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 4
    },
    {
      "id": 19,
      "diatessaron_verse": "11",
      "ref": "Matthew 18:33",
      "arabic_page": 104,
      "text": "Bukankah engkaupun harus",
      "ref_id": "Matius 18:33",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 20,
      "diatessaron_verse": "12",
      "ref": "Matthew 18:33",
      "arabic_page": 104,
      "text": "mengasihani kawanmu seperti aku telah mengasihani engkau?",
      "ref_id": "Matius 18:33",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 7
    },
    {
      "id": 21,
      "diatessaron_verse": "12",
      "ref": "Matthew 18:34",
      "arabic_page": 104,
      "text": "Maka marahlah tuannya itu dan",
      "ref_id": "Matius 18:34",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 22,
      "diatessaron_verse": "13",
      "ref": "Matthew 18:34",
      "arabic_page": 104,
      "text": "menyerahkannya kepada algojo-algojo, sampai ia melunaskan seluruh hutangnya.",
      "ref_id": "Matius 18:34",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 8
    },
    {
      "id": 23,
      "diatessaron_verse": "13",
      "ref": "Matthew 18:35",
      "arabic_page": 104,
      "text": "Maka Bapa-Ku yang di sorga akan berbuat demikian juga terhadap kamu, apabila kamu masing-masing tidak mengampuni saudaramu dengan",
      "ref_id": "Matius 18:35",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 18
    },
    {
      "id": 24,
      "diatessaron_verse": "14",
      "ref": "Matthew 18:35",
      "arabic_page": 104,
      "text": "segenap hatimu.\"",
      "ref_id": "Matius 18:35",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 25,
      "diatessaron_verse": "14",
      "ref": "Luke 17:3",
      "arabic_page": 104,
      "text": "Jagalah dirimu! Jikalau saudaramu berbuat dosa, tegorlah dia, dan jikalau ia menyesal,",
      "ref_id": "Lukas 17:3",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 26,
      "diatessaron_verse": "15",
      "ref": "Luke 17:3",
      "arabic_page": 104,
      "text": "ampunilah dia.",
      "ref_id": "Lukas 17:3",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 27,
      "diatessaron_verse": "15",
      "ref": "Luke 17:4",
      "arabic_page": 104,
      "text": "Bahkan jikalau ia berbuat dosa terhadap engkau tujuh kali sehari dan tujuh kali ia kembali kepadamu dan berkata: Aku menyesal, engkau harus mengampuni dia.\"",
      "ref_id": "Lukas 17:4",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 24
    },
    {
      "id": 28,
      "diatessaron_verse": "16",
      "ref": "Matthew 18:15",
      "arabic_page": 104,
      "text": "\"Apabila saudaramu berbuat dosa, tegorlah dia",
      "ref_id": "Matius 18:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 6
    },
    {
      "id": 29,
      "diatessaron_verse": "17",
      "ref": "Matthew 18:15",
      "arabic_page": 104,
      "text": "di bawah empat mata. Jika ia mendengarkan nasihatmu engkau telah mendapatnya kembali.",
      "ref_id": "Matius 18:15",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 30,
      "diatessaron_verse": "17",
      "ref": "Matthew 18:16",
      "arabic_page": 104,
      "text": "Jika ia tidak mendengarkan engkau, bawalah seorang atau dua orang lagi, supaya atas keterangan dua atau tiga orang saksi, perkara itu",
      "ref_id": "Matius 18:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 21
    },
    {
      "id": 31,
      "diatessaron_verse": "18",
      "ref": "Matthew 18:16",
      "arabic_page": 104,
      "text": "tidak disangsikan.",
      "ref_id": "Matius 18:16",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 2
    },
    {
      "id": 32,
      "diatessaron_verse": "18",
      "ref": "Matthew 18:17",
      "arabic_page": 104,
      "text": "Jika ia tidak mau mendengarkan mereka, sampaikanlah soalnya kepada jemaat. Dan jika ia tidak mau juga mendengarkan jemaat, pandanglah dia sebagai seorang yang tidak mengenal Allah atau seorang pemungut cukai.",
      "ref_id": "Matius 18:17",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 30
    },
    {
      "id": 33,
      "diatessaron_verse": "19",
      "ref": "Matthew 18:18",
      "arabic_page": 104,
      "text": "Aku berkata kepadamu: Sesungguhnya apa yang kamu ikat di dunia ini akan terikat di sorga",
      "ref_id": "Matius 18:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 15
    },
    {
      "id": 34,
      "diatessaron_verse": "20",
      "ref": "Matthew 18:18",
      "arabic_page": 104,
      "text": "dan apa yang kamu lepaskan di dunia ini akan terlepas di sorga.",
      "ref_id": "Matius 18:18",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 35,
      "diatessaron_verse": "20",
      "ref": "Matthew 18:19",
      "arabic_page": 104,
      "text": "Dan lagi Aku berkata kepadamu: Jika dua orang dari padamu di dunia ini sepakat meminta apapun juga, permintaan mereka itu akan dikabulkan oleh Bapa-Ku",
      "ref_id": "Matius 18:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 24
    },
    {
      "id": 36,
      "diatessaron_verse": "21",
      "ref": "Matthew 18:19",
      "arabic_page": 105,
      "text": "yang di sorga.",
      "ref_id": "Matius 18:19",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 37,
      "diatessaron_verse": "21",
      "ref": "Matthew 18:20",
      "arabic_page": 105,
      "text": "Sebab di mana dua atau tiga orang berkumpul dalam Nama-Ku, di situ",
      "ref_id": "Matius 18:20",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 12
    },
    {
      "id": 38,
      "diatessaron_verse": "22",
      "ref": "Matthew 18:20",
      "arabic_page": 105,
      "text": "Aku ada di tengah-tengah mereka.\"",
      "ref_id": "Matius 18:20",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 39,
      "diatessaron_verse": "22",
      "ref": "Matthew 18:21",
      "arabic_page": 105,
      "text": "Kemudian datanglah Petrus dan berkata kepada Yesus: \"Tuhan, sampai berapa kali aku harus mengampuni saudaraku jika ia berbuat dosa terhadap aku?",
      "ref_id": "Matius 18:21",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 21
    },
    {
      "id": 40,
      "diatessaron_verse": "23",
      "ref": "Matthew 18:21",
      "arabic_page": 105,
      "text": "Sampai tujuh kali?\"",
      "ref_id": "Matius 18:21",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 3
    },
    {
      "id": 41,
      "diatessaron_verse": "23",
      "ref": "Matthew 18:22",
      "arabic_page": 105,
      "text": "Yesus berkata kepadanya: \"Bukan! Aku berkata kepadamu: Bukan sampai tujuh kali, melainkan sampai",
      "ref_id": "Matius 18:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 13
    },
    {
      "id": 42,
      "diatessaron_verse": "24",
      "ref": "Matthew 18:22",
      "arabic_page": 105,
      "text": "tujuh puluh kali tujuh kali.",
      "ref_id": "Matius 18:22",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 43,
      "diatessaron_verse": "24",
      "ref": "Luke 12:47",
      "arabic_page": 105,
      "text": "Adapun hamba yang tahu akan kehendak tuannya, tetapi yang tidak",
      "ref_id": "Lukas 12:47",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 44,
      "diatessaron_verse": "25",
      "ref": "Luke 12:47",
      "arabic_page": 105,
      "text": "mengadakan persiapan atau tidak melakukan apa yang dikehendaki tuannya, ia akan menerima banyak pukulan.",
      "ref_id": "Lukas 12:47",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 45,
      "diatessaron_verse": "25",
      "ref": "Luke 12:48",
      "arabic_page": 105,
      "text": "Tetapi barangsiapa tidak tahu akan kehendak tuannya dan melakukan apa yang harus mendatangkan pukulan, ia akan menerima sedikit pukulan. Setiap orang yang kepadanya banyak diberi, dari padanya akan banyak dituntut, dan kepada siapa yang banyak dipercayakan,",
      "ref_id": "Lukas 12:48",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 36
    },
    {
      "id": 46,
      "diatessaron_verse": "26",
      "ref": "Luke 12:48",
      "arabic_page": 105,
      "text": "dari padanya akan lebih banyak lagi dituntut.\"",
      "ref_id": "Lukas 12:48",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 47,
      "diatessaron_verse": "26",
      "ref": "Luke 12:49",
      "arabic_page": 105,
      "text": "\"Aku datang untuk melemparkan api ke bumi dan betapakah Aku harapkan,",
      "ref_id": "Lukas 12:49",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 48,
      "diatessaron_verse": "27",
      "ref": "Luke 12:49",
      "arabic_page": 105,
      "text": "api itu telah menyala!",
      "ref_id": "Lukas 12:49",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 49,
      "diatessaron_verse": "27",
      "ref": "Luke 12:50",
      "arabic_page": 105,
      "text": "Aku harus menerima baptisan, dan betapakah susahnya hati-Ku,",
      "ref_id": "Lukas 12:50",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 50,
      "diatessaron_verse": "28",
      "ref": "Luke 12:50",
      "arabic_page": 105,
      "text": "sebelum hal itu berlangsung!",
      "ref_id": "Lukas 12:50",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 51,
      "diatessaron_verse": "28",
      "ref": "Matthew 18:10",
      "arabic_page": 105,
      "text": "Ingatlah, jangan menganggap rendah seorang dari anak-anak kecil ini. Karena Aku berkata kepadamu: Ada malaikat mereka di sorga yang selalu memandang",
      "ref_id": "Matius 18:10",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 21
    },
    {
      "id": 52,
      "diatessaron_verse": "29",
      "ref": "Matthew 18:10",
      "arabic_page": 105,
      "text": "wajah Bapa-Ku yang di sorga.",
      "ref_id": "Matius 18:10",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 5
    },
    {
      "id": 53,
      "diatessaron_verse": "29",
