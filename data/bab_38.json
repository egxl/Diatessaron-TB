    {
      "id": 54,
      "diatessaron_verse": "30",
      "ref": "John 11:45",
      "arabic_page": 145,
      "text": "percaya kepada-Nya.",
      "ref_id": "Yohanes 11:45",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 2
    },
    {
      "id": 55,
      "diatessaron_verse": "30",
      "ref": "John 11:46",
      "arabic_page": 145,
      "text": "Tetapi ada yang pergi kepada orang-orang Farisi dan menceriterakan kepada mereka, apa yang telah dibuat Yesus itu.",
      "ref_id": "Yohanes 11:46",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 17
    },
    {
      "id": 56,
      "diatessaron_verse": "31",
      "ref": "John 11:47",
      "arabic_page": 145,
      "text": "Lalu imam-imam kepala dan orang-orang Farisi memanggil Mahkamah Agama untuk berkumpul dan mereka berkata: \"Apakah yang harus kita buat?",
      "ref_id": "Yohanes 11:47",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 19
    },
    {
      "id": 57,
      "diatessaron_verse": "32",
      "ref": "John 11:47",
      "arabic_page": 145,
      "text": "Sebab orang itu membuat banyak mujizat.",
      "ref_id": "Yohanes 11:47",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 6
    },
    {
      "id": 58,
      "diatessaron_verse": "32",
      "ref": "John 11:48",
      "arabic_page": 145,
      "text": "Apabila kita biarkan Dia, maka semua orang akan percaya",
      "ref_id": "Yohanes 11:48",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 9
    },
    {
      "id": 59,
      "diatessaron_verse": "33",
      "ref": "John 11:48",
      "arabic_page": 145,
      "text": "kepada-Nya dan orang-orang Roma akan datang dan akan merampas tempat suci kita serta bangsa kita.\"",
      "ref_id": "Yohanes 11:48",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 15
    },
    {
      "id": 60,
      "diatessaron_verse": "33",
      "ref": "John 11:49",
      "arabic_page": 145,
      "text": "Tetapi seorang di antara mereka, yaitu Kayafas, Imam Besar pada tahun itu, berkata kepada mereka: \"Kamu tidak tahu apa-apa,",
      "ref_id": "Yohanes 11:49",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 19
    },
    {
      "id": 61,
      "diatessaron_verse": "34",
      "ref": "John 11:50",
      "arabic_page": 145,
      "text": "dan kamu tidak insaf, bahwa lebih berguna bagimu, jika",
      "ref_id": "Yohanes 11:50",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 9
    },
    {
      "id": 62,
      "diatessaron_verse": "35",
      "ref": "John 11:50",
      "arabic_page": 145,
      "text": "satu orang mati untuk bangsa kita dari pada seluruh bangsa kita ini binasa.\"",
      "ref_id": "Yohanes 11:50",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 13
    },
    {
      "id": 63,
      "diatessaron_verse": "35",
      "ref": "John 11:51",
      "arabic_page": 145,
      "text": "Hal itu dikatakannya bukan dari dirinya sendiri, tetapi sebagai Imam Besar pada tahun itu ia",
      "ref_id": "Yohanes 11:51",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 15
    },
    {
      "id": 64,
      "diatessaron_verse": "36",
      "ref": "John 11:51",
      "arabic_page": 145,
      "text": "bernubuat, bahwa Yesus akan mati untuk bangsa itu,",
      "ref_id": "Yohanes 11:51",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 8
    },
    {
      "id": 65,
      "diatessaron_verse": "36",
      "ref": "John 11:52",
      "arabic_page": 145,
      "text": "dan bukan untuk bangsa itu saja, tetapi juga untuk mengumpulkan dan mempersatukan anak-anak Allah yang tercerai-berai.",
      "ref_id": "Yohanes 11:52",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 16
    },
    {
      "id": 66,
      "diatessaron_verse": "37",
      "ref": "John 11:53",
      "arabic_page": 145,
      "text": "Mulai dari hari itu mereka sepakat untuk membunuh Dia.",
      "ref_id": "Yohanes 11:53",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 9
    },
    {
      "id": 67,
      "diatessaron_verse": "38",
      "ref": "John 11:54",
      "arabic_page": 146,
      "text": "Karena itu Yesus tidak tampil lagi di muka umum di antara orang-orang Yahudi, Ia berangkat dari situ ke daerah dekat padang gurun, ke sebuah kota yang bernama Efraim, dan di situ Ia",
      "ref_id": "Yohanes 11:54",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 32
    },
    {
      "id": 68,
      "diatessaron_verse": "39",
      "ref": "John 11:54",
      "arabic_page": 146,
      "text": "tinggal bersama-sama murid-murid-Nya.",
      "ref_id": "Yohanes 11:54",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 3
    },
    {
      "id": 69,
      "diatessaron_verse": "39",
      "ref": "John 11:55",
      "arabic_page": 146,
      "text": "Pada waktu itu hari raya Paskah orang Yahudi sudah dekat dan banyak orang dari negeri itu",
      "ref_id": "Yohanes 11:55",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 16
    },
    {
      "id": 70,
      "diatessaron_verse": "40",
      "ref": "John 11:55",
      "arabic_page": 146,
      "text": "berangkat ke Yerusalem untuk menyucikan diri sebelum Paskah itu.",
      "ref_id": "Yohanes 11:55",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 9
    },
    {
      "id": 71,
      "diatessaron_verse": "40",
      "ref": "John 11:56",
      "arabic_page": 146,
      "text": "Mereka mencari Yesus dan sambil berdiri di dalam Bait Allah, mereka berkata seorang kepada yang lain: \"Bagaimana pendapatmu?",
      "ref_id": "Yohanes 11:56",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 18
    },
    {
      "id": 72,
      "diatessaron_verse": "41",
      "ref": "John 11:56",
      "arabic_page": 146,
      "text": "Akan datang jugakah Ia ke pesta?\"",
      "ref_id": "Yohanes 11:56",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 6
    },
    {
      "id": 73,
      "diatessaron_verse": "41",
      "ref": "John 11:57",
      "arabic_page": 146,
      "text": "Sementara itu imam-imam kepala dan orang-orang Farisi telah memberikan perintah supaya setiap orang yang tahu di mana Dia berada memberitahukannya, agar mereka dapat menangkap Dia.",
      "ref_id": "Yohanes 11:57",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 25
    },
    {
      "id": 74,
      "diatessaron_verse": "42",
      "ref": "Luke 9:51",
      "arabic_page": 146,
      "text": "Ketika hampir genap waktunya Yesus diangkat ke sorga,",
      "ref_id": "Lukas 9:51",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 75,
      "diatessaron_verse": "43",
      "ref": "Luke 9:51",
      "arabic_page": 146,
      "text": "Ia mengarahkan pandangan-Nya untuk pergi ke Yerusalem,",
      "ref_id": "Lukas 9:51",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 76,
      "diatessaron_verse": "43",
      "ref": "Luke 9:52",
      "arabic_page": 146,
      "text": "dan Ia mengirim beberapa utusan mendahului Dia. Mereka itu pergi, lalu",
      "ref_id": "Lukas 9:52",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 77,
      "diatessaron_verse": "44",
      "ref": "Luke 9:52",
      "arabic_page": 146,
      "text": "masuk ke suatu desa orang Samaria untuk mempersiapkan segala sesuatu bagi-Nya.",
      "ref_id": "Lukas 9:52",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 78,
      "diatessaron_verse": "44",
      "ref": "Luke 9:53",
      "arabic_page": 146,
      "text": "Tetapi orang-orang Samaria itu tidak mau",
      "ref_id": "Lukas 9:53",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 79,
      "diatessaron_verse": "45",
      "ref": "Luke 9:53",
      "arabic_page": 146,
      "text": "menerima Dia, karena perjalanan-Nya menuju Yerusalem.",
      "ref_id": "Lukas 9:53",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 80,
      "diatessaron_verse": "45",
      "ref": "Luke 9:54",
      "arabic_page": 146,
      "text": "Ketika dua murid-Nya, yaitu Yakobus dan Yohanes, melihat hal itu, mereka berkata: \"Tuhan, apakah Engkau mau, supaya kami menyuruh api turun dari langit untuk membinasakan mereka?\"",
      "ref_id": "Lukas 9:54",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 26
    },
    {
      "id": 81,
      "diatessaron_verse": "46",
      "ref": "Luke 9:55",
      "arabic_page": 146,
      "text": "Akan tetapi Ia berpaling dan menegor mereka [dan berkata, \"Kamu tidak memahami, dari roh semacam apa kamu berasal!]",
      "ref_id": "Lukas 9:55",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 18
    },
    {
      "id": 82,
      "diatessaron_verse": "47",
      "ref": "Luke 9:56",
      "arabic_page": 146,
      "text": "[Sebab Anak Manusia datang tidak untuk membinasakan jiwa manusia, tetapi untuk menyelamatkannya.\"] Lalu mereka pergi ke desa yang lain.",
      "ref_id": "Lukas 9:56",
