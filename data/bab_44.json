      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 31
    },
    {
      "id": 19,
      "diatessaron_verse": "11",
      "ref": "John 13:1",
      "arabic_page": 167,
      "text": "Sementara itu sebelum hari raya Paskah mulai, Yesus telah tahu, bahwa saat-Nya sudah tiba untuk beralih dari dunia ini kepada Bapa. Sama seperti Ia senantiasa mengasihi murid-murid-Nya demikianlah sekarang Ia mengasihi mereka sampai",
      "ref_id": "Yohanes 13:1",
      "book_code": "yoh",
      "book_en": "John",
