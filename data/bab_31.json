    {
      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Mark 10:41",
      "arabic_page": null,
      "text": "Mendengar itu kesepuluh murid yang lain menjadi marah kepada Yakobus dan Yohanes.",
      "ref_id": "Markus 10:41",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 12
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Mark 10:42",
      "arabic_page": null,
      "text": "Tetapi Yesus memanggil mereka lalu berkata: \"Kamu tahu, bahwa mereka yang disebut",
      "ref_id": "Markus 10:42",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 12
    },
    {
      "id": 3,
      "diatessaron_verse": "3",
      "ref": "Mark 10:42",
      "arabic_page": null,
      "text": "pemerintah bangsa-bangsa memerintah rakyatnya dengan tangan besi, dan pembesar-pembesarnya menjalankan kuasanya dengan keras atas mereka.",
      "ref_id": "Markus 10:42",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 15
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "Mark 10:43",
      "arabic_page": 118,
      "text": "Tidaklah demikian di antara kamu. Barangsiapa ingin menjadi besar di antara kamu, hendaklah ia menjadi",
      "ref_id": "Markus 10:43",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 15
    },
    {
      "id": 5,
      "diatessaron_verse": "4",
      "ref": "Mark 10:43",
      "arabic_page": 118,
      "text": "pelayanmu,",
      "ref_id": "Markus 10:43",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 1
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Mark 10:44",
      "arabic_page": 118,
      "text": "dan barangsiapa ingin menjadi yang terkemuka di antara kamu, hendaklah ia menjadi",
      "ref_id": "Markus 10:44",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 12
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "Mark 10:44",
      "arabic_page": 118,
      "text": "hamba untuk semuanya.",
      "ref_id": "Markus 10:44",
      "book_code": "mrk",
      "book_en": "Mark",
      "book_id": "Markus",
      "word_count": 3
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "Matthew 20:28",
      "arabic_page": 118,
      "text": "sama seperti Anak Manusia datang bukan untuk dilayani, melainkan untuk melayani",
      "ref_id": "Matius 20:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 11
    },
    {
      "id": 9,
      "diatessaron_verse": "6",
      "ref": "Matthew 20:28",
      "arabic_page": 118,
      "text": "dan untuk memberikan nyawa-Nya menjadi tebusan bagi banyak orang.\"",
      "ref_id": "Matius 20:28",
      "book_code": "mat",
      "book_en": "Matthew",
      "book_id": "Matius",
      "word_count": 9
    },
    {
      "id": 10,
      "diatessaron_verse": "6",
      "ref": "Luke 13:22",
      "arabic_page": 118,
      "text": "Kemudian Yesus berjalan keliling",
      "ref_id": "Lukas 13:22",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "Luke 13:22",
      "arabic_page": 118,
      "text": "dari kota ke kota dan dari desa ke desa sambil mengajar dan meneruskan perjalanan-Nya ke Yerusalem.",
      "ref_id": "Lukas 13:22",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 16
    },
    {
      "id": 12,
      "diatessaron_verse": "7",
      "ref": "Luke 13:23",
      "arabic_page": 118,
      "text": "Dan ada seorang yang berkata kepada-Nya: \"Tuhan, sedikit sajakah orang yang diselamatkan?\"",
      "ref_id": "Lukas 13:23",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 13,
      "diatessaron_verse": "7",
      "ref": "Luke 13:24",
      "arabic_page": 118,
      "text": "Jawab Yesus kepada",
      "ref_id": "Lukas 13:24",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 14,
      "diatessaron_verse": "8",
      "ref": "Luke 13:24",
      "arabic_page": 118,
      "text": "orang-orang di situ: \"Berjuanglah untuk masuk melalui pintu yang sesak itu! Sebab Aku berkata kepadamu: Banyak orang akan",
      "ref_id": "Lukas 13:24",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 18
    },
    {
      "id": 15,
      "diatessaron_verse": "9",
      "ref": "Luke 13:24",
      "arabic_page": 118,
      "text": "berusaha untuk masuk, tetapi tidak akan dapat. —",
      "ref_id": "Lukas 13:24",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 16,
      "diatessaron_verse": "9",
      "ref": "Luke 13:25",
      "arabic_page": 118,
      "text": "Jika tuan rumah telah bangkit dan telah menutup pintu, kamu akan berdiri di luar dan mengetok-ngetok pintu sambil berkata: Tuan, bukakanlah kami pintu! dan Ia akan menjawab dan",
      "ref_id": "Lukas 13:25",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 28
    },
    {
      "id": 17,
      "diatessaron_verse": "10",
      "ref": "Luke 13:25",
      "arabic_page": 118,
      "text": "berkata kepadamu: Aku tidak tahu dari mana kamu datang.",
      "ref_id": "Lukas 13:25",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 18,
      "diatessaron_verse": "10",
      "ref": "Luke 13:26",
      "arabic_page": 118,
      "text": "Maka kamu akan berkata:",
      "ref_id": "Lukas 13:26",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 19,
      "diatessaron_verse": "11",
      "ref": "Luke 13:26",
      "arabic_page": 118,
      "text": "Kami telah makan dan minum di hadapan-Mu dan Engkau telah mengajar di jalan-jalan kota kami.",
      "ref_id": "Lukas 13:26",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 15
    },
    {
      "id": 20,
      "diatessaron_verse": "11",
      "ref": "Luke 13:27",
      "arabic_page": 118,
      "text": "Tetapi Ia akan berkata kepadamu: Aku tidak tahu dari mana kamu datang, enyahlah dari hadapan-Ku, hai kamu sekalian yang melakukan",
      "ref_id": "Lukas 13:27",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 20
    },
    {
      "id": 21,
      "diatessaron_verse": "12",
      "ref": "Luke 13:27",
      "arabic_page": 118,
      "text": "kejahatan!",
      "ref_id": "Lukas 13:27",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 1
    },
