      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 27
    },
    {
      "id": 23,
      "diatessaron_verse": "13",
      "ref": "Luke 13:28",
      "arabic_page": 118,
      "text": "dicampakkan ke luar.",
      "ref_id": "Lukas 13:28",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 24,
      "diatessaron_verse": "13",
      "ref": "Luke 13:29",
      "arabic_page": 118,
      "text": "Dan orang akan datang dari Timur dan Barat dan dari",
