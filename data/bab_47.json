    {
      "id": 1,
      "diatessaron_verse": "1",
      "ref": "John 16:16",
      "arabic_page": null,
      "text": "\"Tinggal sesaat saja dan kamu tidak melihat Aku lagi dan tinggal sesaat saja pula dan kamu akan",
      "ref_id": "Yohanes 16:16",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 17,
      "footnote_id": 1
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "John 16:16",
      "arabic_page": null,
      "text": "melihat Aku, [karena Aku pergi kepada Bapa.\"]",
      "ref_id": "Yohanes 16:16",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 7
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "John 16:17",
      "arabic_page": null,
      "text": "Mendengar itu beberapa dari murid-Nya berkata seorang kepada yang lain: \"Apakah artinya Ia berkata kepada kita: Tinggal sesaat saja dan kamu tidak melihat Aku dan tinggal sesaat saja pula dan kamu akan melihat Aku? Dan: Aku pergi kepada",
      "ref_id": "Yohanes 16:17",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 38
    },
    {
      "id": 4,
      "diatessaron_verse": "3",
      "ref": "John 16:17",
      "arabic_page": null,
      "text": "Bapa?\"",
      "ref_id": "Yohanes 16:17",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 1
    },
    {
      "id": 5,
      "diatessaron_verse": "3",
      "ref": "John 16:18",
      "arabic_page": null,
      "text": "Maka kata mereka: \"Apakah artinya Ia berkata: Tinggal sesaat saja? Kita tidak tahu",
      "ref_id": "Yohanes 16:18",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 13
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "John 16:18",
      "arabic_page": null,
      "text": "apa maksud-Nya.\"",
      "ref_id": "Yohanes 16:18",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 2
    },
    {
      "id": 7,
      "diatessaron_verse": "4",
      "ref": "John 16:19",
      "arabic_page": null,
      "text": "Yesus tahu, bahwa mereka hendak menanyakan sesuatu kepada-Nya, lalu Ia berkata kepada mereka: \"Adakah kamu membicarakan seorang dengan yang lain apa yang Kukatakan tadi, yaitu: Tinggal sesaat saja dan kamu tidak melihat Aku dan tinggal sesaat saja pula dan kamu akan",
      "ref_id": "Yohanes 16:19",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 41
    },
    {
      "id": 8,
      "diatessaron_verse": "5",
      "ref": "John 16:19",
      "arabic_page": null,
      "text": "melihat Aku?",
      "ref_id": "Yohanes 16:19",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 2
    },
    {
      "id": 9,
      "diatessaron_verse": "5",
      "ref": "John 16:20",
      "arabic_page": null,
      "text": "Aku berkata kepadamu: Sesungguhnya kamu akan menangis dan meratap, tetapi dunia akan bergembira; kamu akan berdukacita, tetapi dukacitamu akan berubah menjadi sukacita.",
      "ref_id": "Yohanes 16:20",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 22
    },
    {
      "id": 10,
      "diatessaron_verse": "6",
      "ref": "John 16:21",
      "arabic_page": null,
      "text": "Seorang perempuan berdukacita pada saat ia melahirkan, tetapi sesudah ia melahirkan anaknya, ia tidak ingat lagi akan penderitaannya, karena kegembiraan bahwa seorang manusia telah dilahirkan ke",
      "ref_id": "Yohanes 16:21",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 26
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "John 16:21",
      "arabic_page": null,
      "text": "dunia.",
      "ref_id": "Yohanes 16:21",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 1
    },
    {
      "id": 12,
      "diatessaron_verse": "7",
      "ref": "John 16:22",
      "arabic_page": null,
      "text": "Demikian juga kamu sekarang diliputi dukacita, tetapi Aku akan melihat kamu lagi dan hatimu akan bergembira",
      "ref_id": "Yohanes 16:22",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 16
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "John 16:22",
      "arabic_page": 178,
      "text": "dan tidak ada seorangpun yang dapat merampas kegembiraanmu itu dari padamu.",
      "ref_id": "Yohanes 16:22",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 11
    },
    {
      "id": 14,
      "diatessaron_verse": "8",
      "ref": "John 16:23",
      "arabic_page": 178,
      "text": "Dan pada hari itu kamu tidak akan menanyakan apa-apa kepada-Ku. Aku berkata kepadamu: Sesungguhnya segala sesuatu yang kamu minta kepada Bapa, akan diberikan-Nya kepadamu dalam nama-Ku.",
      "ref_id": "Yohanes 16:23",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 26
    },
    {
      "id": 15,
      "diatessaron_verse": "8",
      "ref": "John 16:24",
      "arabic_page": 178,
      "text": "Sampai sekarang kamu belum meminta sesuatupun",
      "ref_id": "Yohanes 16:24",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 6
    },
    {
      "id": 16,
      "diatessaron_verse": "9",
      "ref": "John 16:24",
      "arabic_page": 178,
      "text": "dalam nama-Ku. Mintalah maka kamu akan menerima, supaya penuhlah sukacitamu.",
      "ref_id": "Yohanes 16:24",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 10
    },
    {
      "id": 17,
      "diatessaron_verse": "10",
      "ref": "John 16:25",
      "arabic_page": 178,
      "text": "Semuanya ini Kukatakan kepadamu dengan kiasan. Akan tiba saatnya Aku tidak lagi berkata-kata kepadamu dengan kiasan, tetapi terus terang memberitakan Bapa kepadamu.",
      "ref_id": "Yohanes 16:25",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 22
    },
    {
      "id": 18,
      "diatessaron_verse": "11",
      "ref": "John 16:26",
      "arabic_page": 178,
      "text": "Pada hari itu kamu akan berdoa dalam nama-Ku. Dan tidak Aku katakan kepadamu, bahwa Aku",
      "ref_id": "Yohanes 16:26",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 15
    },
    {
      "id": 19,
      "diatessaron_verse": "12",
      "ref": "John 16:26",
      "arabic_page": 178,
      "text": "meminta bagimu kepada Bapa,",
      "ref_id": "Yohanes 16:26",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 4
    },
    {
      "id": 20,
      "diatessaron_verse": "12",
      "ref": "John 16:27",
      "arabic_page": 178,
      "text": "sebab Bapa sendiri mengasihi kamu, karena kamu telah mengasihi Aku",
      "ref_id": "Yohanes 16:27",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 10
    },
    {
      "id": 21,
      "diatessaron_verse": "13",
      "ref": "John 16:27",
      "arabic_page": 178,
      "text": "dan percaya, bahwa Aku datang dari Allah.",
      "ref_id": "Yohanes 16:27",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 7
    },
    {
      "id": 22,
      "diatessaron_verse": "13",
      "ref": "John 16:28",
      "arabic_page": 178,
      "text": "Aku datang dari Bapa dan Aku datang ke dalam dunia; Aku meninggalkan dunia pula dan pergi kepada Bapa.\"",
      "ref_id": "Yohanes 16:28",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 18
    },
    {
      "id": 23,
      "diatessaron_verse": "14",
      "ref": "John 16:29",
      "arabic_page": 178,
      "text": "Kata murid-murid-Nya: \"Lihat, sekarang Engkau terus terang berkata-kata dan Engkau tidak",
      "ref_id": "Yohanes 16:29",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 11
    },
    {
      "id": 24,
      "diatessaron_verse": "15",
      "ref": "John 16:29",
      "arabic_page": 178,
      "text": "memakai kiasan.",
      "ref_id": "Yohanes 16:29",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 2
    },
    {
      "id": 25,
      "diatessaron_verse": "15",
      "ref": "John 16:30",
      "arabic_page": 178,
      "text": "Sekarang kami tahu, bahwa Engkau mengetahui segala sesuatu dan tidak perlu orang bertanya kepada-Mu. Karena itu kami percaya, bahwa Engkau datang",
      "ref_id": "Yohanes 16:30",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 21
    },
    {
      "id": 26,
      "diatessaron_verse": "16,17",
      "ref": "John 16:30",
      "arabic_page": 178,
      "text": "dari Allah.\"",
      "ref_id": "Yohanes 16:30",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 2
    },
    {
      "id": 27,
      "diatessaron_verse": "16,17",
      "ref": "John 16:31",
      "arabic_page": 178,
      "text": "Jawab Yesus kepada mereka: \"Percayakah kamu sekarang?",
      "ref_id": "Yohanes 16:31",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 7
    },
    {
      "id": 28,
      "diatessaron_verse": "16,17",
      "ref": "John 16:32",
      "arabic_page": 178,
      "text": "Lihat, saatnya datang, bahkan sudah datang, bahwa kamu diceraiberaikan masing-masing ke tempatnya sendiri dan kamu meninggalkan Aku",
      "ref_id": "Yohanes 16:32",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 17
    },
    {
      "id": 29,
      "diatessaron_verse": "18",
      "ref": "John 16:32",
      "arabic_page": 178,
      "text": "seorang diri. Namun Aku tidak seorang diri, sebab Bapa menyertai Aku.",
      "ref_id": "Yohanes 16:32",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 11
    },
    {
      "id": 30,
      "diatessaron_verse": "18",
      "ref": "John 16:33",
      "arabic_page": 178,
      "text": "Semuanya itu Kukatakan kepadamu, supaya kamu beroleh damai sejahtera dalam Aku. Dalam dunia kamu menderita penganiayaan, tetapi kuatkanlah hatimu, Aku telah mengalahkan dunia.\"",
      "ref_id": "Yohanes 16:33",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 23
    },
    {
      "id": 31,
      "diatessaron_verse": "19",
      "ref": "John 17:1",
      "arabic_page": 178,
      "text": "Demikianlah kata Yesus. Lalu Ia menengadah ke langit dan berkata: \"Bapa,",
      "ref_id": "Yohanes 17:1",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 11
    },
    {
      "id": 32,
      "diatessaron_verse": "20",
      "ref": "John 17:1",
      "arabic_page": 178,
      "text": "telah tiba saatnya; permuliakanlah Anak-Mu, supaya Anak-Mu mempermuliakan Engkau.",
      "ref_id": "Yohanes 17:1",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 9
    },
    {
      "id": 33,
      "diatessaron_verse": "20",
      "ref": "John 17:2",
      "arabic_page": 178,
      "text": "Sama seperti Engkau telah memberikan kepada-Nya kuasa",
      "ref_id": "Yohanes 17:2",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 7
    },
    {
      "id": 34,
      "diatessaron_verse": "21",
      "ref": "John 17:2",
      "arabic_page": 178,
      "text": "atas segala yang hidup, demikian pula Ia akan memberikan hidup yang kekal kepada semua yang telah Engkau berikan kepada-Nya.",
      "ref_id": "Yohanes 17:2",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 19
    },
    {
      "id": 35,
      "diatessaron_verse": "21",
      "ref": "John 17:3",
      "arabic_page": 178,
      "text": "Inilah hidup yang kekal itu, yaitu bahwa mereka mengenal Engkau, satu-satunya Allah yang benar, dan mengenal Yesus Kristus",
      "ref_id": "Yohanes 17:3",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 18
    },
    {
      "id": 36,
      "diatessaron_verse": "22",
      "ref": "John 17:3",
      "arabic_page": 179,
      "text": "yang telah Engkau utus.",
      "ref_id": "Yohanes 17:3",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 4
    },
    {
      "id": 37,
      "diatessaron_verse": "22",
      "ref": "John 17:4",
      "arabic_page": 179,
      "text": "Aku telah mempermuliakan Engkau di bumi",
      "ref_id": "Yohanes 17:4",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 6
    },
    {
      "id": 38,
      "diatessaron_verse": "23",
      "ref": "John 17:4",
      "arabic_page": 179,
      "text": "dengan jalan menyelesaikan pekerjaan yang Engkau berikan kepada-Ku untuk melakukannya.",
      "ref_id": "Yohanes 17:4",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 10
    },
    {
      "id": 39,
      "diatessaron_verse": "23",
      "ref": "John 17:5",
      "arabic_page": 179,
      "text": "Oleh sebab itu, ya Bapa, permuliakanlah Aku pada-Mu sendiri dengan kemuliaan yang Kumiliki di hadirat-Mu 24 sebelum dunia ada.",
      "ref_id": "Yohanes 17:5",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 19
    },
    {
      "id": 40,
      "diatessaron_verse": "23",
      "ref": "John 17:6",
      "arabic_page": 179,
      "text": "Aku telah menyatakan nama-Mu kepada semua orang, yang Engkau berikan kepada-Ku dari dunia. Mereka itu milik-Mu dan Engkau telah memberikan mereka kepada-Ku dan mereka telah menuruti",
      "ref_id": "Yohanes 17:6",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 26
    },
    {
      "id": 41,
      "diatessaron_verse": "25, 26",
      "ref": "John 17:6",
      "arabic_page": 179,
      "text": "firman-Mu.",
      "ref_id": "Yohanes 17:6",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 1
    },
    {
      "id": 42,
      "diatessaron_verse": "25, 26",
      "ref": "John 17:7",
      "arabic_page": 179,
      "text": "Sekarang mereka tahu, bahwa semua yang Engkau berikan kepada-Ku itu berasal dari pada-Mu.",
      "ref_id": "Yohanes 17:7",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 13
    },
    {
      "id": 43,
      "diatessaron_verse": "25, 26",
      "ref": "John 17:8",
      "arabic_page": 179,
      "text": "Sebab segala firman yang Engkau sampaikan kepada-Ku telah Kusampaikan kepada mereka dan mereka telah menerimanya. Mereka tahu benar-benar, bahwa Aku datang dari pada-Mu, dan mereka percaya, bahwa Engkaulah yang telah mengutus Aku.",
      "ref_id": "Yohanes 17:8",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 32
    },
    {
      "id": 44,
      "diatessaron_verse": "27",
      "ref": "John 17:9",
      "arabic_page": 179,
      "text": "Aku berdoa untuk mereka. Bukan untuk dunia Aku berdoa, tetapi untuk mereka, yang",
      "ref_id": "Yohanes 17:9",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 13
    },
    {
      "id": 45,
      "diatessaron_verse": "28",
      "ref": "John 17:9",
      "arabic_page": 179,
      "text": "telah Engkau berikan kepada-Ku, sebab mereka adalah milik-Mu",
      "ref_id": "Yohanes 17:9",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 8
    },
    {
      "id": 46,
      "diatessaron_verse": "28",
      "ref": "John 17:10",
      "arabic_page": 179,
      "text": "dan segala milik-Ku adalah milik-Mu dan",
      "ref_id": "Yohanes 17:10",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 6
    },
    {
      "id": 47,
      "diatessaron_verse": "29",
      "ref": "John 17:10",
      "arabic_page": 179,
      "text": "milik-Mu adalah milik-Ku, dan Aku telah dipermuliakan di dalam mereka.",
      "ref_id": "Yohanes 17:10",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 10
    },
    {
      "id": 48,
      "diatessaron_verse": "29",
      "ref": "John 17:11",
      "arabic_page": 179,
      "text": "Dan Aku tidak ada lagi di dalam dunia, tetapi mereka masih ada di dalam dunia, dan Aku datang kepada-Mu. Ya Bapa yang kudus, peliharalah mereka dalam nama-Mu, yaitu",
      "ref_id": "Yohanes 17:11",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 28
    },
    {
      "id": 49,
      "diatessaron_verse": "30",
      "ref": "John 17:11",
      "arabic_page": 179,
      "text": "nama-Mu yang telah Engkau berikan kepada-Ku, supaya mereka menjadi satu sama seperti Kita.",
      "ref_id": "Yohanes 17:11",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 13
    },
