    {
      "id": 1,
      "diatessaron_verse": "1",
      "ref": "Luke 7:40",
      "arabic_page": null,
      "text": "Lalu Yesus berkata kepadanya: \"Simon, ada yang hendak Kukatakan kepadamu.\"",
      "ref_id": "Lukas 7:40",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 2,
      "diatessaron_verse": "2",
      "ref": "Luke 7:40",
      "arabic_page": null,
      "text": "Sahut Simon: \"Katakanlah, Guru.\"",
      "ref_id": "Lukas 7:40",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 3,
      "diatessaron_verse": "2",
      "ref": "Luke 7:41",
      "arabic_page": 58,
      "text": "\"Ada dua orang yang berhutang kepada seorang pelepas uang. Yang seorang berhutang lima ratus dinar, yang lain lima puluh.",
      "ref_id": "Lukas 7:41",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 19
    },
    {
      "id": 4,
      "diatessaron_verse": "2",
      "ref": "Luke 7:42",
      "arabic_page": 58,
      "text": "Karena mereka tidak sanggup membayar, maka ia menghapuskan",
      "ref_id": "Lukas 7:42",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 5,
      "diatessaron_verse": "4",
      "ref": "Luke 7:42",
      "arabic_page": 58,
      "text": "hutang kedua orang itu. Siapakah di antara mereka yang akan terlebih mengasihi dia?\"",
      "ref_id": "Lukas 7:42",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 6,
      "diatessaron_verse": "4",
      "ref": "Luke 7:43",
      "arabic_page": 58,
      "text": "Jawab Simon: \"Aku kira dia yang paling banyak dihapuskan hutangnya.\" Kata Yesus kepadanya: \"Betul pendapatmu itu.\"",
      "ref_id": "Lukas 7:43",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 16
    },
    {
      "id": 7,
      "diatessaron_verse": "5",
      "ref": "Luke 7:44",
      "arabic_page": 58,
      "text": "Dan sambil berpaling kepada perempuan itu, Ia berkata kepada Simon: \"Engkau lihat perempuan ini? Aku masuk ke rumahmu, namun engkau tidak memberikan Aku air untuk membasuh kaki-Ku, tetapi",
      "ref_id": "Lukas 7:44",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 28
    },
    {
      "id": 8,
      "diatessaron_verse": "6",
      "ref": "Luke 7:44",
      "arabic_page": 58,
      "text": "dia membasahi kaki-Ku dengan air mata dan menyekanya dengan rambutnya.",
      "ref_id": "Lukas 7:44",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 9,
      "diatessaron_verse": "6",
      "ref": "Luke 7:45",
      "arabic_page": 58,
      "text": "Engkau tidak mencium Aku, tetapi sejak Aku masuk ia tiada henti-hentinya mencium",
      "ref_id": "Lukas 7:45",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 10,
      "diatessaron_verse": "7",
      "ref": "Luke 7:45",
      "arabic_page": 58,
      "text": "kaki-Ku.",
      "ref_id": "Lukas 7:45",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 1
    },
    {
      "id": 11,
      "diatessaron_verse": "7",
      "ref": "Luke 7:46",
      "arabic_page": 58,
      "text": "Engkau tidak meminyaki kepala-Ku dengan minyak, tetapi dia meminyaki",
      "ref_id": "Lukas 7:46",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 12,
      "diatessaron_verse": "8",
      "ref": "Luke 7:46",
      "arabic_page": 58,
      "text": "kaki-Ku dengan minyak wangi.",
      "ref_id": "Lukas 7:46",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 13,
      "diatessaron_verse": "8",
      "ref": "Luke 7:47",
      "arabic_page": 58,
      "text": "Sebab itu Aku berkata kepadamu: Dosanya yang banyak itu telah diampuni, sebab ia telah banyak berbuat kasih. Tetapi orang yang sedikit diampuni, sedikit juga ia berbuat kasih.\"",
      "ref_id": "Lukas 7:47",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 27
    },
    {
      "id": 14,
      "diatessaron_verse": "9, 10",
      "ref": "Luke 7:48",
      "arabic_page": 58,
      "text": "Lalu Ia berkata kepada perempuan itu: \"Dosamu telah diampuni.\"",
      "ref_id": "Lukas 7:48",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 9
    },
    {
      "id": 15,
      "diatessaron_verse": "9, 10",
      "ref": "Luke 7:49",
      "arabic_page": 58,
      "text": "Dan mereka, yang duduk makan bersama Dia,",
      "ref_id": "Lukas 7:49",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 7
    },
    {
      "id": 16,
      "diatessaron_verse": "11",
      "ref": "Luke 7:49",
      "arabic_page": 58,
      "text": "berpikir dalam hati mereka: \"Siapakah Ia ini, sehingga Ia dapat mengampuni dosa?\"",
      "ref_id": "Lukas 7:49",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 17,
      "diatessaron_verse": "11",
      "ref": "Luke 7:50",
      "arabic_page": 58,
      "text": "Tetapi Yesus berkata kepada perempuan itu: \"Imanmu telah menyelamatkan engkau, pergilah dengan selamat!\"",
      "ref_id": "Lukas 7:50",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 18,
      "diatessaron_verse": "12",
      "ref": "John 2:23[b",
      "arabic_page": 58,
      "text": "banyak orang percaya dalam nama-Nya, karena mereka telah melihat tanda-tanda yang diadakan-Nya.",
      "ref_id": "Yohanes 2:23[b",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 12
    },
    {
      "id": 19,
      "diatessaron_verse": "13, 14",
      "ref": "John 2:24",
      "arabic_page": 58,
      "text": "Tetapi Yesus sendiri tidak mempercayakan diri-Nya kepada mereka, karena Ia mengenal mereka semua,",
      "ref_id": "Yohanes 2:24",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 13
    },
    {
      "id": 20,
      "diatessaron_verse": "13, 14",
      "ref": "John 2:25",
      "arabic_page": 58,
      "text": "dan karena tidak perlu seorangpun memberi kesaksian kepada-Nya tentang manusia, sebab Ia tahu apa yang ada di dalam hati manusia.",
      "ref_id": "Yohanes 2:25",
      "book_code": "yoh",
      "book_en": "John",
      "book_id": "Yohanes",
      "word_count": 20
    },
    {
      "id": 21,
      "diatessaron_verse": "15",
      "ref": "Luke 10:1",
      "arabic_page": 58,
      "text": "Kemudian dari pada itu Tuhan menunjuk tujuh puluh murid yang lain, lalu mengutus mereka berdua-dua mendahului-Nya ke setiap kota dan tempat",
      "ref_id": "Lukas 10:1",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 21
    },
    {
      "id": 22,
      "diatessaron_verse": "16",
      "ref": "Luke 10:1",
      "arabic_page": 58,
      "text": "yang hendak dikunjungi-Nya.",
      "ref_id": "Lukas 10:1",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 3
    },
    {
      "id": 23,
      "diatessaron_verse": "16",
      "ref": "Luke 10:2",
      "arabic_page": 58,
      "text": "Kata-Nya kepada mereka: \"Tuaian memang banyak, tetapi pekerja sedikit. Karena itu",
      "ref_id": "Lukas 10:2",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 24,
      "diatessaron_verse": "17",
      "ref": "Luke 10:2",
      "arabic_page": 58,
      "text": "mintalah kepada Tuan yang empunya tuaian, supaya Ia mengirimkan pekerja-pekerja untuk tuaian itu.",
      "ref_id": "Lukas 10:2",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 25,
      "diatessaron_verse": "17",
      "ref": "Luke 10:3",
      "arabic_page": 58,
      "text": "Pergilah,",
      "ref_id": "Lukas 10:3",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 1
    },
    {
      "id": 26,
      "diatessaron_verse": "18",
      "ref": "Luke 10:3",
      "arabic_page": 59,
      "text": "sesungguhnya Aku mengutus kamu seperti anak domba ke tengah-tengah serigala.",
      "ref_id": "Lukas 10:3",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 27,
      "diatessaron_verse": "18",
      "ref": "Luke 10:4",
      "arabic_page": 59,
      "text": "Janganlah membawa",
      "ref_id": "Lukas 10:4",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 28,
      "diatessaron_verse": "19",
      "ref": "Luke 10:4",
      "arabic_page": 59,
      "text": "pundi-pundi atau bekal atau kasut, dan janganlah memberi salam kepada siapapun selama dalam perjalanan.",
      "ref_id": "Lukas 10:4",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 14
    },
    {
      "id": 29,
      "diatessaron_verse": "19",
      "ref": "Luke 10:5",
      "arabic_page": 59,
      "text": "Kalau",
      "ref_id": "Lukas 10:5",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 1
    },
    {
      "id": 30,
      "diatessaron_verse": "20",
      "ref": "Luke 10:5",
      "arabic_page": 59,
      "text": "kamu memasuki suatu rumah, katakanlah lebih dahulu: Damai sejahtera bagi rumah ini.",
      "ref_id": "Lukas 10:5",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 12
    },
    {
      "id": 31,
      "diatessaron_verse": "20",
      "ref": "Luke 10:6",
      "arabic_page": 59,
      "text": "Dan jikalau di situ ada orang yang layak menerima damai sejahtera,",
      "ref_id": "Lukas 10:6",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 11
    },
    {
      "id": 32,
      "diatessaron_verse": "21",
      "ref": "Luke 10:6",
      "arabic_page": 59,
      "text": "maka salammu itu akan tinggal atasnya. Tetapi jika tidak, salammu itu kembali kepadamu.",
      "ref_id": "Lukas 10:6",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 33,
      "diatessaron_verse": "21",
      "ref": "Luke 10:7",
      "arabic_page": 59,
      "text": "Tinggallah dalam rumah itu, makan dan minumlah apa yang diberikan orang kepadamu, sebab seorang pekerja",
      "ref_id": "Lukas 10:7",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 15
    },
    {
      "id": 34,
      "diatessaron_verse": "22",
      "ref": "Luke 10:7",
      "arabic_page": 59,
      "text": "patut mendapat upahnya. Janganlah berpindah-pindah rumah.",
      "ref_id": "Lukas 10:7",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
    {
      "id": 35,
      "diatessaron_verse": "22",
      "ref": "Luke 10:8",
      "arabic_page": 59,
      "text": "Dan jikalau kamu masuk ke dalam sebuah kota",
      "ref_id": "Lukas 10:8",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 8
    },
    {
      "id": 36,
      "diatessaron_verse": "23",
      "ref": "Luke 10:8",
      "arabic_page": 59,
      "text": "dan kamu diterima di situ, makanlah apa yang dihidangkan kepadamu,",
      "ref_id": "Lukas 10:8",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 10
    },
    {
      "id": 37,
      "diatessaron_verse": "23",
      "ref": "Luke 10:9",
      "arabic_page": 59,
      "text": "dan sembuhkanlah orang-orang sakit",
      "ref_id": "Lukas 10:9",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 4
    },
    {
      "id": 38,
      "diatessaron_verse": "24",
      "ref": "Luke 10:9",
      "arabic_page": 59,
      "text": "yang ada di situ dan katakanlah kepada mereka: Kerajaan Allah sudah dekat padamu.",
      "ref_id": "Lukas 10:9",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 39,
      "diatessaron_verse": "24",
      "ref": "Luke 10:10",
      "arabic_page": 59,
      "text": "Tetapi jikalau kamu masuk ke dalam sebuah kota dan kamu tidak diterima di situ, pergilah ke jalan-jalan raya kota itu dan serukanlah:",
      "ref_id": "Lukas 10:10",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 22
    },
    {
      "id": 40,
      "diatessaron_verse": "25",
      "ref": "Luke 10:11",
      "arabic_page": 59,
      "text": "Juga debu kotamu yang melekat pada kaki kami, kami kebaskan di depanmu; tetapi",
      "ref_id": "Lukas 10:11",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 13
    },
    {
      "id": 41,
      "diatessaron_verse": "26",
      "ref": "Luke 10:11",
      "arabic_page": 59,
      "text": "ketahuilah ini: Kerajaan Allah sudah dekat.",
      "ref_id": "Lukas 10:11",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 6
    },
