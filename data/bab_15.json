      "diatessaron_verse": "27",
      "ref": "Luke 10:12",
      "arabic_page": 59,
      "text": "kota itu.\"",
      "ref_id": "Lukas 10:12",
      "book_code": "luk",
      "book_en": "Luke",
      "book_id": "Lukas",
      "word_count": 2
    },
    {
      "id": 44,
      "diatessaron_verse": "27",
      "ref": "Matthew 11:20",
      "arabic_page": 59,
      "text": "Lalu Yesus mulai mengecam kota-kota yang tidak bertobat, sekalipun di situ Ia",
      "ref_id": "Matius 11:20",
      "book_code": "mat",
